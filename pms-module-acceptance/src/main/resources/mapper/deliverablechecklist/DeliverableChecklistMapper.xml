<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.acceptance.dal.mysql.deliverablechecklist.DeliverableChecklistMapper">

    <!-- 记录编码全集（含软删除行）：唯一键 (project_id, code) 不含 deleted，推号必须看见被占用编码 -->
    <select id="selectRecordCodesIncludeDeleted" resultType="java.lang.String">
        SELECT code
        FROM acc_deliverable_checklist
        WHERE project_id = #{projectId}
          AND code IS NOT NULL
    </select>
    <select id="selectOwnerForUpdate" resultType="cn.iocoder.yudao.module.pms.acceptance.dal.dataobject.deliverablechecklist.DeliverableChecklistDO">
        SELECT * FROM acc_deliverable_checklist WHERE tenant_id=#{query.tenantId} AND id=#{query.checklistId} AND deleted=b'0' FOR UPDATE
    </select>
</mapper>
