<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.acceptance.dal.mysql.acceptance.AcceptanceMapper">

    <!-- 记录编码全集（含软删除行）：唯一键 (project_id, code) 不含 deleted，推号必须看见被占用编码 -->
    <select id="selectRecordCodesIncludeDeleted" resultType="java.lang.String">
        SELECT code
        FROM acc_acceptance_record
        WHERE project_id = #{projectId}
          AND code IS NOT NULL
    </select>
</mapper>
