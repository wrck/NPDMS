{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:device-ops:mapping-rule:1.0.0",
  "title": "Device log semantic mapping rule catalog",
  "type": "object",
  "required": ["schemaVersion", "rules"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["COMMAND_ALIAS", "COMMAND_REGEX", "CONTENT_REGEX", "TABLE_HEADERS"] },
        "value": { "type": "string" },
        "values": { "type": "array", "items": { "type": "string" } }
      }
    },
    "extractor": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["LINE_REGEX", "KEY_VALUE", "TABLE", "CONFIG_STANZA", "STATUS_TEXT"] },
        "pattern": { "type": "string" },
        "group": { "type": "integer", "minimum": 0 },
        "key": { "type": "string" },
        "headers": { "type": "array", "items": { "type": "string" } },
        "transforms": { "type": "array", "items": { "type": "string" } }
      }
    },
    "target": {
      "type": "object",
      "required": ["semanticKey", "cardinality", "dataType", "conflictPolicy"],
      "properties": {
        "semanticKey": { "type": "string" },
        "cardinality": { "enum": ["ONE", "MANY"] },
        "dataType": { "enum": ["string", "integer", "decimal", "boolean", "datetime", "object"] },
        "unit": { "type": ["string", "null"] },
        "conflictPolicy": { "enum": ["HIGHEST_CONFIDENCE", "APPEND_DISTINCT"] }
      }
    },
    "rule": {
      "type": "object",
      "required": ["ruleId", "blockRole", "roleSelectors", "extractors", "target"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "blockRole": { "type": "string", "minLength": 1 },
        "roleSelectors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/selector" } },
        "extractors": { "type": "array", "items": { "$ref": "#/$defs/extractor" } },
        "target": { "$ref": "#/$defs/target" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "aliases": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
