{
  "schemaVersion": "1.0.0",
  "catalogVersion": "1.0.0",
  "rules": [
    {
      "ruleId": "event-severity",
      "blockRole": "SYSTEM_EVENT",
      "roleSelectors": [{"type": "CONTENT_REGEX", "value": "severity="}],
      "extractors": [{"type": "LINE_REGEX", "pattern": ".*severity=([A-Z]+).*", "group": 1, "transforms": ["trim", "lowercase"]}],
      "target": {"semanticKey": "event.severity", "cardinality": "ONE", "dataType": "string", "conflictPolicy": "HIGHEST_CONFIDENCE"}
    }
  ]
}
