    { "ruleId": "role-device-clock", "blockRole": "DEVICE_CLOCK", "roleSelectors": [{ "type": "COMMAND_ALIAS", "value": "show clock" }, { "type": "CONTENT_REGEX", "value": "(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun).*GMT" }], "extractors": [], "target": { "semanticKey": "collection.deviceTime", "cardinality": "ONE", "dataType": "datetime", "conflictPolicy": "HIGHEST_CONFIDENCE" } },
