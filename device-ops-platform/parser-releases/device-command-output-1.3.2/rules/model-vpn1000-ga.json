      "target": {
        "semanticKey": "device.hardware.cpuModel",
        "cardinality": "ONE",
        "dataType": "string",
        "conflictPolicy": "HIGHEST_CONFIDENCE"
      }
    },
    {
      "ruleId": "version-memory",
