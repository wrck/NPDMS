          "pattern": "(?i)^\\s*\\[SLOT\\s+(?<slot>[0-9]+)\\]\\s+(?<model>\\S+)\\s+\\(PCB\\)(?<pcb>[^,]+),\\s*\\(CPLD\\)(?<cpld>[^,]+),\\s*\\(FPGA\\)(?<fpga>\\S+)?\\s*$",
          "fields": {
            "slot": {
              "group": "slot",
              "transforms": [
                "integer"
              ]
            },
            "model": {
              "group": "model",
              "transforms": [
                "trim"
              ]
            },
            "pcbVersion": {
              "group": "pcb",
