      "extractors": [
        {
          "type": "LINE_REGEX",
          "pattern": "(?i)^\\s*Compiled\\s+(.+)$",
          "group": 1,
          "transforms": [
            "trim"
          ]
        }
      ],
      "target": {
        "semanticKey": "device.software.compiledAt",
        "cardinality": "ONE",
        "dataType": "string",
        "conflictPolicy": "HIGHEST_CONFIDENCE"
      }
    },
