{
  "schemaVersion": "1.1.0",
  "catalogVersion": "1.3.2",
  "structureRules": [
    {
      "structureRuleId": "interface-records",
      "selectors": [
        {
          "type": "COMMAND_REGEX",
          "value": "^show\\s+interface$"
        }
      ],
      "mode": "FORCE",
      "type": "recordList",
      "options": {
        "recordStartPattern": "^Interface\\s+(?<id>\\S+)$"
      }
    }
  ],
  "rules": [
    {
      "ruleId": "version-platform-version",
      "blockRole": "DEVICE_VERSION",
      "roleSelectors": [
        {
          "type": "COMMAND_REGEX",
          "value": "^show\\s+(?:version|ver)(?:\\s+.*)?$"
        }
      ],
      "extractors": [
        {
          "type": "LINE_REGEX",
          "pattern": "(?i)^\\s*Conplat Version is\\s+(.+)$",
          "group": 1,
          "transforms": [
            "trim"
          ]
        }
      ],
      "target": {
        "semanticKey": "device.software.platformVersion",
        "cardinality": "ONE",
        "dataType": "string",
        "conflictPolicy": "HIGHEST_CONFIDENCE"
      }
    },
    {
      "ruleId": "version-compiled-at",
      "blockRole": "DEVICE_VERSION",
      "roleSelectors": [
        {
          "type": "COMMAND_REGEX",
