            "fpgaVersion": {
              "group": "fpga",
              "transforms": [
                "trim"
              ],
              "required": false
            }
          }
        }
      ],
      "target": {
        "semanticKey": "device.hardware.modules",
        "cardinality": "MANY",
        "dataType": "object",
        "conflictPolicy": "APPEND_DISTINCT"
      }
    },
