        {
          "type": "LINE_REGEX",
          "pattern": "(?i)^\\s*SDRAM\\s*:\\s*(.+)$",
          "group": 1,
          "transforms": [
            "capacity-to-bytes"
          ]
        }
      ],
      "target": {
        "semanticKey": "device.hardware.memoryBytes",
        "cardinality": "ONE",
        "dataType": "integer",
        "conflictPolicy": "HIGHEST_CONFIDENCE",
        "unit": "byte"
      }
    },
