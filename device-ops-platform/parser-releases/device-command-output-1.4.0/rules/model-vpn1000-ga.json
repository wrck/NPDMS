    {
      "structureRuleId": "interface-records",
      "selectors": [{"type": "COMMAND_REGEX", "value": "^show\\s+interface$"}],
      "mode": "FORCE",
      "type": "recordList",
      "options": {"recordStartPattern": "^Interface\\s+(?<id>\\S+)$"}
    }
  ],
