<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.project.api.scope.ProjectShipmentContextSql">
  <!-- Existing project business department; the shipment side applies the established migration code mapping. Not authorization. -->
  <sql id="projects">
    SELECT p.tenant_id,p.id AS project_id,p.sales_type,p.department_code COLLATE utf8mb4_unicode_ci AS profit_center
    FROM proj_project p WHERE p.tenant_id=#{query.tenantId} AND p.deleted=0
    <if test="shipmentProjectIds != null">
      <choose><when test="!shipmentProjectIds.isEmpty()">AND p.id IN
        <foreach collection="shipmentProjectIds" item="projectId" open="(" close=")" separator=",">#{projectId}</foreach>
      </when><otherwise>AND 1=0</otherwise></choose>
    </if>
  </sql>
</mapper>
