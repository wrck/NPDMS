<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.project.dal.mysql.satisfaction.SatisfactionQuestionnaireMapper">
    <select id="selectByIdForUpdate" resultType="cn.iocoder.yudao.module.pms.project.dal.dataobject.satisfaction.SatisfactionQuestionnaireDO">
        SELECT * FROM acc_satisfaction_questionnaire
         WHERE tenant_id=#{tenantId} AND id=#{id} AND deleted=0
         FOR UPDATE
    </select>
</mapper>
