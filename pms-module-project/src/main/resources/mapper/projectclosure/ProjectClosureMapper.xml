<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.project.dal.mysql.projectclosure.ProjectClosureMapper">

    <select id="selectListForClosureGuard"
            resultType="cn.iocoder.yudao.module.pms.project.dal.dataobject.projectclosure.ProjectClosureDO">
        SELECT *
        FROM pms_acc_project_closure
        WHERE tenant_id = #{query.tenantId}
          AND deleted = 0
          AND project_id IN
        <foreach collection="query.projectIds" item="projectId" open="(" separator="," close=")">
            #{projectId}
        </foreach>
        ORDER BY project_id ASC, id DESC
    </select>

</mapper>
