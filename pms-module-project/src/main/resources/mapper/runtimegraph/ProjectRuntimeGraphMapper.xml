<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.project.dal.mysql.runtimegraph.ProjectRuntimeGraphMapper">
    <sql id="projectScope">tenant_id = #{query.tenantId} AND project_id = #{query.projectId} AND deleted = FALSE</sql>
    <select id="selectStages" resultType="cn.iocoder.yudao.module.pms.project.dal.dataobject.projectmanual.ProjectStageInstanceDO">
        SELECT * FROM proj_project_stage WHERE <include refid="projectScope"/> ORDER BY id
    </select>
    <select id="selectTasks" resultType="cn.iocoder.yudao.module.pms.project.dal.dataobject.projectmanual.ProjectTaskInstanceDO">
        SELECT * FROM proj_project_task WHERE <include refid="projectScope"/> ORDER BY id
    </select>
    <select id="selectGates" resultType="cn.iocoder.yudao.module.pms.project.dal.dataobject.projectmanual.ProjectGateInstanceDO">
        SELECT * FROM proj_project_gate WHERE <include refid="projectScope"/> ORDER BY id
    </select>
    <select id="selectStagesForUpdate" resultType="cn.iocoder.yudao.module.pms.project.dal.dataobject.projectmanual.ProjectStageInstanceDO">
        SELECT * FROM proj_project_stage WHERE <include refid="projectScope"/> ORDER BY id FOR UPDATE
    </select>
    <select id="selectTransitions" resultType="cn.iocoder.yudao.module.pms.project.dal.dataobject.runtimegraph.ProjectStageTransitionDO">
        SELECT * FROM proj_project_stage_transition WHERE <include refid="projectScope"/> ORDER BY id
    </select>
    <select id="selectContracts" resultType="cn.iocoder.yudao.module.pms.project.dal.dataobject.runtimegraph.ProjectStageExecutionContractDO">
        SELECT * FROM proj_project_stage_execution_contract WHERE <include refid="projectScope"/>
        AND effective_from &lt;= CURRENT_TIMESTAMP AND effective_to IS NULL ORDER BY stage_id, id
    </select>
    <select id="selectTasksForUpdate" resultType="cn.iocoder.yudao.module.pms.project.dal.dataobject.projectmanual.ProjectTaskInstanceDO">
        SELECT * FROM proj_project_task WHERE <include refid="projectScope"/> ORDER BY id FOR UPDATE
    </select>
    <select id="selectGatesForUpdate" resultType="cn.iocoder.yudao.module.pms.project.dal.dataobject.projectmanual.ProjectGateInstanceDO">
        SELECT * FROM proj_project_gate WHERE <include refid="projectScope"/> ORDER BY id FOR UPDATE
    </select>
</mapper>
