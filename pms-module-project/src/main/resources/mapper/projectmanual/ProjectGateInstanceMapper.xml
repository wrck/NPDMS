<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.project.dal.mysql.projectmanual.ProjectGateInstanceMapper">

    <select id="selectByCodeForUpdate"
            resultType="cn.iocoder.yudao.module.pms.project.dal.dataobject.projectmanual.ProjectGateInstanceDO">
        SELECT *
        FROM proj_project_gate
        WHERE tenant_id = #{query.tenantId}
          AND project_id = #{query.projectId}
          AND gate_code = #{query.gateCode}
          AND deleted = b'0'
        FOR UPDATE
    </select>

</mapper>
