<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.project.dal.mysql.projectmanual.ProjectGateReferenceInstanceMapper">
    <sql id="orderedReferences">
        SELECT * FROM proj_project_gate_reference
        WHERE tenant_id = #{query.tenantId} AND deleted = b'0'
          AND gate_id IN
          <foreach collection="query.gateIds" item="gateId" open="(" separator="," close=")">#{gateId}</foreach>
        ORDER BY gate_id, ref_type, ref_code, id
    </sql>
    <select id="selectOrdered" resultType="cn.iocoder.yudao.module.pms.project.dal.dataobject.projectmanual.ProjectGateReferenceInstanceDO">
        <include refid="orderedReferences"/>
    </select>
    <select id="selectOrderedForUpdate" resultType="cn.iocoder.yudao.module.pms.project.dal.dataobject.projectmanual.ProjectGateReferenceInstanceDO">
        <include refid="orderedReferences"/>
        FOR UPDATE
    </select>
</mapper>
