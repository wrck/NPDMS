        {"predicate": "WAIT_ELAPSED", "parameters": {"anchor": "NODE_ACTIVATED", "duration": "PT30S"}}
      ]}
    },
    {
      "key": "project.closed", "name": "工前准备结束后收口", "kind": "CONDITION", "shared": false,
      "expression": {"predicate": "STATE", "parameters": {"refCode": "PREP_WORK_COMPLETED"}}
    }
