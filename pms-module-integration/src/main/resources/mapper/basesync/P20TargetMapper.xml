<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.integration.basesync.task.P20RealProductSyncTask$TargetMapper"><select id="selectProjects" resultType="cn.iocoder.yudao.module.pms.integration.basesync.task.P20RealProductSyncTask$Row">SELECT id,tenant_id,project_id,contract_no,project_code,execution_no,product_category_name,product_name,product_sub_code,product_sub_model,product_sub_name,quantity,memo,data_source,creator,create_time,updater,update_time,deleted FROM proj_project_real_product WHERE tenant_id=#{query.tenantId}
<choose><when test="query.ids != null and !query.ids.isEmpty()">AND project_id IN <foreach collection="query.ids" item="id" open="(" separator="," close=")">#{id}</foreach></when><otherwise>AND 1=0</otherwise></choose><if test="!query.preview"> FOR UPDATE</if></select>
<insert id="insertRealProduct">INSERT INTO proj_project_real_product (id,tenant_id,project_id,contract_no,project_code,execution_no,product_category_name,product_name,product_sub_code,product_sub_model,product_sub_name,quantity,memo,data_source,creator,create_time,updater,update_time,deleted) VALUES <foreach collection="rows" item="row" separator=",">(#{row.target.id},#{row.target.tenantId},#{row.target.projectId},#{row.target.contractNo},#{row.target.projectCode},#{row.target.executionNo},#{row.target.productCategoryName},#{row.target.productName},#{row.target.productSubCode},#{row.target.productSubModel},#{row.target.productSubName},#{row.target.quantity},#{row.target.memo},#{row.target.dataSource},#{row.target.creator},#{row.target.createTime},#{row.target.updater},#{row.target.updateTime},#{row.target.deleted})</foreach></insert></mapper>
