<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.integration.basesync.task.P08DictionarySyncTask$TargetMapper">
<select id="selectTypes" resultType="cn.iocoder.yudao.module.pms.integration.basesync.task.P08DictionarySyncTask$DictionaryTarget">SELECT `id`,`name`,`type`,`status`,`remark`,`creator`,`create_time`,`updater`,`update_time`,`deleted`,`deleted_time` FROM system_dict_type WHERE (deleted=FALSE AND (1=0 <if test="query.codes != null and !query.codes.isEmpty()">OR `type` IN <foreach collection="query.codes" item="code" open="(" close=")" separator=",">#{code}</foreach></if><if test="query.names != null and !query.names.isEmpty()">OR name IN <foreach collection="query.names" item="name" open="(" close=")" separator=",">#{name}</foreach></if>)) <if test="query.ids != null and !query.ids.isEmpty()">OR id IN <foreach collection="query.ids" item="id" open="(" close=")" separator=",">#{id}</foreach></if> ORDER BY id <if test="!query.preview">FOR UPDATE</if></select>
<select id="selectItems" resultType="cn.iocoder.yudao.module.pms.integration.basesync.task.P08DictionarySyncTask$DictionaryTarget">SELECT `id`,`sort`,`label`,`value`,`dict_type`,`status`,`color_type`,`css_class`,`remark`,`creator`,`create_time`,`updater`,`update_time`,`deleted` FROM system_dict_data WHERE (deleted=FALSE AND (1=0 <if test="query.codes != null and !query.codes.isEmpty()">OR `dict_type` IN <foreach collection="query.codes" item="code" open="(" close=")" separator=",">#{code}</foreach></if>)) <if test="query.ids != null and !query.ids.isEmpty()">OR id IN <foreach collection="query.ids" item="id" open="(" close=")" separator=",">#{id}</foreach></if> ORDER BY id <if test="!query.preview">FOR UPDATE</if></select>
<insert id="insertDictionaryType">INSERT INTO system_dict_type (`id`,`name`,`type`,`status`,`remark`,`creator`,`create_time`,`updater`,`update_time`,`deleted`,`deleted_time`) VALUES <foreach collection="rows" item="row" separator=",">(#{row.target.id},#{row.target.name},#{row.target.type},#{row.target.status},#{row.target.remark},#{row.target.creator},#{row.target.createTime},#{row.target.updater},#{row.target.updateTime},#{row.target.deleted},#{row.target.deletedTime})</foreach></insert>
<insert id="insertDictionaryItem">INSERT INTO system_dict_data (`id`,`sort`,`label`,`value`,`dict_type`,`status`,`color_type`,`css_class`,`remark`,`creator`,`create_time`,`updater`,`update_time`,`deleted`) VALUES <foreach collection="rows" item="row" separator=",">(#{row.target.id},#{row.target.sort},#{row.target.label},#{row.target.value},#{row.target.dictType},#{row.target.status},#{row.target.colorType},#{row.target.cssClass},#{row.target.remark},#{row.target.creator},#{row.target.createTime},#{row.target.updater},#{row.target.updateTime},#{row.target.deleted})</foreach></insert>
</mapper>
