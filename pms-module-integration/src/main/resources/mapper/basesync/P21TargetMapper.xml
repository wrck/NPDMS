<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.integration.basesync.task.P21ProjectCacheSyncTask$TargetMapper">
  <select id="selectLeaseIds" resultType="java.lang.Long">SELECT id FROM proj_project_lease_product WHERE tenant_id=#{query.tenantId} <if test="!query.preview">FOR UPDATE</if></select>
  <delete id="deleteLease">DELETE FROM proj_project_lease_product WHERE tenant_id=#{query.tenantId}</delete>
  <insert id="insertLease">INSERT INTO proj_project_lease_product (`id`, `tenant_id`, `project_code`, `execution_no`, `product_category`, `product_type`, `product_code`, `product_model`, `product_name`, `quantity`, `memo`, `lease_duration`, `data_source`, `creator`, `create_time`, `updater`, `update_time`, `deleted`) VALUES
    <foreach collection="rows" item="row" separator=",">(#{row.id}, #{row.tenantId}, #{row.projectCode}, #{row.executionNo}, #{row.productCategory}, #{row.productType}, #{row.productCode}, #{row.productModel}, #{row.productName}, #{row.quantity}, #{row.memo}, #{row.leaseDuration}, #{row.dataSource}, #{row.creator}, #{row.createTime}, #{row.updater}, #{row.updateTime}, #{row.deleted})</foreach>
  </insert>
  <select id="selectConfigurationIds" resultType="java.lang.Long">SELECT id FROM proj_project_product_configuration WHERE tenant_id=#{query.tenantId} <if test="!query.preview">FOR UPDATE</if></select>
  <delete id="deleteConfiguration">DELETE FROM proj_project_product_configuration WHERE tenant_id=#{query.tenantId}</delete>
  <insert id="insertConfiguration">INSERT INTO proj_project_product_configuration (`id`, `tenant_id`, `project_code`, `execution_no`, `item_group`, `product_code`, `parent_code`, `quantity`, `bom_path`, `product_model`, `product_description`, `level`, `data_source`, `creator`, `create_time`, `updater`, `update_time`, `deleted`) VALUES
    <foreach collection="rows" item="row" separator=",">(#{row.id}, #{row.tenantId}, #{row.projectCode}, #{row.executionNo}, #{row.itemGroup}, #{row.productCode}, #{row.parentCode}, #{row.quantity}, #{row.bomPath}, #{row.productModel}, #{row.productDescription}, #{row.level}, #{row.dataSource}, #{row.creator}, #{row.createTime}, #{row.updater}, #{row.updateTime}, #{row.deleted})</foreach>
  </insert>
  <select id="nullableColumns" resultType="java.lang.Integer">SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND (table_name='proj_project_lease_product' OR table_name='proj_project_product_configuration') AND column_name='project_id' AND is_nullable='YES'</select>
</mapper>
