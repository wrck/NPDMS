<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.integration.basesync.BaseSyncReferences$ReferenceMapper">
  <select id="selectAuditUserCatalogue" resultType="cn.iocoder.yudao.module.pms.integration.api.basesync.SyncReferences$AuditUser">
    SELECT id,username FROM system_users WHERE tenant_id=#{query.tenantId} AND deleted=FALSE ORDER BY id
  </select>
  <select id="selectAuditUsers" resultType="cn.iocoder.yudao.module.pms.integration.api.basesync.SyncReferences$AuditUser">
    SELECT id,username FROM system_users WHERE tenant_id=#{query.tenantId} AND deleted=FALSE
    <choose><when test="query.usernames != null and !query.usernames.isEmpty()">
      AND username IN <foreach collection="query.usernames" item="name" open="(" separator="," close=")">#{name}</foreach>
    </when><otherwise>AND 1=0</otherwise></choose>
    ORDER BY id
  </select>
</mapper>
