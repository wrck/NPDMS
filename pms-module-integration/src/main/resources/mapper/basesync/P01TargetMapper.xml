<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$TargetMapper">
<select id="selectCompanies" resultType="cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$Row">SELECT id,tenant_id,code,name,status,version,creator,create_time,updater,update_time,deleted, 'COMPANY' AS kind FROM system_company WHERE tenant_id=#{query.tenantId} AND deleted=FALSE ORDER BY id<if test="!query.preview"> FOR UPDATE</if></select>
<insert id="insertCompanies">INSERT INTO system_company (id,tenant_id,code,name,status,version,creator,create_time,updater,update_time,deleted) VALUES <foreach collection="rows" item="row" separator=",">(#{row.target.id},#{row.target.tenantId},#{row.target.code},#{row.target.name},#{row.target.status},#{row.target.version},#{row.target.creator},#{row.target.createTime},#{row.target.updater},#{row.target.updateTime},#{row.target.deleted})</foreach></insert>
<select id="selectDepartments" resultType="cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$Row">SELECT id,tenant_id,code,name,status,version,creator,create_time,updater,update_time,deleted,parent_id,sort,leader_user_id,phone,email, 'DEPARTMENT' AS kind FROM system_dept WHERE tenant_id=#{query.tenantId} AND deleted=FALSE ORDER BY id<if test="!query.preview"> FOR UPDATE</if></select>
<insert id="insertDepartments">INSERT INTO system_dept (id,tenant_id,code,name,status,version,creator,create_time,updater,update_time,deleted,parent_id,sort,leader_user_id,phone,email) VALUES <foreach collection="rows" item="row" separator=",">(#{row.target.id},#{row.target.tenantId},#{row.target.code},#{row.target.name},#{row.target.status},#{row.target.version},#{row.target.creator},#{row.target.createTime},#{row.target.updater},#{row.target.updateTime},#{row.target.deleted},#{row.target.parentId},#{row.target.sort},#{row.target.leaderUserId},#{row.target.phone},#{row.target.email})</foreach></insert>
</mapper>
