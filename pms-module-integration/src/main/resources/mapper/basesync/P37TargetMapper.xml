<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.integration.basesync.task.P37LicenseHistorySyncTask$TargetMapper">
<select id="selectExisting" resultType="cn.iocoder.yudao.module.pms.integration.basesync.task.P37LicenseHistorySyncTask$LicenseTarget">SELECT `id`,`tenant_id`,`device_id`,`contract_id`,`device_sn`,`contract_no`,`contract_type`,`product_code`,`product_model`,`license_status`,`creator`,`updater`,`create_time`,`update_time`,`deleted`,`license_code_ciphertext` FROM ast_device_license_record WHERE tenant_id=#{query.tenantId} <choose><when test="query.ids != null and !query.ids.isEmpty()">AND id IN <foreach collection="query.ids" item="id" open="(" close=")" separator=",">#{id}</foreach></when><otherwise>AND 1=0</otherwise></choose><if test="!query.preview">FOR UPDATE</if></select>
<insert id="insertLicenseHistory">INSERT INTO ast_device_license_record (`id`,`tenant_id`,`device_id`,`contract_id`,`device_sn`,`contract_no`,`contract_type`,`product_code`,`product_model`,`license_status`,`creator`,`updater`,`create_time`,`update_time`,`deleted`,`license_code_ciphertext`) VALUES <foreach collection="rows" item="row" separator=",">(#{row.target.id},#{row.target.tenantId},#{row.target.deviceId},#{row.target.contractId},#{row.target.deviceSn},#{row.target.contractNo},#{row.target.contractType},#{row.target.productCode},#{row.target.productModel},#{row.target.licenseStatus},#{row.target.creator},#{row.target.updater},#{row.target.createTime},#{row.target.updateTime},#{row.target.deleted},#{row.target.licenseCodeCiphertext})</foreach></insert>
</mapper>
