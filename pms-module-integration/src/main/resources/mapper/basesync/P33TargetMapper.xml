<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.integration.basesync.task.P33InstallationSyncTask$TargetMapper"><select id="selectDevices" resultType="cn.iocoder.yudao.module.pms.integration.basesync.task.P33InstallationSyncTask$Device">SELECT id,sn FROM ast_device WHERE tenant_id=#{query.tenantId} AND deleted=FALSE <choose><when test="query.serials != null and !query.serials.isEmpty()">AND sn IN <foreach collection="query.serials" item="sn" open="(" close=")" separator=",">#{sn}</foreach></when><otherwise>AND 1=0</otherwise></choose><if test="!query.preview"> FOR UPDATE</if></select>
<select id="selectExisting" resultType="cn.iocoder.yudao.module.pms.integration.basesync.task.P33InstallationSyncTask$Row">SELECT `id`,`project_id`,`code`,`equipment_id`,`install_location`,`address_id`,`address_version`,`site_id`,`site_version`,`site_location_id`,`site_location_version`,`location_resolution_status`,`address_snapshot`,`location_snapshot`,`effective_from`,`effective_to`,`current_equipment_id`,`install_time`,`installer_user_id`,`environment_check`,`spec_check`,`photo_url`,`result`,`status`,`remark`,`version`,`creator`,`create_time`,`updater`,`update_time`,`deleted`,`tenant_id` FROM imp_eng_installation WHERE tenant_id=#{query.tenantId} AND (1=0 <if test="query.projectIds != null and !query.projectIds.isEmpty()">OR project_id IN <foreach collection="query.projectIds" item="id" open="(" close=")" separator=",">#{id}</foreach></if><if test="query.equipmentIds != null and !query.equipmentIds.isEmpty()">OR equipment_id IN <foreach collection="query.equipmentIds" item="id" open="(" close=")" separator=",">#{id}</foreach></if>) ORDER BY id LIMIT #{query.limit}<if test="!query.preview"> FOR UPDATE</if></select>
<insert id="insertInstallation">INSERT INTO imp_eng_installation (`id`,`project_id`,`code`,`equipment_id`,`install_location`,`address_id`,`address_version`,`site_id`,`site_version`,`site_location_id`,`site_location_version`,`location_resolution_status`,`address_snapshot`,`location_snapshot`,`effective_from`,`effective_to`,`install_time`,`installer_user_id`,`environment_check`,`spec_check`,`photo_url`,`result`,`status`,`remark`,`version`,`creator`,`create_time`,`updater`,`update_time`,`deleted`,`tenant_id`) VALUES <foreach collection="rows" item="row" separator=",">(#{row.target.id},#{row.target.projectId},#{row.target.code},#{row.target.equipmentId},#{row.target.installLocation},#{row.target.addressId},#{row.target.addressVersion},#{row.target.siteId},#{row.target.siteVersion},#{row.target.siteLocationId},#{row.target.siteLocationVersion},#{row.target.locationResolutionStatus},#{row.target.addressSnapshot},#{row.target.locationSnapshot},#{row.target.effectiveFrom},#{row.target.effectiveTo},#{row.target.installTime},#{row.target.installerUserId},#{row.target.environmentCheck},#{row.target.specCheck},#{row.target.photoUrl},#{row.target.result},#{row.target.status},#{row.target.remark},#{row.target.version},#{row.target.creator},#{row.target.createTime},#{row.target.updater},#{row.target.updateTime},#{row.target.deleted},#{row.target.tenantId})</foreach></insert></mapper>
