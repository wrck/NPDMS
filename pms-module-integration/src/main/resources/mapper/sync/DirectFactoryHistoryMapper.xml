<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectFactoryHistoryMapper">
<select id="selectGlobalRecordForUpdate" resultType="cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectFactoryHistoryRow">
SELECT * FROM ast_device_factory_version_record WHERE tenant_id=#{query.tenantId} AND project_id IS NULL AND id=#{query.id} FOR UPDATE
</select>
<insert id="insert">INSERT INTO ast_device_factory_version_record(id,tenant_id,project_id,device_sn,conp_version,boot_version,cpld_version,pcb_version,creator,create_time,updater,update_time,deleted)
VALUES(#{row.id},#{row.tenantId},#{row.projectId},#{row.deviceSn},#{row.conpVersion},#{row.bootVersion},#{row.cpldVersion},#{row.pcbVersion},#{row.creator},#{row.createTime},#{row.updater},#{row.updateTime},#{row.deleted})</insert>
</mapper>
