<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectLicenseHistoryMapper">
<select id="selectRecordForUpdate" resultType="cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectLicenseHistoryRow">SELECT * FROM ast_device_license_record WHERE tenant_id=#{query.tenantId} AND id=#{query.id} FOR UPDATE</select>
<select id="selectDevice" resultType="cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectDeviceBaseRow">SELECT id,tenant_id,sn,deleted FROM ast_device WHERE tenant_id=#{query.tenantId} AND sn=#{query.sn} AND deleted=0</select>
<select id="selectContractIds" resultType="java.lang.Long">
    SELECT id FROM com_contract WHERE tenant_id=#{query.tenantId} AND contract_no=#{query.contractNo} AND deleted=0 LIMIT 2
</select>
<insert id="insert">INSERT INTO ast_device_license_record(id,tenant_id,device_id,device_sn,contract_id,contract_no,contract_type,product_code,product_model,license_status,license_code_ciphertext,creator,create_time,updater,update_time,deleted)
VALUES(#{row.id},#{row.tenantId},#{row.deviceId},#{row.deviceSn},#{row.contractId},#{row.contractNo},#{row.contractType},#{row.productCode},#{row.productModel},#{row.licenseStatus},#{row.licenseCodeCiphertext},#{row.creator},#{row.createTime},#{row.updater},#{row.updateTime},#{row.deleted})</insert>
</mapper>
