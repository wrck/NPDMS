<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.integration.dal.mysql.deviceops.DeviceOpsDispatchMapper">
    <select id="lockByTenantAndPlatformTaskId" resultType="cn.iocoder.yudao.module.pms.integration.dal.dataobject.deviceops.DeviceOpsDispatchDO">
        SELECT * FROM int_device_ops_dispatch
        WHERE tenant_id = #{tenantId} AND platform_task_id = #{platformTaskId} AND deleted = b'0'
        FOR UPDATE
    </select>
</mapper>
