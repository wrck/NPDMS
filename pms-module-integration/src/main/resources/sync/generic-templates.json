  {
    "key": "contract-master",
    "name": "合同主档生成",
    "definition": {
      "adapter": "TABLE_MAPPING",
      "taskKey": "contract-master",
      "sourceSystem": "DPPMS",
      "mode": "ONCE",
      "loadingMode": "UPSERT",
      "missingPolicy": "RETAIN",
      "cron": "0 0 2 * * ?",
      "fullCron": "0 0 2 ? * SUN",
      "overlapSeconds": 0,
      "retryCount": 0,
      "retryIntervalSeconds": 60,
      "maxRows": 2000,
      "maxBytes": 67108864,
      "readStrategy": "STREAMING_CURSOR",
      "fetchSize": 2000,
      "chunkSize": 500,
      "restartPolicy": "RESTART_ALL",
      "queryTimeoutSeconds": 0,
      "sources": [
        {
          "object": "CONTRACT",
          "sourceObject": "pm_order_data_from_erp",
          "readMode": "SQL",
          "table": "pm_order_data_from_erp",
          "sql": "SELECT e.*,CASE WHEN u.company_code IS NOT NULL THEN (SELECT r.`currency_name` FROM sms_ofst_contract_head_sap r WHERE r.contract_num=e.contract_no AND r.`currency_name` IS NOT NULL AND CAST(r.`currency_name` AS CHAR)<>'' ORDER BY r.update_time DESC,r.id DESC LIMIT 1) ELSE NULL END AS `currency_name`,CASE WHEN u.company_code IS NOT NULL THEN (SELECT r.`contract_create_date` FROM sms_ofst_contract_head_sap r WHERE r.contract_num=e.contract_no AND r.`contract_create_date` IS NOT NULL AND CAST(r.`contract_create_date` AS CHAR)<>'' ORDER BY r.update_time DESC,r.id DESC LIMIT 1) ELSE NULL END AS `contract_create_time`,CASE WHEN u.company_code IS NOT NULL THEN COALESCE((SELECT s.`project_name` FROM fb_contract s WHERE s.contract_code=e.contract_no AND s.`project_name` IS NOT NULL AND s.`project_name`<>'' ORDER BY s.contract_id DESC LIMIT 1),(SELECT r.`project_name` FROM sms_ofst_contract_head_sap r WHERE r.contract_num=e.contract_no AND r.`project_name` IS NOT NULL AND CAST(r.`project_name` AS CHAR)<>'' ORDER BY r.update_time DESC,r.id DESC LIMIT 1)) ELSE NULL END AS `project_name`,CASE WHEN u.company_code IS NOT NULL THEN (SELECT r.`projectCode` FROM sms_ofst_contract_head_sap r WHERE r.contract_num=e.contract_no AND r.`projectCode` IS NOT NULL AND CAST(r.`projectCode` AS CHAR)<>'' ORDER BY r.update_time DESC,r.id DESC LIMIT 1) ELSE NULL END AS `project_code`,CASE WHEN u.company_code IS NOT NULL THEN COALESCE((SELECT s.`marketCode` FROM fb_contract s WHERE s.contract_code=e.contract_no AND s.`marketCode` IS NOT NULL AND s.`marketCode`<>'' ORDER BY s.contract_id DESC LIMIT 1),(SELECT r.`marketCode` FROM sms_ofst_contract_head_sap r WHERE r.contract_num=e.contract_no AND r.`marketCode` IS NOT NULL AND CAST(r.`marketCode` AS CHAR)<>'' ORDER BY r.update_time DESC,r.id DESC LIMIT 1)) ELSE NULL END AS `market_code`,CASE WHEN u.company_code IS NOT NULL THEN COALESCE((SELECT s.`marketName` FROM fb_contract s WHERE s.contract_code=e.contract_no AND s.`marketName` IS NOT NULL AND s.`marketName`<>'' ORDER BY s.contract_id DESC LIMIT 1),(SELECT r.`maketing_department_name` FROM sms_ofst_contract_head_sap r WHERE r.contract_num=e.contract_no AND r.`maketing_department_name` IS NOT NULL AND CAST(r.`maketing_department_name` AS CHAR)<>'' ORDER BY r.update_time DESC,r.id DESC LIMIT 1)) ELSE NULL END AS `market_name`,CASE WHEN u.company_code IS NOT NULL THEN COALESCE((SELECT s.`office_code` FROM fb_contract s WHERE s.contract_code=e.contract_no AND s.`office_code` IS NOT NULL AND s.`office_code`<>'' ORDER BY s.contract_id DESC LIMIT 1),(SELECT r.`officeCode` FROM sms_ofst_contract_head_sap r WHERE r.contract_num=e.contract_no AND r.`officeCode` IS NOT NULL AND CAST(r.`officeCode` AS CHAR)<>'' ORDER BY r.update_time DESC,r.id DESC LIMIT 1)) ELSE NULL END AS `department_code`,CASE WHEN u.company_code IS NOT NULL THEN (SELECT r.`office_name` FROM sms_ofst_contract_head_sap r WHERE r.contract_num=e.contract_no AND r.`office_name` IS NOT NULL AND CAST(r.`office_name` AS CHAR)<>'' ORDER BY r.update_time DESC,r.id DESC LIMIT 1) ELSE NULL END AS `department_name`,CASE WHEN u.company_code IS NOT NULL THEN (SELECT r.`industryId` FROM sms_ofst_contract_head_sap r WHERE r.contract_num=e.contract_no AND r.`industryId` IS NOT NULL AND CAST(r.`industryId` AS CHAR)<>'' ORDER BY r.update_time DESC,r.id DESC LIMIT 1) ELSE NULL END AS `industry_code`,CASE WHEN u.company_code IS NOT NULL THEN (SELECT r.`industry_name` FROM sms_ofst_contract_head_sap r WHERE r.contract_num=e.contract_no AND r.`industry_name` IS NOT NULL AND CAST(r.`industry_name` AS CHAR)<>'' ORDER BY r.update_time DESC,r.id DESC LIMIT 1) ELSE NULL END AS `industry_name`,CASE WHEN u.company_code IS NOT NULL THEN (SELECT r.`usernamec` FROM sms_ofst_contract_head_sap r WHERE r.contract_num=e.contract_no AND r.`usernamec` IS NOT NULL AND CAST(r.`usernamec` AS CHAR)<>'' ORDER BY r.update_time DESC,r.id DESC LIMIT 1) ELSE NULL END AS `marketing_representative_code`,CASE WHEN u.company_code IS NOT NULL THEN (SELECT r.`marketing_representative_name` FROM sms_ofst_contract_head_sap r WHERE r.contract_num=e.contract_no AND r.`marketing_representative_name` IS NOT NULL AND CAST(r.`marketing_representative_name` AS CHAR)<>'' ORDER BY r.update_time DESC,r.id DESC LIMIT 1) ELSE NULL END AS `marketing_representative_name`,CASE WHEN u.company_code IS NOT NULL THEN (SELECT r.`usernamec2` FROM sms_ofst_contract_head_sap r WHERE r.contract_num=e.contract_no AND r.`usernamec2` IS NOT NULL AND CAST(r.`usernamec2` AS CHAR)<>'' ORDER BY r.update_time DESC,r.id DESC LIMIT 1) ELSE NULL END AS `secondary_representative_code`,CASE WHEN u.company_code IS NOT NULL THEN (SELECT s.`systemName` FROM fb_contract s WHERE s.contract_code=e.contract_no AND s.`systemName` IS NOT NULL AND s.`systemName`<>'' ORDER BY s.contract_id DESC LIMIT 1) ELSE NULL END AS `system_name` FROM (SELECT MIN(id) AS id,compCode AS company_code,contractNo AS contract_no,MIN(customerCode) AS customer_code,MIN(customerName) AS customer_name, CASE WHEN COUNT(DISTINCT NULLIF(customerCode,''))>1 OR COUNT(DISTINCT NULLIF(customerName,''))>1 THEN 'CONTRACT_CUSTOMER_CONFLICT' ELSE NULL END AS migration_issue FROM pm_order_data_from_erp WHERE contractNo IS NOT NULL AND contractNo<>'' AND compCode IS NOT NULL AND compCode<>'' GROUP BY compCode,contractNo) e LEFT JOIN (SELECT contractNo, MIN(compCode) AS company_code FROM pm_order_data_from_erp WHERE compCode IS NOT NULL AND compCode <> '' GROUP BY contractNo HAVING COUNT(DISTINCT compCode)=1) u ON u.contractNo=e.contract_no",
          "parameters": {},
          "columns": [],
          "filters": [],
          "sourceKey": "id",
          "mappings": [],
          "targets": [
            {
              "name": "contract",
              "table": "com_contract",
              "keys": [
                "company_code",
                "contract_no"
              ],
              "mode": "UPSERT",
              "nullPolicy": "IGNORE",
              "updateColumns": [
                "currency_name",
                "contract_create_time",
                "project_name",
                "project_code",
                "market_code",
                "market_name",
                "department_code",
                "department_name",
                "industry_code",
                "industry_name",
                "marketing_representative_code",
                "marketing_representative_name",
                "secondary_representative_code",
                "system_name"
              ],
              "whenField": null,
              "newerBy": null,
              "mappings": [
                {
                  "target": "company_code",
                  "source": "company_code",
                  "conversion": "DIRECT"
                },
                {
                  "target": "contract_no",
                  "source": "contract_no",
                  "conversion": "DIRECT"
                },
                {
                  "target": "customer_code",
                  "source": "customer_code",
