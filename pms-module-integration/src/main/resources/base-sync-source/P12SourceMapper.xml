<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.integration.basesync.task.P12SupplementProductSyncTask$SourceMapper">
  
  <select id="selectSupplementProduct" resultType="cn.iocoder.yudao.module.pms.integration.basesync.task.P12SupplementProductSyncTask$ProductSyncRow">
    SELECT item AS product_code, itemname AS product_model, describe_ AS product_name, describe_ AS product_desc
    FROM fb_items ORDER BY item, id LIMIT #{limit}
  </select>
</mapper>
