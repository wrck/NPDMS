<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.platform.dal.mysql.export.PlatformExportAuditMapper">
    <select id="selectNextSequenceForUpdate" resultType="java.lang.Integer">
        SELECT COALESCE(MAX(audit_sequence), 0) + 1
        FROM plt_export_audit
        WHERE tenant_id=#{tenantId} AND export_task_id=#{taskId}
        FOR UPDATE
    </select>
</mapper>
