<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.platform.dal.mysql.collection.DeviceCredentialMapper">

    <select id="selectByTenantAndId"
            resultType="cn.iocoder.yudao.module.pms.platform.dal.dataobject.collection.DeviceCredentialDO">
        SELECT *
        FROM plt_device_credential
        WHERE tenant_id = #{tenantId}
          AND id = #{credentialId}
          AND deleted = b'0'
    </select>
</mapper>
