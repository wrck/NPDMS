<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.platform.dal.mysql.collection.DeviceLogParseMapper">
    <select id="selectByRequestKeyForUpdate" resultType="cn.iocoder.yudao.module.pms.platform.dal.dataobject.collection.DeviceLogParseDO">
        SELECT * FROM plt_device_log_parse WHERE tenant_id=#{tenantId} AND request_key=#{key} AND deleted=b'0' FOR UPDATE
    </select>
    <select id="selectByTenantAndIdForUpdate" resultType="cn.iocoder.yudao.module.pms.platform.dal.dataobject.collection.DeviceLogParseDO">
        SELECT * FROM plt_device_log_parse WHERE tenant_id=#{tenantId} AND id=#{id} AND deleted=b'0' FOR UPDATE
    </select>
</mapper>
