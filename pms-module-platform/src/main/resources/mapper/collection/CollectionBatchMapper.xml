<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.platform.dal.mysql.collection.CollectionBatchMapper">

    <select id="selectByTenantAndIdempotencyKey"
            resultType="cn.iocoder.yudao.module.pms.platform.dal.dataobject.collection.CollectionBatchDO">
        SELECT *
        FROM plt_collection_batch
        WHERE tenant_id = #{tenantId}
          AND idempotency_key = #{idempotencyKey}
          AND deleted = b'0'
    </select>
</mapper>
