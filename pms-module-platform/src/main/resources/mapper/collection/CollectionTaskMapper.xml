<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.platform.dal.mysql.collection.CollectionTaskMapper">

    <select id="selectByTenantAndPlatformTaskId"
            resultType="cn.iocoder.yudao.module.pms.platform.dal.dataobject.collection.CollectionTaskDO">
        SELECT *
        FROM plt_collection_task
        WHERE tenant_id = #{tenantId}
          AND platform_task_id = #{platformTaskId}
          AND deleted = b'0'
    </select>

    <select id="selectListByBatchId"
            resultType="cn.iocoder.yudao.module.pms.platform.dal.dataobject.collection.CollectionTaskDO">
        SELECT *
        FROM plt_collection_task
        WHERE batch_id = #{batchId}
          AND deleted = b'0'
        ORDER BY id
    </select>
</mapper>
