<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.platform.service.businessmodel.declared.DirectBusinessCrudMySqlTest$SpecialMapper">
    <sql id="scope">
        tenant_id=#{query.tenantId} AND deleted=0
        <choose><when test="query.projectIds != null and query.projectIds.size() > 0">
            AND project_id IN <foreach collection="query.projectIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        </when><otherwise>AND 1=0</otherwise></choose>
    </sql>
    <select id="selectDisplayPage" resultType="cn.iocoder.yudao.module.pms.platform.service.businessmodel.declared.DirectBusinessCrudMySqlTest$Special">
        <bind name="offset" value="(query.criteria.pageNo - 1L) * query.criteria.pageSize"/>
        SELECT id, tenant_id, project_id, version, CONCAT('SQL:',title) AS title, remark, deleted, creator, create_time, updater, update_time
        FROM it_direct_special WHERE <include refid="scope"/> ORDER BY id DESC LIMIT #{query.criteria.pageSize} OFFSET #{offset}
    </select>
    <select id="countDisplayPage" resultType="long">SELECT COUNT(*) FROM it_direct_special WHERE <include refid="scope"/></select>
</mapper>
