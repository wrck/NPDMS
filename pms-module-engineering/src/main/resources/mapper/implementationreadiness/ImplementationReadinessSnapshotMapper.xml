<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.engineering.dal.mysql.implementationreadiness.ImplementationReadinessSnapshotMapper">
  <resultMap id="structuredImplementationReadinessSnapshotDO" type="cn.iocoder.yudao.module.pms.engineering.dal.dataobject.implementationreadiness.ImplementationReadinessSnapshotDO" autoMapping="false">
    <id column="id" property="id"/>
    <result column="tenant_id" property="tenantId"/>
    <result column="project_id" property="projectId"/>
    <result column="device_scope_key" property="deviceScopeKey"/>
    <result column="snapshot_no" property="snapshotNo"/>
    <result column="readiness_decision_code" property="decision"/>
    <result column="evaluate_user_id" property="evaluatedBy"/>
    <result column="creator" property="creator"/>
    <result column="create_time" property="createTime"/>
    <result column="updater" property="updater"/>
    <result column="update_time" property="updateTime"/>
    <result column="deleted" property="deleted"/>
    <result column="project_scope_version" property="projectScopeVersion"/>
    <result column="approved_plan_id" property="approvedPlanId"/>
    <result column="approved_plan_version" property="approvedPlanVersion"/>
    <result column="project_plan_version_id" property="projectPlanVersionId"/>
    <result column="project_plan_version" property="projectPlanVersion"/>
  </resultMap>

  <select id="latest" resultMap="structuredImplementationReadinessSnapshotDO">
    SELECT id, tenant_id, project_id, device_scope_key, snapshot_no, readiness_decision_code, evaluate_user_id, creator, create_time, updater, update_time, deleted, project_scope_version, approved_plan_id, approved_plan_version, project_plan_version_id, project_plan_version FROM imp_cutover_readiness_snapshot
    WHERE tenant_id = #{query.tenantId} AND project_id = #{query.projectId}
      AND device_scope_key = #{query.deviceScopeKey} AND deleted = 0
    ORDER BY snapshot_no DESC LIMIT 1
  </select>
  <select id="lastNumber" resultType="java.lang.Integer">
    SELECT COALESCE(MAX(snapshot_no), 0) FROM imp_cutover_readiness_snapshot
    WHERE tenant_id = #{query.tenantId} AND project_id = #{query.projectId}
  </select>
</mapper>
