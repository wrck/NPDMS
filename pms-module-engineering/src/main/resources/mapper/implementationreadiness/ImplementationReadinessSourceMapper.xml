<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.engineering.dal.mysql.implementationreadiness.ImplementationReadinessSourceMapper">
  <sql id="projectScope">tenant_id = #{query.tenantId} AND project_id = #{query.projectId} AND deleted = 0</sql>
  <select id="installations" resultType="cn.iocoder.yudao.module.pms.engineering.dal.dataobject.installation.InstallationDO">
    SELECT * FROM imp_eng_installation WHERE <include refid="projectScope"/> AND effective_to IS NULL
    ORDER BY id <if test="query.lock">FOR UPDATE</if>
  </select>
  <select id="configurations" resultType="cn.iocoder.yudao.module.pms.engineering.dal.dataobject.configuration.ConfigurationDO">
    SELECT * FROM imp_eng_configuration WHERE <include refid="projectScope"/>
    ORDER BY id <if test="query.lock">FOR UPDATE</if>
  </select>
  <select id="jointTests" resultType="cn.iocoder.yudao.module.pms.engineering.dal.dataobject.jointtest.JointTestDO">
    SELECT * FROM imp_eng_joint_test WHERE <include refid="projectScope"/>
    ORDER BY id <if test="query.lock">FOR UPDATE</if>
  </select>
  <select id="approvedSolutions" resultType="cn.iocoder.yudao.module.pms.engineering.dal.dataobject.solution.SolutionDO">
    SELECT * FROM sol_eng_solution WHERE <include refid="projectScope"/>
      AND solution_type = 'IMPLEMENTATION' AND status = 3 AND approved_by IS NOT NULL
      AND approved_time IS NOT NULL AND baseline_version = version AND baseline_version &gt; 0
    ORDER BY approved_time DESC, id DESC <if test="query.lock">FOR UPDATE</if>
  </select>
</mapper>
