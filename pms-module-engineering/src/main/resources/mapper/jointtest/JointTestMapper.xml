<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.engineering.dal.mysql.jointtest.JointTestMapper">

    <!-- 记录编码全集（含软删除行）：唯一键 (project_id, code) 不含 deleted，推号必须看见被占用编码 -->
    <select id="selectRecordCodesIncludeDeleted" resultType="java.lang.String">
        SELECT code
        FROM imp_eng_joint_test
        WHERE project_id = #{projectId}
          AND code IS NOT NULL
    </select>
    <select id="selectAttachmentOwnerForUpdate" resultType="cn.iocoder.yudao.module.pms.engineering.dal.dataobject.jointtest.JointTestDO">
        SELECT * FROM imp_eng_joint_test
        WHERE tenant_id = #{query.tenantId} AND id = #{query.id} AND deleted = 0 FOR UPDATE
    </select>
</mapper>
