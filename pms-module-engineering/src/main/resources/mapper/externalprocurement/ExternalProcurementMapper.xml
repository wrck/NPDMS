<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.engineering.dal.mysql.externalprocurement.ExternalProcurementMapper">
    <select id="selectAttachmentOwnerForUpdate" resultType="cn.iocoder.yudao.module.pms.engineering.dal.dataobject.externalprocurement.ExternalProcurementDO">
        SELECT * FROM imp_eng_external_procurement
        WHERE tenant_id = #{query.tenantId} AND id = #{query.id} AND deleted = 0 FOR UPDATE
    </select>
</mapper>
