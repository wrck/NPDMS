  "deliveryActivities": [
    {
      "key": "R01",
      "name": "生产环境与数据库基线",
      "requirement": "确认租户、目标实例、生产已有业务/种子、来源截止时点和备份恢复；新安装与已有库升级分别核对。新验证库建库成功不能证明已有库升级通过；原Flyway差异不得以repair/clean覆盖。"
    },
    {
      "key": "R02",
      "name": "来源连接与目录依赖",
      "requirement": "建立DPPMS、CRM只读连接，使用受保护凭据；不迁原验证库自连接。核对公司、全部批准补充部门、岗位/字典、真实执行人和适用数据范围。P03在P04后补关联主管。"
    },
    {
      "key": "R03",
      "name": "首次迁入配置与正式Owner",
      "requirement": "将旧恢复/纠正凭据与业务映射分开；重绑连接及当前目标引用，P19/P36按批准定义重绑正式实体扩展。P12移除产品扩展定义、标签匹配及扩展读写依赖。P32接入PROJ历史成员承接，取消最终客户相关方及CUS联系人入口依赖。P11/P15/P26至P29不能把GenericSyncJdbcStore跨域直接写表当成生产Owner入口；补齐P30至P37的任务化。"
    },
    {
      "key": "R04",
      "name": "完整预览与问题闭合",
      "requirement": "在匹配生产基线的隔离环境按任务依赖演练；完整来源身份逐项有处置、根分页总量对账。PREVIEW_READY带ISSUE不等于全部可迁，带未解决行的分批范围须明确。来源冲突、目标人工变化、权限/租户、失败回滚和重放按实际改动验证；批准排除与未解决问题分别列清。"
    },
    {
      "key": "R05",
      "name": "生产批次执行",
      "requirement": "形成冻结任务版本、来源范围、预计新增/更新/接管实体数量及每层关联清单后，按已批准批次经任务API和领域Owner执行。全部任务默认停用，首次运行手动发起；不复制旧运行、断点或来源绑定，不自动启用定时同步。"
    },
    {
      "key": "R06",
      "name": "正式页面验收与交接",
      "requirement": "按项目/合同/设备真实登录操作并重开查询，覆盖授权、当前/历史成员（含P32历史联系人）、主责/联系人、安装、软件及许可；与Owner回执和逐字段对账闭合。发货与续保输入齐备后按批准原规则核对维保计算，既有投影变化单独预览，不直接覆盖。"
    }
  ],
