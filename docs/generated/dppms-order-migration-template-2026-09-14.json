      "sourceObject": "pm_order_data_from_erp",
      "sql": "SELECT r.*,g.migrationVersion,CASE WHEN g.payloadVariants > 1 THEN 'DUPLICATE_BUSINESS_KEY_CONFLICT' ELSE NULL END AS migrationIssue  FROM pm_order_data_from_erp r JOIN (SELECT source,compCode,orderType,orderNumber,MAX(syncTime) AS migrationVersion,COUNT(DISTINCT JSON_ARRAY(orderCreateTime,customerRequireTime,customerCode,customerName,projectName,orderComment,salesType)) AS payloadVariants FROM pm_order_data_from_erp GROUP BY source,compCode,orderType,orderNumber) g ON r.source <=> g.source AND r.compCode <=> g.compCode AND r.orderType <=> g.orderType AND r.orderNumber <=> g.orderNumber",
