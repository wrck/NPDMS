+    { label: '创建时间', value: formatSourceDate(row.values.sourceCreatedAt, 'createTime') },
+    { label: '更新人', value: row.values.sourceUpdatedBy },
+    { label: '更新时间', value: formatSourceDate(row.values.sourceUpdatedAt, 'updateTime') }
+  ]
+})
+const load = async () => {
+  const version = ++requestVersion
+  loading.value = true
+  error.value = ''
+  try {
+    const page = await getInstallationSourceRecords({
+      equipmentId: props.deviceId,
+      pageNo: pageNo.value,
+      pageSize: pageSize.value
+    })
+    if (version !== requestVersion) return
+    rows.value = page.list || []
+    total.value = page.total || 0
+  } catch {
+    if (version === requestVersion) {
+      rows.value = []
+      total.value = 0
+      error.value = '安装记录加载失败'
+    }
+  } finally {
+    if (version === requestVersion) loading.value = false
+  }
+}
+const changePageSize = () => {
+  pageNo.value = 1
+  load()
+}
+watch(
+  () => props.deviceId,
+  () => {
+    pageNo.value = 1
+    rows.value = []
+    total.value = 0
+    selected.value = undefined
+    detailVisible.value = false
+    load()
+  },
+  { immediate: true }
+)
+onBeforeUnmount(() => {
+  requestVersion++
+})
+</script>
+<style scoped>
+.source-history {
+  padding-top: 16px;
+  border-top: 1px solid var(--el-border-color-extra-light);
+}
+.source-history h3 {
+  margin: 0 0 12px;
+  font-size: 16px;
+}
+.source-history :deep(.el-pagination) {
+  margin-top: 12px;
+}
+</style>

