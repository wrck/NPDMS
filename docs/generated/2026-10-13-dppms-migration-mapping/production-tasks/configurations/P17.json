    "writerClasses": [
      "ProjectMasterMigrationApi"
    ],
    "businessKey": "全部原projectId逐条绑定到同类型同码规范正式项目",
    "genericAssessment": "有专用适配器。该任务不迁一张新业务表，而是经PROJ核实身份后写INT来源绑定；通用业务表UPSERT不能替代跨来源项目身份与多源共目标的校验。",
    "processing": [
      "读取每个原projectId及其同类型同码规范projectId/code。",
      "通过PROJ正式身份解析和既有运行/配置校验确认目标。",
      "仅维护int_sync_binding，覆盖全部原ID，不再创建同码项目。"
    ],
    "specialRules": [
      "后续成员、软件等明细必须遍历全部原ID，不能只读每组最大projectId的明细。"
    ],
    "materialQueries": []
  },
  "sources": [
    {
      "sql": "SELECT original.projectId AS originalProjectId,original.projectType,original.projectCode,\r\n  canonical.projectId AS canonicalProjectId\r\nFROM pm_project original\r\nJOIN (SELECT CONCAT(CAST(projectType AS BINARY),0x00,CAST(projectCode AS BINARY)) AS projectIdentity,\r\n  MAX(projectId) AS projectId FROM pm_project\r\n  GROUP BY CAST(projectType AS BINARY),CAST(projectCode AS BINARY)) canonical\r\n  ON canonical.projectIdentity <=> CONCAT(CAST(original.projectType AS BINARY),0x00,CAST(original.projectCode AS BINARY))\r\nWHERE FIND_IN_SET(original.projectType,:projectTypes)\r\n  AND (:projectIds='' OR FIND_IN_SET(canonical.projectId,:projectIds))",
      "table": null,
      "object": "pm_project_identity",
      "columns": [
        "originalProjectId",
        "projectType",
        "projectCode",
        "canonicalProjectId"
      ],
