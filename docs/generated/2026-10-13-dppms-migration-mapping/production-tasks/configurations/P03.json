  "sources": [
    {
      "sql": "SELECT d.depID,d.depCode,d.depName,d.depAbbr,d.compID,d.adminID,d.depGrade,d.depType,d.depProperty,d.depCost,d.director,d.director2,d.depEmp,d.depNum,d.effectDate,d.xOrder,CAST(d.isDisabled AS UNSIGNED) AS isDisabled,d.disabledDate,d.remark,d.depCustom1,d.depCustom2,d.depCustom3,d.depCustom4,d.depCustom5,f.id AS migrationFnd_id,f.departmentNum AS migrationFnd_departmentNum,f.departmentName AS migrationFnd_departmentName,f.isparam AS migrationFnd_isparam,f.status AS migrationFnd_status,f.createTime AS migrationFnd_createTime,f.effectiveFrom AS migrationFnd_effectiveFrom,f.effectiveTo AS migrationFnd_effectiveTo,f.updateTime AS migrationFnd_updateTime,p.depCode AS migrationParentCode,l.loginCount AS migrationDirectorLoginCount,l.account AS migrationDirectorAccount,fu.matchCount AS migrationDirectorFndCount,fu.id AS migrationDirectorFndId,tu.matchCount AS migrationDirectorTCount,tu.id AS migrationDirectorTId FROM ehr_department d LEFT JOIN fnd_department f ON CAST(f.departmentNum AS BINARY)=CAST(d.depCode AS BINARY) LEFT JOIN ehr_department p ON p.depID=d.adminID LEFT JOIN (SELECT empID,COUNT(*) AS loginCount,MIN(account) AS account FROM ehr_login GROUP BY empID) l ON l.empID=d.director LEFT JOIN (SELECT username,COUNT(*) AS matchCount,MIN(id) AS id FROM fnd_user_info GROUP BY username) fu ON CAST(fu.username AS BINARY)=CAST(l.account AS BINARY) LEFT JOIN (SELECT user_name,COUNT(*) AS matchCount,MIN(user_id) AS id FROM t_user GROUP BY user_name) tu ON CAST(tu.user_name AS BINARY)=CAST(l.account AS BINARY) WHERE d.depCode IN (:departmentCode0,:departmentCode1,:departmentCode2,:departmentCode3,:departmentCode4,:departmentCode5,:departmentCode6,:departmentCode7)",
