        "sourceObject": "t_role",
        "sql": "SELECT businessKey AS _groupKey,CAST(JSON_ARRAYAGG(JSON_OBJECT('object',objectName,'fields',CAST(fields AS JSON))) AS CHAR) AS _sourceRows\nFROM (\nSELECT COALESCE(HEX(CAST(CASE r.role_name WHEN 'admin' THEN 'super_admin' WHEN 'projectManager' THEN 'PROJECT_MANAGER' ELSE r.role_name END AS BINARY)),CONCAT('INVALID:T_ROLE:',r.`role_id`)) AS businessKey,'T_ROLE' AS objectName,JSON_OBJECT('role_id',r.`role_id`,'role_name',r.`role_name`,'role_name_zn',r.`role_name_zn`,'home_page',r.`home_page`,'priority',r.`priority`,'status',r.`status`,'create_by',r.`create_by`,'create_time',r.`create_time`,'update_by',r.`update_by`,'update_time',r.`update_time`,'remark',r.`remark`,'migrationSort',r.`migrationSort`,'migrationVersion',r.`migrationVersion`,'creatorSourceKey',r.`creatorSourceKey`,'updaterSourceKey',r.`updaterSourceKey`) AS fields FROM (\nSELECT r.*, 100-r.priority AS migrationSort, COALESCE(r.update_time,r.create_time) AS migrationVersion, (SELECT CASE WHEN COUNT(*)=1 THEN MAX(u.user_id) ELSE NULL END FROM t_user u WHERE u.user_name=r.create_by) AS creatorSourceKey, (SELECT CASE WHEN COUNT(*)=1 THEN MAX(u.user_id) ELSE NULL END FROM t_user u WHERE u.user_name=r.update_by) AS updaterSourceKey FROM t_role r WHERE r.status<>0 OR r.status IS NULL\n) r\nUNION ALL\nSELECT COALESCE(HEX(CAST(CASE CAST(r.id AS CHAR) WHEN '1' THEN 'admin' WHEN '3' THEN 'user' WHEN '5' THEN 'projectAdmin' WHEN '6' THEN 'projectViewer' WHEN '9' THEN 'areaLeader' WHEN '10' THEN 'engineeManagerLeader' WHEN '11' THEN 'SERVICE_MANAGER' WHEN '12' THEN 'PROJECT_MANAGER' WHEN '13' THEN 'engineeManager' WHEN '14' THEN 'callbackPer' WHEN '15' THEN 'salesPeople' WHEN '16' THEN 'financialStaff' WHEN '17' THEN 'presalesStaff' WHEN '18' THEN 'probAdmin' WHEN '19' THEN 'probSupporter' WHEN '20' THEN 'probRD' WHEN '21' THEN 'warrantyCallbacker' WHEN '22' THEN 'componentAdmin' ELSE CONCAT('UNREVIEWED:',r.id) END AS BINARY)),CONCAT('INVALID:FND_ROLE:',r.`id`)) AS businessKey,'FND_ROLE' AS objectName,JSON_OBJECT('id',r.`id`,'roleName',r.`roleName`,'defaultPage',r.`defaultPage`,'status',r.`status`,'effectiveFrom',r.`effectiveFrom`,'effectiveTo',r.`effectiveTo`,'createBy',r.`createBy`,'createTime',r.`createTime`,'updateBy',r.`updateBy`,'updateTime',r.`updateTime`,'roleRemark',r.`roleRemark`,'migrationSort',r.`migrationSort`,'migrationVersion',r.`migrationVersion`,'creatorSourceKey',r.`creatorSourceKey`,'updaterSourceKey',r.`updaterSourceKey`) AS fields FROM (\nSELECT r.*, 100+r.id AS migrationSort, COALESCE(r.updateTime,r.createTime) AS migrationVersion, (SELECT CASE WHEN COUNT(*)=1 THEN MAX(u.id) ELSE NULL END FROM fnd_user_info u WHERE u.username=r.createBy AND NOT (u.username='c00733' AND u.id=233) AND NOT (u.username='w02459' AND u.id=118)) AS creatorSourceKey, (SELECT CASE WHEN COUNT(*)=1 THEN MAX(u.id) ELSE NULL END FROM fnd_user_info u WHERE u.username=r.updateBy AND NOT (u.username='c00733' AND u.id=233) AND NOT (u.username='w02459' AND u.id=118)) AS updaterSourceKey FROM fnd_roles r WHERE r.status<>0 OR r.status IS NULL\n) r\n) combined GROUP BY businessKey",
