        "rowProjection": null,
        "sourceKey": "id",
        "sourceKeyColumns": null,
        "sourceObject": "pm_pb_plan_from_sms",
        "sql": "SELECT p.*,fc.actorId AS creatorFndSourceKey,tc.actorId AS creatorTSourceKey,\n  fu.actorId AS updaterFndSourceKey,tu.actorId AS updaterTSourceKey,\n  COALESCE(fc.matchCount,0) AS creatorFndMatchCount,COALESCE(tc.matchCount,0) AS creatorTMatchCount,\n  COALESCE(fu.matchCount,0) AS updaterFndMatchCount,COALESCE(tu.matchCount,0) AS updaterTMatchCount,\n  fc.actorIds AS creatorFndSourceKeys,fu.actorIds AS updaterFndSourceKeys\nFROM pm_pb_plan_from_sms p\nJOIN (SELECT DISTINCT pc.contractNo\nFROM pm_project_group_relationship m\nJOIN pm_project_group g ON g.projectGroupCode=m.projectGroupCode\n  AND CAST(g.projectGroupCode AS BINARY)=CAST(m.projectGroupCode AS BINARY)\nJOIN (SELECT DISTINCT scoped.projectId,scoped.projectCode,scoped.projectType\nFROM (SELECT original.*,canonical.projectId AS canonicalProjectId\nFROM pm_project original\nJOIN (\n  SELECT CAST(projectType AS BINARY) AS typeKey,CAST(projectCode AS BINARY) AS codeKey,\n    MAX(projectId) AS projectId\n  FROM pm_project\n  GROUP BY CAST(projectType AS BINARY),CAST(projectCode AS BINARY)\n) canonical ON canonical.typeKey <=> CAST(original.projectType AS BINARY)\n  AND canonical.codeKey <=> CAST(original.projectCode AS BINARY)\nJOIN pm_project current_project ON current_project.projectId=canonical.projectId\nWHERE current_project.disabled=0 AND current_project.effectiveTo IS NULL\n  AND original.disabled=0 AND original.effectiveTo IS NULL\n  AND FIND_IN_SET(current_project.projectType,:projectTypes)\n  AND (:projectIds='' OR FIND_IN_SET(canonical.projectId,:projectIds))) scoped\nWHERE scoped.projectId=scoped.canonicalProjectId) p\n  ON p.projectCode=REPLACE(m.projectCode,'-his','') AND p.projectType=g.projectType\n  AND CAST(p.projectCode AS BINARY)=CAST(REPLACE(m.projectCode,'-his','') AS BINARY)\n  AND CAST(p.projectType AS BINARY)=CAST(g.projectType AS BINARY)\nJOIN pm_project_contract pc ON pc.projectGroupCode=g.projectGroupCode\n  AND CAST(pc.projectGroupCode AS BINARY)=CAST(g.projectGroupCode AS BINARY)) scope ON scope.contractNo=p.contractNo\nLEFT JOIN (SELECT CAST(u.username AS BINARY) AS loginKey,COUNT(*) AS matchCount,\n  CASE WHEN COUNT(*)=1 THEN MAX(u.id) ELSE NULL END AS actorId,GROUP_CONCAT(u.id ORDER BY u.id) AS actorIds\n  FROM fnd_user_info u GROUP BY CAST(u.username AS BINARY)) fc ON fc.loginKey=CAST(p.createBy AS BINARY)\nLEFT JOIN (SELECT CAST(u.user_name AS BINARY) AS loginKey,COUNT(*) AS matchCount,\n  CASE WHEN COUNT(*)=1 THEN MAX(u.user_id) ELSE NULL END AS actorId\n  FROM t_user u GROUP BY CAST(u.user_name AS BINARY)) tc ON tc.loginKey=CAST(p.createBy AS BINARY)\nLEFT JOIN (SELECT CAST(u.username AS BINARY) AS loginKey,COUNT(*) AS matchCount,\n  CASE WHEN COUNT(*)=1 THEN MAX(u.id) ELSE NULL END AS actorId,GROUP_CONCAT(u.id ORDER BY u.id) AS actorIds\n  FROM fnd_user_info u GROUP BY CAST(u.username AS BINARY)) fu ON fu.loginKey=CAST(p.updateBy AS BINARY)\nLEFT JOIN (SELECT CAST(u.user_name AS BINARY) AS loginKey,COUNT(*) AS matchCount,\n  CASE WHEN COUNT(*)=1 THEN MAX(u.user_id) ELSE NULL END AS actorId\n  FROM t_user u GROUP BY CAST(u.user_name AS BINARY)) tu ON tu.loginKey=CAST(p.updateBy AS BINARY)\nWHERE (:planIds='' OR FIND_IN_SET(p.id,:planIds))",
        "syncPrimaryKey": false,
