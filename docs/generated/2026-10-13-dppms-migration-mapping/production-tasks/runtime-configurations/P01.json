        "sourceKeyColumns": null,
        "sourceObject": "ehr_company",
        "sql": "SELECT businessKey AS _groupKey,CAST(JSON_ARRAYAGG(JSON_OBJECT('object',objectName,'fields',CAST(fields AS JSON))) AS CHAR) AS _sourceRows\nFROM (\nSELECT CONCAT('COMPANY:',HEX(CAST(r.`compCode` AS BINARY))) AS businessKey,'COMPANY' AS objectName,JSON_OBJECT('compID',r.`compID`,'compCode',r.`compCode`,'compName',r.`compName`,'isDisabled',CAST(r.`isDisabled` AS UNSIGNED)) AS fields FROM (\nSELECT `compID`,`compCode`,`compName`,`isDisabled` FROM `ehr_company`\n) r\nUNION ALL\nSELECT CONCAT('DEPARTMENT:',HEX(CAST(r.`depCode` AS BINARY))) AS businessKey,'DEPARTMENT' AS objectName,JSON_OBJECT('depID',r.`depID`,'depCode',r.`depCode`,'depName',r.`depName`,'isDisabled',CAST(r.`isDisabled` AS UNSIGNED),'adminID',r.`adminID`,'compID',r.`compID`) AS fields FROM (\nSELECT `depID`,`depCode`,`depName`,`isDisabled`,`adminID`,`compID`,`depGrade` FROM `ehr_department` WHERE `depGrade` <= '2' AND LENGTH(`depCode`) = '6'\n) r\nUNION ALL\nSELECT CONCAT('DEPARTMENT:',HEX(CAST(r.`departmentNum` AS BINARY))) AS businessKey,'fnd_department' AS objectName,JSON_OBJECT('id',r.`id`,'departmentNum',r.`departmentNum`,'departmentName',r.`departmentName`,'isparam',r.`isparam`,'status',r.`status`,'createTime',r.`createTime`,'effectiveFrom',r.`effectiveFrom`,'effectiveTo',r.`effectiveTo`,'updateTime',r.`updateTime`,'migrationEhrDepartmentId',r.`migrationEhrDepartmentId`,'migrationEhrDisabled',r.`migrationEhrDisabled`) AS fields FROM (\nSELECT d.id,d.departmentNum,d.departmentName,d.isparam,d.status,d.createTime,d.effectiveFrom,d.effectiveTo,d.updateTime,e.depID AS migrationEhrDepartmentId,CAST(e.isDisabled AS UNSIGNED) AS migrationEhrDisabled FROM fnd_department d LEFT JOIN ehr_department e ON CAST(e.depCode AS BINARY)=CAST(d.departmentNum AS BINARY) WHERE d.departmentNum=:P02_departmentCode0\n) r\nUNION ALL\nSELECT CONCAT('DEPARTMENT:',HEX(CAST(r.`depCode` AS BINARY))) AS businessKey,'ehr_department' AS objectName,JSON_OBJECT('depID',r.`depID`,'depCode',r.`depCode`,'depName',r.`depName`,'depAbbr',r.`depAbbr`,'compID',r.`compID`,'adminID',r.`adminID`,'depGrade',r.`depGrade`,'depType',r.`depType`,'depProperty',r.`depProperty`,'depCost',r.`depCost`,'director',r.`director`,'director2',r.`director2`,'depEmp',r.`depEmp`,'depNum',r.`depNum`,'effectDate',r.`effectDate`,'xOrder',r.`xOrder`,'isDisabled',CAST(r.`isDisabled` AS UNSIGNED),'disabledDate',r.`disabledDate`,'remark',r.`remark`,'depCustom1',r.`depCustom1`,'depCustom2',r.`depCustom2`,'depCustom3',r.`depCustom3`,'depCustom4',r.`depCustom4`,'depCustom5',r.`depCustom5`,'migrationFnd_id',r.`migrationFnd_id`,'migrationFnd_departmentNum',r.`migrationFnd_departmentNum`,'migrationFnd_departmentName',r.`migrationFnd_departmentName`,'migrationFnd_isparam',r.`migrationFnd_isparam`,'migrationFnd_status',r.`migrationFnd_status`,'migrationFnd_createTime',r.`migrationFnd_createTime`,'migrationFnd_effectiveFrom',r.`migrationFnd_effectiveFrom`,'migrationFnd_effectiveTo',r.`migrationFnd_effectiveTo`,'migrationFnd_updateTime',r.`migrationFnd_updateTime`,'migrationParentCode',r.`migrationParentCode`,'migrationDirectorLoginCount',r.`migrationDirectorLoginCount`,'migrationDirectorAccount',r.`migrationDirectorAccount`,'migrationDirectorFndCount',r.`migrationDirectorFndCount`,'migrationDirectorFndId',r.`migrationDirectorFndId`,'migrationDirectorTCount',r.`migrationDirectorTCount`,'migrationDirectorTId',r.`migrationDirectorTId`) AS fields FROM (\nSELECT d.depID,d.depCode,d.depName,d.depAbbr,d.compID,d.adminID,d.depGrade,d.depType,d.depProperty,d.depCost,d.director,d.director2,d.depEmp,d.depNum,d.effectDate,d.xOrder,CAST(d.isDisabled AS UNSIGNED) AS isDisabled,d.disabledDate,d.remark,d.depCustom1,d.depCustom2,d.depCustom3,d.depCustom4,d.depCustom5,f.id AS migrationFnd_id,f.departmentNum AS migrationFnd_departmentNum,f.departmentName AS migrationFnd_departmentName,f.isparam AS migrationFnd_isparam,f.status AS migrationFnd_status,f.createTime AS migrationFnd_createTime,f.effectiveFrom AS migrationFnd_effectiveFrom,f.effectiveTo AS migrationFnd_effectiveTo,f.updateTime AS migrationFnd_updateTime,p.depCode AS migrationParentCode,l.loginCount AS migrationDirectorLoginCount,l.account AS migrationDirectorAccount,fu.matchCount AS migrationDirectorFndCount,fu.id AS migrationDirectorFndId,tu.matchCount AS migrationDirectorTCount,tu.id AS migrationDirectorTId FROM ehr_department d LEFT JOIN fnd_department f ON CAST(f.departmentNum AS BINARY)=CAST(d.depCode AS BINARY) LEFT JOIN ehr_department p ON p.depID=d.adminID LEFT JOIN (SELECT empID,COUNT(*) AS loginCount,MIN(account) AS account FROM ehr_login GROUP BY empID) l ON l.empID=d.director LEFT JOIN (SELECT username,COUNT(*) AS matchCount,MIN(id) AS id FROM fnd_user_info GROUP BY username) fu ON CAST(fu.username AS BINARY)=CAST(l.account AS BINARY) LEFT JOIN (SELECT user_name,COUNT(*) AS matchCount,MIN(user_id) AS id FROM t_user GROUP BY user_name) tu ON CAST(tu.user_name AS BINARY)=CAST(l.account AS BINARY) WHERE d.depCode IN (:P03_departmentCode0,:P03_departmentCode1,:P03_departmentCode2,:P03_departmentCode3,:P03_departmentCode4,:P03_departmentCode5,:P03_departmentCode6,:P03_departmentCode7)\n) r\n) combined GROUP BY businessKey",
