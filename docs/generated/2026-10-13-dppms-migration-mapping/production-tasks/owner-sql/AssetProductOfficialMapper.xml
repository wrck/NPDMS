<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.asset.dal.mysql.product.AssetProductOfficialMapper">
    <select id="selectByProductCodeForUpdate" resultType="cn.iocoder.yudao.module.pms.asset.dal.dataobject.product.AssetProductOfficialDO">
        SELECT * FROM ast_product_official_info
        WHERE tenant_id=#{query.tenantId} AND product_code=#{query.productCode} FOR UPDATE
    </select>
</mapper>
