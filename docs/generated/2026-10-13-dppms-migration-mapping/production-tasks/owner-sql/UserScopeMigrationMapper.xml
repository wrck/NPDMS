<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.system.dal.mysql.permission.UserScopeMigrationMapper">
    <sql id="relations">
        SELECT id,tenant_id,user_id,company_id,company_code,company_name,department_id,department_code,
               department_name,scope_role,is_primary,effective_from,effective_to,status,version,
               creator,create_time,updater,update_time,deleted
        FROM system_user_company_department_scope WHERE tenant_id=#{query.tenantId} AND deleted=FALSE ORDER BY id
    </sql>
    <select id="selectRelations" resultType="cn.iocoder.yudao.module.system.dal.dataobject.permission.UserCompanyDepartmentScopeDO"><include refid="relations"/></select>
    <select id="selectRelationsForUpdate" resultType="cn.iocoder.yudao.module.system.dal.dataobject.permission.UserCompanyDepartmentScopeDO"><include refid="relations"/> FOR UPDATE</select>
    <sql id="users">
        SELECT id FROM system_users WHERE tenant_id=#{query.tenantId} AND deleted=FALSE
        <choose><when test="query.userIds != null and !query.userIds.isEmpty()">
            AND id IN <foreach collection="query.userIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        </when><otherwise>AND 1=0</otherwise></choose> ORDER BY id
    </sql>
    <select id="selectUserIds" resultType="java.lang.Long"><include refid="users"/></select>
    <select id="selectUserIdsForUpdate" resultType="java.lang.Long"><include refid="users"/> FOR UPDATE</select>
    <sql id="companies">
        SELECT id,code,name FROM system_company WHERE tenant_id=#{query.tenantId} AND deleted=FALSE
        <choose><when test="query.companyIds != null and !query.companyIds.isEmpty()">
            AND id IN <foreach collection="query.companyIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        </when><otherwise>AND 1=0</otherwise></choose> ORDER BY id
    </sql>
    <select id="selectCompanies" resultType="cn.iocoder.yudao.module.system.dal.mysql.permission.UserScopeMigrationMapper$DirectoryReference"><include refid="companies"/></select>
    <select id="selectCompaniesForUpdate" resultType="cn.iocoder.yudao.module.system.dal.mysql.permission.UserScopeMigrationMapper$DirectoryReference"><include refid="companies"/> FOR UPDATE</select>
    <sql id="departments">
        SELECT id,code,name FROM system_dept WHERE tenant_id=#{query.tenantId} AND deleted=FALSE
        <choose><when test="query.departmentIds != null and !query.departmentIds.isEmpty()">
            AND id IN <foreach collection="query.departmentIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        </when><otherwise>AND 1=0</otherwise></choose> ORDER BY id
    </sql>
    <select id="selectDepartments" resultType="cn.iocoder.yudao.module.system.dal.mysql.permission.UserScopeMigrationMapper$DirectoryReference"><include refid="departments"/></select>
    <select id="selectDepartmentsForUpdate" resultType="cn.iocoder.yudao.module.system.dal.mysql.permission.UserScopeMigrationMapper$DirectoryReference"><include refid="departments"/> FOR UPDATE</select>
    <sql id="roles">
        SELECT ur.user_id,r.code FROM system_user_role ur
        INNER JOIN system_role r ON r.id=ur.role_id AND r.tenant_id=ur.tenant_id AND r.deleted=FALSE AND r.status=0
        WHERE ur.tenant_id=#{query.tenantId} AND ur.deleted=FALSE
        <choose><when test="query.userIds != null and !query.userIds.isEmpty()">
            AND ur.user_id IN <foreach collection="query.userIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        </when><otherwise>AND 1=0</otherwise></choose>
        <choose><when test="query.roleCodes != null and !query.roleCodes.isEmpty()">
            AND r.code IN <foreach collection="query.roleCodes" item="code" open="(" separator="," close=")">#{code}</foreach>
        </when><otherwise>AND 1=0</otherwise></choose> ORDER BY ur.user_id,r.id,ur.id
    </sql>
    <select id="selectRoles" resultType="cn.iocoder.yudao.module.system.dal.mysql.permission.UserScopeMigrationMapper$RoleReference"><include refid="roles"/></select>
    <select id="selectRolesForUpdate" resultType="cn.iocoder.yudao.module.system.dal.mysql.permission.UserScopeMigrationMapper$RoleReference"><include refid="roles"/> FOR UPDATE</select>
    <insert id="insertHistoricalRelation">
        INSERT INTO system_user_company_department_scope(id,tenant_id,user_id,company_id,company_code,company_name,
            department_id,department_code,department_name,scope_role,is_primary,effective_from,effective_to,status,
            version,creator,create_time,updater,update_time,deleted)
        VALUES(#{relation.id},#{relation.tenantId},#{relation.userId},#{relation.companyId},#{relation.companyCode},#{relation.companyName},
            #{relation.departmentId},#{relation.departmentCode},#{relation.departmentName},#{relation.scopeRole},#{relation.isPrimary},
            #{relation.effectiveFrom},#{relation.effectiveTo},#{relation.status},#{relation.version},#{audit.creator},
            #{audit.createTime},#{audit.updater},#{audit.updateTime},FALSE)
    </insert>
    <update id="updateHistoricalRelation">
        UPDATE system_user_company_department_scope SET company_name=#{relation.companyName},department_name=#{relation.departmentName},
            is_primary=#{relation.isPrimary},effective_to=#{relation.effectiveTo},status=#{relation.status},
            creator=#{audit.creator},create_time=#{audit.createTime},updater=#{audit.updater},update_time=#{audit.updateTime},version=#{relation.version}
        WHERE id=#{relation.id} AND tenant_id=#{relation.tenantId} AND version=#{expectedVersion} AND deleted=FALSE
    </update>
</mapper>
