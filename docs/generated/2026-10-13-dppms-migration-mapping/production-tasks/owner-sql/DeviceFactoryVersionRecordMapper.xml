<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.asset.dal.mysql.version.DeviceFactoryVersionRecordMapper">
    <select id="selectByIdForUpdate" resultType="cn.iocoder.yudao.module.pms.asset.dal.dataobject.version.DeviceFactoryVersionRecordDO">
        SELECT * FROM ast_device_factory_version_record WHERE tenant_id=#{query.tenantId} AND project_id=#{query.projectId}
          AND id=#{query.id} FOR UPDATE
    </select>
</mapper>
