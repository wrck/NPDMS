  "mapperNodes": [
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P35SoftwareHistorySyncTask$TargetMapper.selectBatches",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P35TargetMapper.xml",
      "xml": "<select id=\"selectBatches\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P35SoftwareHistorySyncTask$BatchRow\">SELECT `id`,`tenant_id`,`project_id`,`change_version`,`change_remark`,`latest`,`creator`,`create_time`,`updater`,`update_time`,`deleted` FROM ast_device_software_change_batch WHERE tenant_id=#{query.tenantId} <choose><when test=\"query.ids != null and !query.ids.isEmpty()\">AND id IN <foreach collection=\"query.ids\" item=\"id\" open=\"(\" close=\")\" separator=\",\">#{id}</foreach></when><otherwise>AND 1=0</otherwise></choose><if test=\"!query.preview\"> FOR UPDATE</if></select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P35SoftwareHistorySyncTask$TargetMapper.insertSoftwareBatch",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P35TargetMapper.xml",
      "xml": "<insert id=\"insertSoftwareBatch\">INSERT INTO ast_device_software_change_batch (`id`,`tenant_id`,`project_id`,`change_version`,`change_remark`,`latest`,`creator`,`create_time`,`updater`,`update_time`,`deleted`) VALUES <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.batch.id},#{row.batch.tenantId},#{row.batch.projectId},#{row.batch.changeVersion},#{row.batch.changeRemark},#{row.batch.latest},#{row.batch.creator},#{row.batch.createTime},#{row.batch.updater},#{row.batch.updateTime},#{row.batch.deleted})</foreach></insert>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P35SoftwareHistorySyncTask$TargetMapper.selectObservations",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P35TargetMapper.xml",
      "xml": "<select id=\"selectObservations\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P35SoftwareHistorySyncTask$ObservationRow\">SELECT `id`,`tenant_id`,`device_id`,`device_sn`,`project_id`,`previous_record_id`,`conp_version`,`conp_type`,`conp_series`,`conp_mark`,`boot_version`,`cpld_version`,`pcb_version`,`customized`,`release_date`,`version_desc`,`recorded_at`,`data_source`,`parsed_fact_id`,`request_key`,`change_batch_id`,`contract_no`,`product_code`,`execute_time`,`data_state`,`custom_info`,`creator`,`create_time`,`updater`,`update_time`,`deleted` FROM ast_device_software_version_record WHERE tenant_id=#{query.tenantId} <choose><when test=\"query.ids != null and !query.ids.isEmpty()\">AND id IN <foreach collection=\"query.ids\" item=\"id\" open=\"(\" close=\")\" separator=\",\">#{id}</foreach></when><otherwise>AND 1=0</otherwise></choose><if test=\"!query.preview\"> FOR UPDATE</if></select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P35SoftwareHistorySyncTask$TargetMapper.insertSoftwareObservation",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P35TargetMapper.xml",
      "xml": "<insert id=\"insertSoftwareObservation\">INSERT INTO ast_device_software_version_record (`id`,`tenant_id`,`device_id`,`device_sn`,`project_id`,`previous_record_id`,`conp_version`,`conp_type`,`conp_series`,`conp_mark`,`boot_version`,`cpld_version`,`pcb_version`,`customized`,`release_date`,`version_desc`,`recorded_at`,`data_source`,`parsed_fact_id`,`request_key`,`change_batch_id`,`contract_no`,`product_code`,`execute_time`,`data_state`,`custom_info`,`creator`,`create_time`,`updater`,`update_time`,`deleted`) VALUES <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.observation.id},#{row.observation.tenantId},#{row.observation.deviceId},#{row.observation.deviceSn},#{row.observation.projectId},#{row.observation.previousRecordId},#{row.observation.conpVersion},#{row.observation.conpType},#{row.observation.conpSeries},#{row.observation.conpMark},#{row.observation.bootVersion},#{row.observation.cpldVersion},#{row.observation.pcbVersion},#{row.observation.customized},#{row.observation.releaseDate},#{row.observation.versionDesc},#{row.observation.recordedAt},#{row.observation.dataSource},#{row.observation.parsedFactId},#{row.observation.requestKey},#{row.observation.changeBatchId},#{row.observation.contractNo},#{row.observation.productCode},#{row.observation.executeTime},#{row.observation.dataState},#{row.observation.customInfo},#{row.observation.creator},#{row.observation.createTime},#{row.observation.updater},#{row.observation.updateTime},#{row.observation.deleted})</foreach></insert>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P35SoftwareHistorySyncTask$SourceMapper.selectSoftwareBatch",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P35SourceMapper.xml",
      "xml": "<select id=\"selectSoftwareBatch\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P35SoftwareHistorySyncTask$Source\">SELECT s.id AS sourceId,s.projectId AS originalProjectId,s.`changeVersion`,s.`changeRemark`,s.`latest`,s.createTime,s.createBy AS source_creator,s.updateTime,s.updateBy AS source_updater FROM pm_project_soft_change_logs s <choose><when test=\"projectKeys != null and !projectKeys.isEmpty()\">WHERE s.projectId IN <foreach collection=\"projectKeys\" item=\"key\" open=\"(\" close=\")\" separator=\",\">#{key}</foreach></when><otherwise>WHERE 1=0</otherwise></choose> ORDER BY s.id LIMIT #{limit}</select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P35SoftwareHistorySyncTask$SourceMapper.selectSoftwareObservation",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P35SourceMapper.xml",
      "xml": "<select id=\"selectSoftwareObservation\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P35SoftwareHistorySyncTask$Source\">SELECT s.id AS sourceId,s.projectId AS originalProjectId,s.`logId`,s.`contractNo`,s.`itemCode`,s.`barCode`,s.`conp`,s.`conpType`,s.`conpSeries`,s.`conpMark`,s.`conpBak`,s.`conpChange`,s.`cpld`,s.`cpldBak`,s.`cpldChange`,s.`boot`,s.`bootBak`,s.`bootChange`,s.`pcb`,s.`pcbBak`,s.`pcbChange`,s.`executeTime`,s.`datastate`,s.`customInfo`,s.createTime,s.createBy AS source_creator,s.updateTime,s.updateBy AS source_updater FROM pm_project_soft_version s <choose><when test=\"projectKeys != null and !projectKeys.isEmpty()\">WHERE s.projectId IN <foreach collection=\"projectKeys\" item=\"key\" open=\"(\" close=\")\" separator=\",\">#{key}</foreach></when><otherwise>WHERE 1=0</otherwise></choose> ORDER BY s.id LIMIT #{limit}</select>\n"
    }
  ]
