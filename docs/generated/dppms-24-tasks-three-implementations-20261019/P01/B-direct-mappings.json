    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectOrganizationMapper.selectDepartments",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectOrganizationMapper.xml",
      "xml": "<select id=\"selectDepartments\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectOrganizationMapper$Node\"><include refid=\"departments\" /></select>\n  "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectOrganizationMapper.lockDepartments",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectOrganizationMapper.xml",
      "xml": "<select id=\"lockDepartments\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectOrganizationMapper$Node\"><include refid=\"departments\" /> FOR UPDATE</select>\n  "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectOrganizationMapper.selectLeaders",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectOrganizationMapper.xml",
      "xml": "<select id=\"selectLeaders\" resultType=\"java.lang.Long\">\n    SELECT id FROM system_users WHERE tenant_id=#{query.tenantId} AND deleted=FALSE\n    <choose><when test=\"query.ids != null and !query.ids.isEmpty()\">\n      AND id IN <foreach collection=\"query.ids\" item=\"id\" open=\"(\" separator=\",\" close=\")\">#{id}</foreach>\n    </when><otherwise>AND 1=0</otherwise></choose>\n  </select>\n  "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectOrganizationMapper.insertCompany",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectOrganizationMapper.xml",
      "xml": "<insert id=\"insertCompany\">\n    INSERT INTO system_company(id,code,name,status,version,creator,create_time,updater,update_time,tenant_id,deleted)\n    VALUES(#{write.node.id},#{write.node.code},#{write.node.name},#{write.node.status},#{write.node.version},\n      #{write.node.creator},#{write.node.createTime},#{write.node.updater},#{write.node.updateTime},#{write.tenantId},FALSE)\n  </insert>\n  "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectOrganizationMapper.insertDepartment",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectOrganizationMapper.xml",
      "xml": "<insert id=\"insertDepartment\">\n    INSERT INTO system_dept(id,code,name,parent_id,sort,leader_user_id,phone,email,status,version,creator,create_time,updater,update_time,tenant_id,deleted)\n    VALUES(#{write.node.id},#{write.node.code},#{write.node.name},#{write.node.parentId},#{write.node.sort},\n      #{write.node.leaderUserId},#{write.node.phone},#{write.node.email},#{write.node.status},#{write.node.version},\n      #{write.node.creator},#{write.node.createTime},#{write.node.updater},#{write.node.updateTime},#{write.tenantId},FALSE)\n  </insert>\n  "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectOrganizationMapper.completeLeader",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectOrganizationMapper.xml",
      "xml": "<update id=\"completeLeader\">\n    UPDATE system_dept SET leader_user_id=#{write.after.leaderUserId},version=#{write.after.version},\n      updater=#{write.after.updater},update_time=#{write.after.updateTime}\n    WHERE tenant_id=#{write.tenantId} AND id=#{write.before.id} AND deleted=FALSE\n      AND version=#{write.before.version} AND leader_user_id IS NULL\n  </update>\n"
    }
  ]
}
