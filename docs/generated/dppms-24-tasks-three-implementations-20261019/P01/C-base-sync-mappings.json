  "mapperNodes": [
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$TargetMapper.selectCompanies",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P01TargetMapper.xml",
      "xml": "<select id=\"selectCompanies\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$Row\">SELECT id,tenant_id,code,name,status,version,creator,create_time,updater,update_time,deleted, 'COMPANY' AS kind FROM system_company WHERE tenant_id=#{query.tenantId} AND deleted=FALSE ORDER BY id<if test=\"!query.preview\"> FOR UPDATE</if></select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$TargetMapper.insertCompanies",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P01TargetMapper.xml",
      "xml": "<insert id=\"insertCompanies\">INSERT INTO system_company (id,tenant_id,code,name,status,version,creator,create_time,updater,update_time,deleted) VALUES <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.target.id},#{row.target.tenantId},#{row.target.code},#{row.target.name},#{row.target.status},#{row.target.version},#{row.target.creator},#{row.target.createTime},#{row.target.updater},#{row.target.updateTime},#{row.target.deleted})</foreach></insert>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$TargetMapper.selectDepartments",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P01TargetMapper.xml",
      "xml": "<select id=\"selectDepartments\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$Row\">SELECT id,tenant_id,code,name,status,version,creator,create_time,updater,update_time,deleted,parent_id,sort,leader_user_id,phone,email, 'DEPARTMENT' AS kind FROM system_dept WHERE tenant_id=#{query.tenantId} AND deleted=FALSE ORDER BY id<if test=\"!query.preview\"> FOR UPDATE</if></select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$TargetMapper.insertDepartments",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P01TargetMapper.xml",
      "xml": "<insert id=\"insertDepartments\">INSERT INTO system_dept (id,tenant_id,code,name,status,version,creator,create_time,updater,update_time,deleted,parent_id,sort,leader_user_id,phone,email) VALUES <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.target.id},#{row.target.tenantId},#{row.target.code},#{row.target.name},#{row.target.status},#{row.target.version},#{row.target.creator},#{row.target.createTime},#{row.target.updater},#{row.target.updateTime},#{row.target.deleted},#{row.target.parentId},#{row.target.sort},#{row.target.leaderUserId},#{row.target.phone},#{row.target.email})</foreach></insert>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$SourceMapper.selectCompanies",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P01SourceMapper.xml",
      "xml": "<select id=\"selectCompanies\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$Company\">SELECT compID AS id,compCode AS code,compName AS name,CAST(isDisabled AS UNSIGNED) AS disabled FROM ehr_company LIMIT #{limit}</select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$SourceMapper.selectDepartments",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P01SourceMapper.xml",
      "xml": "<select id=\"selectDepartments\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$Department\">SELECT depID AS id,depCode AS code,depName AS name,compID AS companyId,adminID AS parentId,depGrade AS grade,director,depProperty AS property,depNum AS number,xOrder AS sortOrder,remark,depCustom1 AS custom1,depCustom3 AS custom3,depCustom5 AS custom5,CAST(isDisabled AS UNSIGNED) AS disabled FROM ehr_department LIMIT #{limit}</select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$SourceMapper.selectFnd",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P01SourceMapper.xml",
      "xml": "<select id=\"selectFnd\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$Fnd\">SELECT id,departmentNum AS code,departmentName AS name,status,createTime,updateTime,effectiveFrom,effectiveTo FROM fnd_department LIMIT #{limit}</select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$SourceMapper.selectCompanyAliases",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P01SourceMapper.xml",
      "xml": "<select id=\"selectCompanyAliases\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P01OrganizationSyncTask$CompanyAlias\">SELECT id,compCode AS code FROM t_company LIMIT #{limit}</select>\n"
    }
