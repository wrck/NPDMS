  "mapperNodes": [
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectProjectEvidenceMapper.selectSource",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectProjectEvidenceMapper.xml",
      "xml": "<select id=\"selectSource\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectProjectSourceRow\">\n    SELECT * FROM proj_legacy_detail_source WHERE tenant_id=#{query.tenantId} AND source_system='DPPMS'\n      AND source_project_key=#{query.sourceProjectKey}\n  </select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectProjectEvidenceMapper.selectSourceForUpdate",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectProjectEvidenceMapper.xml",
      "xml": "<select id=\"selectSourceForUpdate\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectProjectSourceRow\">\n    SELECT * FROM proj_legacy_detail_source WHERE tenant_id=#{query.tenantId} AND source_system='DPPMS'\n      AND source_project_key=#{query.sourceProjectKey} FOR UPDATE\n  </select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectProjectEvidenceMapper.selectRecords",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectProjectEvidenceMapper.xml",
      "xml": "<select id=\"selectRecords\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectProjectRecordRow\">\n    SELECT * FROM proj_legacy_detail_record WHERE <include refid=\"recordScope\" /> ORDER BY source_key,id\n    LIMIT #{query.offset},#{query.limit}\n  </select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectRealProductMapper.selectRecordForUpdate",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectRealProductMapper.xml",
      "xml": "<select id=\"selectRecordForUpdate\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectRealProductRow\">\n        SELECT * FROM proj_project_real_product WHERE tenant_id=#{query.tenantId}\n          AND project_id=#{query.projectId} AND id=#{query.id} FOR UPDATE\n    </select>\n    "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectRealProductMapper.selectBusinessRecordsForUpdate",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectRealProductMapper.xml",
      "xml": "<select id=\"selectBusinessRecordsForUpdate\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectRealProductRow\">\n        SELECT * FROM proj_project_real_product WHERE tenant_id=#{query.tenantId} AND project_id=#{query.projectId}\n          AND CAST(contract_no AS BINARY) &lt;=&gt; CAST(#{query.contractNo} AS BINARY)\n          AND CAST(project_code AS BINARY) &lt;=&gt; CAST(#{query.projectCode} AS BINARY)\n          AND CAST(execution_no AS BINARY) &lt;=&gt; CAST(#{query.executionNo} AS BINARY)\n          AND CAST(product_category_name AS BINARY) &lt;=&gt; CAST(#{query.productCategoryName} AS BINARY)\n          AND CAST(product_name AS BINARY) &lt;=&gt; CAST(#{query.productName} AS BINARY)\n          AND CAST(product_sub_code AS BINARY) &lt;=&gt; CAST(#{query.productSubCode} AS BINARY)\n          AND CAST(product_sub_model AS BINARY) &lt;=&gt; CAST(#{query.productSubModel} AS BINARY)\n          AND CAST(product_sub_name AS BINARY) &lt;=&gt; CAST(#{query.productSubName} AS BINARY)\n          AND quantity &lt;=&gt; #{query.quantity}\n          AND CAST(memo AS BINARY) &lt;=&gt; CAST(#{query.memo} AS BINARY)\n        ORDER BY id FOR UPDATE\n    </select>\n    "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectRealProductMapper.countAllProjectRecords",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectRealProductMapper.xml",
      "xml": "<select id=\"countAllProjectRecords\" resultType=\"java.lang.Long\">\n        SELECT COUNT(*) FROM proj_project_real_product WHERE tenant_id=#{query.tenantId} AND project_id=#{query.projectId}\n    </select>\n    "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectRealProductMapper.insert",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectRealProductMapper.xml",
      "xml": "<insert id=\"insert\">INSERT INTO proj_project_real_product (id,tenant_id,project_id,contract_no,project_code,execution_no,product_category_name,product_name,product_sub_code,product_sub_model,product_sub_name,quantity,memo,data_source,creator,create_time,updater,update_time,deleted) VALUES (#{row.id},#{row.tenantId},#{row.projectId},#{row.contractNo},#{row.projectCode},#{row.executionNo},#{row.productCategoryName},#{row.productName},#{row.productSubCode},#{row.productSubModel},#{row.productSubName},#{row.quantity},#{row.memo},#{row.dataSource},#{row.creator},#{row.createTime},#{row.updater},#{row.updateTime},#{row.deleted})</insert>\n"
    }
  ]
