  "mapperNodes": [
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P25WarrantySyncTask$TargetMapper.selectExisting",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P25TargetMapper.xml",
      "xml": "<select id=\"selectExisting\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P25WarrantySyncTask$WarrantySyncRow\">SELECT `id`, `tenant_id`, `device_sn`, `warranty_contract_no`, `warranty_grade`, `warranty_start_date`, `warranty_end_date`, `warranty_months`, `extended`, `is_latest`, `remark`, `version`, `creator`, `create_time`, `updater`, `update_time`, `deleted` FROM ast_device_warranty_renewal_record\n    WHERE tenant_id=#{query.tenantId}\n    <choose><when test=\"query.ids != null and !query.ids.isEmpty()\">AND id IN\n      <foreach collection=\"query.ids\" item=\"id\" open=\"(\" close=\")\" separator=\",\">#{id}</foreach>\n    </when><otherwise>AND 1=0</otherwise></choose><if test=\"!query.preview\">FOR UPDATE</if>\n  </select>\n  "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P25WarrantySyncTask$TargetMapper.insertWarranty",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P25TargetMapper.xml",
      "xml": "<insert id=\"insertWarranty\">INSERT INTO ast_device_warranty_renewal_record (`id`, `tenant_id`, `device_sn`, `warranty_contract_no`, `warranty_grade`, `warranty_start_date`, `warranty_end_date`, `warranty_months`, `extended`, `is_latest`, `remark`, `version`, `creator`, `create_time`, `updater`, `update_time`, `deleted`) VALUES\n    <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.target.id}, #{row.target.tenantId}, #{row.target.deviceSn}, #{row.target.warrantyContractNo}, #{row.target.warrantyGrade}, #{row.target.warrantyStartDate}, #{row.target.warrantyEndDate}, #{row.target.warrantyMonths}, #{row.target.extended}, #{row.target.isLatest}, #{row.target.remark}, #{row.target.version}, #{row.target.creator}, #{row.target.createTime}, #{row.target.updater}, #{row.target.updateTime}, #{row.target.deleted})</foreach>\n  </insert>\n  "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P25WarrantySyncTask$TargetMapper.updateWarranty",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P25TargetMapper.xml",
      "xml": "<update id=\"updateWarranty\">UPDATE ast_device_warranty_renewal_record SET `device_sn`=#{row.target.deviceSn}, `warranty_contract_no`=#{row.target.warrantyContractNo}, `warranty_grade`=#{row.target.warrantyGrade}, `warranty_start_date`=#{row.target.warrantyStartDate}, `warranty_end_date`=#{row.target.warrantyEndDate}, `warranty_months`=#{row.target.warrantyMonths}, `extended`=#{row.target.extended}, `is_latest`=#{row.target.isLatest}, `remark`=#{row.target.remark}, `version`=#{row.target.version}, `updater`=#{row.target.updater}, `update_time`=#{row.target.updateTime} WHERE tenant_id=#{row.target.tenantId} AND id=#{row.target.id} AND version=#{row.expectedVersion} AND deleted=FALSE</update>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P25WarrantySyncTask$SourceMapper.selectDuplicateIdentity",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P25SourceMapper.xml",
      "xml": "<select id=\"selectDuplicateIdentity\" resultType=\"java.lang.Integer\">\n    SELECT 1 FROM fb_service GROUP BY BINARY id,BINARY COALESCE(barcode,'') HAVING COUNT(*)&gt;1 LIMIT 1\n  </select>\n  "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P25WarrantySyncTask$SourceMapper.selectWarranty",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P25SourceMapper.xml",
      "xml": "<select id=\"selectWarranty\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P25WarrantySyncTask$WarrantySyncSource\">\n    SELECT `id` AS `source_id`, `con_xb` AS `warranty_contract_no`, `barcode` AS `device_sn`, `grade` AS `warranty_grade`, `begin_date` AS `warranty_start_date`, `end_date` AS `warranty_end_date`, `warranty` AS `warranty_years`, `remark` AS `remark`, `isyb` AS `extended`, `state` AS `is_latest` FROM fb_service LIMIT #{limit}\n  </select>\n"
    }
  ]
