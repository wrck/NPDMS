    "sourceSql": "SELECT CAST(JSON_ARRAY(CASE r.compCode WHEN '01' THEN '001' WHEN '02' THEN '002' WHEN '03' THEN '003' WHEN '04' THEN '004' ELSE r.compCode END,r.contractNo) AS CHAR) AS raw_key,\n CASE r.compCode WHEN '01' THEN '001' WHEN '02' THEN '002' WHEN '03' THEN '003' WHEN '04' THEN '004' ELSE r.compCode END AS company_code,r.contractNo AS contract_no,r.customerName AS customer_name,r.orderType AS order_type,r.orderNumber AS order_no,\n CASE WHEN r.customerCode IS NULL OR r.customerCode='' THEN r.customerCode\n WHEN r.customerCode REGEXP '^[A-Za-z]' AND CHAR_LENGTH(TRIM(LEADING '0' FROM SUBSTRING(r.customerCode,2)))<=5\n THEN CONCAT(LEFT(r.customerCode,1),LPAD(TRIM(LEADING '0' FROM SUBSTRING(r.customerCode,2)),5,'0')) ELSE NULL END AS customer_code,\n CASE WHEN r.customerCode IS NOT NULL AND r.customerCode<>'' AND (NOT(r.customerCode REGEXP '^[A-Za-z]') OR CHAR_LENGTH(TRIM(LEADING '0' FROM SUBSTRING(r.customerCode,2)))>5) THEN 'ERP_CUSTOMER_CODE_FORMAT_INVALID' ELSE NULL END AS issue\nFROM pm_order_data_from_erp r WHERE r.source IN ('SAP','D365','SMS') AND r.compCode IS NOT NULL AND r.compCode<>'' AND r.contractNo IS NOT NULL AND r.contractNo<>''\nORDER BY r.id LIMIT 5000001",
