      "xml": "<update id=\"updateMapping\">UPDATE cus_customer_external_mapping SET source_version=#{row.mapping.sourceVersion},updater=#{row.mapping.updater},update_time=#{row.mapping.updateTime} WHERE tenant_id=#{row.mapping.tenantId} AND id=#{row.mapping.id} AND customer_id=#{row.mapping.customerId} AND source_key=#{row.mapping.sourceKey} AND source_system='CRM' AND source_version=#{row.expectedSourceVersion} AND effective_to IS NULL AND deleted=FALSE</update>\n"
