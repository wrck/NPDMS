    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P10CrmCustomerSyncTask$SourceMapper.selectCustomer",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P10SourceMapper.xml",
      "xml": "<select id=\"selectCustomer\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P10CrmCustomerSyncTask$CustomerSource\">SELECT TOP (#{limit}) CONVERT(varchar(128),[AccountId]) AS [source_key],\nLTRIM(RTRIM([AccountNumber])) AS [code],\nLTRIM(RTRIM([erpCustomerCode])) AS [erp_customer_code],\nLTRIM(RTRIM([Name])) AS [name],\nLTRIM(RTRIM([Telephone1])) AS [contact_phone],\nLTRIM(RTRIM([EMailAddress1])) AS [contact_email],\nLTRIM(RTRIM([Address1_Composite])) AS [address],\nCONVERT(varchar(128),[new_mkt_unit_id]) AS [department_code],\nLTRIM(RTRIM([new_mkt_unit_idName])) AS [department_name],\nCONVERT(varchar(128),[new_industry_level1_id]) AS [market_code],\nLTRIM(RTRIM([new_industry_level1_idName])) AS [market_name],\nCONVERT(varchar(128),[new_industry_level2_id]) AS [system_code],\nLTRIM(RTRIM([new_industry_level2_idName])) AS [system_name],\nCONVERT(varchar(128),[new_industry_level3_id]) AS [expend_code],\nLTRIM(RTRIM([new_industry_level3_idName])) AS [expend_name],\nCONVERT(varchar(128),[new_industry_level4_id]) AS [industry_code],\nLTRIM(RTRIM([new_industry_level4_idName])) AS [industry_name],\nCASE StateCode WHEN 0 THEN 'ENABLED' WHEN 1 THEN 'DISABLED' ELSE NULL END AS lifecycle_status, CONVERT(varchar(33),ModifiedOn,126) AS source_version, ModifiedOn AS data_as_of, CASE WHEN Name IS NULL OR LTRIM(RTRIM(Name))='' THEN 'MISSING_CUSTOMER_NAME' WHEN LEN(Name)&gt;128 THEN 'CUSTOMER_NAME_TOO_LONG' WHEN COUNT(*) OVER (PARTITION BY LTRIM(RTRIM(AccountNumber)))&gt;1 THEN 'DUPLICATE_CUSTOMER_CODE' ELSE NULL END AS migration_issue FROM DPtech_v_account ORDER BY AccountId</select>\n"
    }
