    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P10CrmCustomerSyncTask$TargetMapper.erpColumnReady",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P10TargetMapper.xml",
      "xml": "<select id=\"erpColumnReady\" resultType=\"java.lang.Integer\">SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='cus_customer_master' AND column_name='erp_customer_code'</select>\n"
