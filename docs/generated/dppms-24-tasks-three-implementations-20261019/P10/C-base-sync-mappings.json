      "xml": "<update id=\"updateCustomer\">UPDATE cus_customer_master SET `code`=#{row.target.code},`erp_customer_code`=#{row.target.erpCustomerCode},`name`=#{row.target.name},`short_name`=#{row.target.shortName},`contact_phone`=#{row.target.contactPhone},`contact_email`=#{row.target.contactEmail},`address`=#{row.target.address},`department_code`=#{row.target.departmentCode},`department_name`=#{row.target.departmentName},`market_code`=#{row.target.marketCode},`market_name`=#{row.target.marketName},`system_code`=#{row.target.systemCode},`system_name`=#{row.target.systemName},`expend_code`=#{row.target.expendCode},`expend_name`=#{row.target.expendName},`industry_code`=#{row.target.industryCode},`industry_name`=#{row.target.industryName},`lifecycle_status`=#{row.target.lifecycleStatus},`source_key`=#{row.target.sourceKey},`source_version`=#{row.target.sourceVersion},`data_as_of`=#{row.target.dataAsOf},`version`=#{row.target.version},`updater`=#{row.target.updater},`update_time`=#{row.target.updateTime} WHERE tenant_id=#{row.target.tenantId} AND id=#{row.target.id} AND version=#{row.expectedVersion} AND deleted=FALSE</update>\n"
