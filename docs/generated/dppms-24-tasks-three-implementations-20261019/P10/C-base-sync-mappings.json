    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P10CrmCustomerSyncTask$TargetMapper.selectMappings",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P10TargetMapper.xml",
      "xml": "<select id=\"selectMappings\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P10CrmCustomerSyncTask$CustomerMapping\">SELECT id,tenant_id,customer_id,source_system,source_key,source_version,creator,updater,effective_from,effective_to,create_time,update_time,deleted FROM cus_customer_external_mapping WHERE tenant_id=#{query.tenantId} AND source_system='CRM' AND deleted=FALSE AND effective_to IS NULL <choose><when test=\"query.keys != null and !query.keys.isEmpty()\">AND source_key IN <foreach collection=\"query.keys\" item=\"key\" open=\"(\" close=\")\" separator=\",\">#{key}</foreach></when><otherwise>AND 1=0</otherwise></choose><if test=\"!query.preview\">FOR UPDATE</if></select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P10CrmCustomerSyncTask$TargetMapper.selectCustomers",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P10TargetMapper.xml",
      "xml": "<select id=\"selectCustomers\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P10CrmCustomerSyncTask$CustomerRow\">SELECT id,tenant_id,version,code,erp_customer_code,name,short_name,customer_level,lifecycle_status,source_type,source_key,source_version,sync_status,temporary_reason,contact_phone,contact_email,department_code,department_name,market_code,market_name,system_code,system_name,expend_code,expend_name,industry_code,industry_name,address,remark,creator,updater,data_as_of,create_time,update_time,reconciliation_pending,deleted FROM cus_customer_master WHERE tenant_id=#{query.tenantId} AND (1=0 <if test=\"query.ids != null and !query.ids.isEmpty()\">OR id IN <foreach collection=\"query.ids\" item=\"id\" open=\"(\" close=\")\" separator=\",\">#{id}</foreach></if><if test=\"query.codes != null and !query.codes.isEmpty()\">OR code IN <foreach collection=\"query.codes\" item=\"code\" open=\"(\" close=\")\" separator=\",\">#{code}</foreach></if>)<if test=\"!query.preview\">FOR UPDATE</if></select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P10CrmCustomerSyncTask$TargetMapper.insertCustomer",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P10TargetMapper.xml",
      "xml": "<insert id=\"insertCustomer\">INSERT INTO cus_customer_master (`id`,`tenant_id`,`version`,`code`,`erp_customer_code`,`name`,`short_name`,`customer_level`,`lifecycle_status`,`source_type`,`source_key`,`source_version`,`sync_status`,`temporary_reason`,`contact_phone`,`contact_email`,`department_code`,`department_name`,`market_code`,`market_name`,`system_code`,`system_name`,`expend_code`,`expend_name`,`industry_code`,`industry_name`,`address`,`remark`,`creator`,`updater`,`data_as_of`,`create_time`,`update_time`,`reconciliation_pending`,`deleted`) VALUES <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.target.id},#{row.target.tenantId},#{row.target.version},#{row.target.code},#{row.target.erpCustomerCode},#{row.target.name},#{row.target.shortName},#{row.target.customerLevel},#{row.target.lifecycleStatus},#{row.target.sourceType},#{row.target.sourceKey},#{row.target.sourceVersion},#{row.target.syncStatus},#{row.target.temporaryReason},#{row.target.contactPhone},#{row.target.contactEmail},#{row.target.departmentCode},#{row.target.departmentName},#{row.target.marketCode},#{row.target.marketName},#{row.target.systemCode},#{row.target.systemName},#{row.target.expendCode},#{row.target.expendName},#{row.target.industryCode},#{row.target.industryName},#{row.target.address},#{row.target.remark},#{row.target.creator},#{row.target.updater},#{row.target.dataAsOf},#{row.target.createTime},#{row.target.updateTime},#{row.target.reconciliationPending},#{row.target.deleted})</foreach></insert>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P10CrmCustomerSyncTask$TargetMapper.insertMappings",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P10TargetMapper.xml",
      "xml": "<insert id=\"insertMappings\">INSERT INTO cus_customer_external_mapping (`id`,`tenant_id`,`customer_id`,`source_system`,`source_key`,`source_version`,`creator`,`updater`,`effective_from`,`effective_to`,`create_time`,`update_time`,`deleted`) VALUES <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.mapping.id},#{row.mapping.tenantId},#{row.mapping.customerId},#{row.mapping.sourceSystem},#{row.mapping.sourceKey},#{row.mapping.sourceVersion},#{row.mapping.creator},#{row.mapping.updater},#{row.mapping.effectiveFrom},#{row.mapping.effectiveTo},#{row.mapping.createTime},#{row.mapping.updateTime},#{row.mapping.deleted})</foreach></insert>\n"
