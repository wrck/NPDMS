  "mapperNodes": [
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P30DeviceBaseSyncTask$TargetMapper.selectDeviceBase",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P30TargetMapper.xml",
      "xml": "<select id=\"selectDeviceBase\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P30DeviceBaseSyncTask$DeviceSource\">SELECT MIN(device_sn) AS device_sn FROM ast_device_shipment WHERE tenant_id=#{tenantId} AND deleted=FALSE AND source_system='DPPMS' GROUP BY CAST(device_sn AS BINARY) ORDER BY CAST(device_sn AS BINARY) LIMIT #{limit}</select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P30DeviceBaseSyncTask$TargetMapper.selectLatestShipments",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P30TargetMapper.xml",
      "xml": "<select id=\"selectLatestShipments\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P30DeviceBaseSyncTask$Shipment\">SELECT id,tenant_id,device_sn,source_system,source_key,contract_no,package_no,shipment_time,product_code FROM (SELECT s.*,ROW_NUMBER() OVER(PARTITION BY CAST(device_sn AS BINARY) ORDER BY shipment_time DESC,id DESC) latest_rank FROM ast_device_shipment s WHERE tenant_id=#{query.tenantId} AND deleted=FALSE <choose><when test=\"query.serials != null and !query.serials.isEmpty()\">AND device_sn IN <foreach collection=\"query.serials\" item=\"sn\" open=\"(\" close=\")\" separator=\",\">#{sn}</foreach></when><otherwise>AND 1=0</otherwise></choose>) ranked WHERE latest_rank=1</select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P30DeviceBaseSyncTask$TargetMapper.selectProducts",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P30TargetMapper.xml",
      "xml": "<select id=\"selectProducts\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P30DeviceBaseSyncTask$Product\">SELECT product_code,product_model,product_name FROM ast_product_official_info WHERE tenant_id=#{query.tenantId} AND deleted=FALSE</select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P30DeviceBaseSyncTask$TargetMapper.selectExisting",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P30TargetMapper.xml",
      "xml": "<select id=\"selectExisting\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P30DeviceBaseSyncTask$DeviceRow\">SELECT `id`,`tenant_id`,`version`,`shipment_record_id`,`project_assignment_version`,`customer_assignment_version`,`sn`,`name`,`product_name`,`product_model`,`product_code`,`package_no`,`contract_no`,`status`,`source_system`,`source_key`,`source_version`,`sync_status`,`remark`,`creator`,`updater`,`shipment_time`,`synced_at`,`create_time`,`update_time`,`deleted` FROM ast_device WHERE tenant_id=#{query.tenantId} <choose><when test=\"query.serials != null and !query.serials.isEmpty()\">AND sn IN <foreach collection=\"query.serials\" item=\"sn\" open=\"(\" close=\")\" separator=\",\">#{sn}</foreach></when><otherwise>AND 1=0</otherwise></choose><if test=\"!query.preview\">FOR UPDATE</if></select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P30DeviceBaseSyncTask$TargetMapper.insertDeviceBase",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P30TargetMapper.xml",
      "xml": "<insert id=\"insertDeviceBase\">INSERT INTO ast_device (`id`,`tenant_id`,`version`,`shipment_record_id`,`project_assignment_version`,`customer_assignment_version`,`sn`,`name`,`product_name`,`product_model`,`product_code`,`package_no`,`contract_no`,`status`,`source_system`,`source_key`,`source_version`,`sync_status`,`remark`,`creator`,`updater`,`shipment_time`,`synced_at`,`create_time`,`update_time`,`deleted`) VALUES <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.target.id},#{row.target.tenantId},#{row.target.version},#{row.target.shipmentRecordId},#{row.target.projectAssignmentVersion},#{row.target.customerAssignmentVersion},#{row.target.sn},#{row.target.name},#{row.target.productName},#{row.target.productModel},#{row.target.productCode},#{row.target.packageNo},#{row.target.contractNo},#{row.target.status},#{row.target.sourceSystem},#{row.target.sourceKey},#{row.target.sourceVersion},#{row.target.syncStatus},#{row.target.remark},#{row.target.creator},#{row.target.updater},#{row.target.shipmentTime},#{row.target.syncedAt},#{row.target.createTime},#{row.target.updateTime},#{row.target.deleted})</foreach></insert>\n"
    }
  ]
