  "mapperNodes": [
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectDeviceBaseMapper.selectLatestShipments",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectDeviceBaseMapper.xml",
      "xml": "<select id=\"selectLatestShipments\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectBootstrapShipmentRow\">\n    SELECT ranked.* FROM (\n      SELECT s.*,ROW_NUMBER() OVER(PARTITION BY CAST(device_sn AS BINARY) ORDER BY shipment_time DESC,id DESC) AS latest_rank\n      FROM ast_device_shipment s WHERE tenant_id=#{query.tenantId} AND deleted=0\n      <choose>\n        <when test=\"query.deviceSns != null and !query.deviceSns.isEmpty()\">\n          AND device_sn IN <foreach collection=\"query.deviceSns\" item=\"sn\" open=\"(\" separator=\",\" close=\")\">#{sn}</foreach>\n        </when>\n        <otherwise>AND 1=0</otherwise>\n      </choose>\n    ) ranked WHERE latest_rank=1\n  </select>\n    "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectDeviceBaseMapper.selectIdentityForUpdate",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectDeviceBaseMapper.xml",
      "xml": "<select id=\"selectIdentityForUpdate\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectDeviceBaseRow\">\n        SELECT * FROM ast_device WHERE tenant_id=#{query.tenantId} AND sn=#{query.deviceSn} FOR UPDATE\n    </select>\n    "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectDeviceBaseMapper.selectShipmentProducts",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectDeviceBaseMapper.xml",
      "xml": "<select id=\"selectShipmentProducts\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectProductRow\">\n        SELECT id,tenant_id,product_code,product_name,product_model FROM ast_product_official_info WHERE tenant_id=#{query.tenantId} AND deleted=0\n        <choose><when test=\"query.productCodes != null and !query.productCodes.isEmpty()\">AND product_code IN\n        <foreach collection=\"query.productCodes\" item=\"code\" open=\"(\" separator=\",\" close=\")\">#{code}</foreach></when><otherwise>AND 1=0</otherwise></choose>\n    </select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectDeviceBaseMapper.insert",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectDeviceBaseMapper.xml",
      "xml": "<insert id=\"insert\">INSERT INTO ast_device (id,tenant_id,version,sn,name,product_name,product_model,product_code,package_no,contract_no,status,source_system,source_key,source_version,sync_status,remark,shipment_time,synced_at,shipment_record_id,project_assignment_version,customer_assignment_version,creator,create_time,updater,update_time,deleted) VALUES (#{row.id},#{row.tenantId},#{row.version},#{row.sn},#{row.name},#{row.productName},#{row.productModel},#{row.productCode},#{row.packageNo},#{row.contractNo},#{row.status},#{row.sourceSystem},#{row.sourceKey},#{row.sourceVersion},#{row.syncStatus},#{row.remark},#{row.shipmentTime},#{row.syncedAt},#{row.shipmentRecordId},#{row.projectAssignmentVersion},#{row.customerAssignmentVersion},#{row.creator},#{row.createTime},#{row.updater},#{row.updateTime},#{row.deleted})</insert>\n"
    }
  ]
