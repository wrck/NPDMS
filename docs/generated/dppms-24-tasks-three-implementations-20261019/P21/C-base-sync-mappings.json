      "xml": "<select id=\"nullableColumns\" resultType=\"java.lang.Integer\">SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND (table_name='proj_project_lease_product' OR table_name='proj_project_product_configuration') AND column_name='project_id' AND is_nullable='YES'</select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P21ProjectCacheSyncTask$SourceMapper.selectLease",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P21SourceMapper.xml",
      "xml": "<select id=\"selectLease\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P21ProjectCacheSyncTask$LeaseCacheSource\">\n    SELECT `projectCode` AS `project_code`, `orderExecNumber` AS `execution_no`, `productFirstName` AS `product_category`, `productName` AS `product_type`, `productSubCode` AS `product_code`, `productSubModel` AS `product_model`, `productSubName` AS `product_name`, `num` AS `quantity`, `memo` AS `memo`, `leaseDuration` AS `lease_duration`, `dataSource` AS `data_source` FROM `pm_project_product_lease_line_from_crm` LIMIT #{limit}\n  </select>\n  "
    },
