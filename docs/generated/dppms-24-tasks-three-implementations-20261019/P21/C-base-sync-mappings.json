    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P21ProjectCacheSyncTask$TargetMapper.insertConfiguration",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P21TargetMapper.xml",
      "xml": "<insert id=\"insertConfiguration\">INSERT INTO proj_project_product_configuration (`id`, `tenant_id`, `project_code`, `execution_no`, `item_group`, `product_code`, `parent_code`, `quantity`, `bom_path`, `product_model`, `product_description`, `level`, `data_source`, `creator`, `create_time`, `updater`, `update_time`, `deleted`) VALUES\n    <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.id}, #{row.tenantId}, #{row.projectCode}, #{row.executionNo}, #{row.itemGroup}, #{row.productCode}, #{row.parentCode}, #{row.quantity}, #{row.bomPath}, #{row.productModel}, #{row.productDescription}, #{row.level}, #{row.dataSource}, #{row.creator}, #{row.createTime}, #{row.updater}, #{row.updateTime}, #{row.deleted})</foreach>\n  </insert>\n  "
