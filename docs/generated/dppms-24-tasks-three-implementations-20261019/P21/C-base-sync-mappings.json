      "source": "pms-module-integration/src/main/resources/mapper/basesync/P21TargetMapper.xml",
      "xml": "<insert id=\"insertLease\">INSERT INTO proj_project_lease_product (`id`, `tenant_id`, `project_code`, `execution_no`, `product_category`, `product_type`, `product_code`, `product_model`, `product_name`, `quantity`, `memo`, `lease_duration`, `data_source`, `creator`, `create_time`, `updater`, `update_time`, `deleted`) VALUES\n    <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.id}, #{row.tenantId}, #{row.projectCode}, #{row.executionNo}, #{row.productCategory}, #{row.productType}, #{row.productCode}, #{row.productModel}, #{row.productName}, #{row.quantity}, #{row.memo}, #{row.leaseDuration}, #{row.dataSource}, #{row.creator}, #{row.createTime}, #{row.updater}, #{row.updateTime}, #{row.deleted})</foreach>\n  </insert>\n  "
    },
