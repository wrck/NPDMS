      "source": "pms-module-integration/src/main/resources/mapper/basesync/P23TargetMapper.xml",
      "xml": "<insert id=\"insertCollectionPlan\">INSERT INTO com_contract_collection_plan (`id`, `tenant_id`, `contract_no`, `batch_code`, `collection_item_name`, `reference_event_name`, `event_planned_at`, `after_days`, `event_actual_finished_at`, `marketing_feedback`, `creator`, `create_time`, `updater`, `update_time`, `effective_from`, `effective_to`, `data_source`, `deleted`) VALUES\n    <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.target.id}, #{row.target.tenantId}, #{row.target.contractNo}, #{row.target.batchCode}, #{row.target.collectionItemName}, #{row.target.referenceEventName}, #{row.target.eventPlannedAt}, #{row.target.afterDays}, #{row.target.eventActualFinishedAt}, #{row.target.marketingFeedback}, #{row.target.creator}, #{row.target.createTime}, #{row.target.updater}, #{row.target.updateTime}, #{row.target.effectiveFrom}, #{row.target.effectiveTo}, #{row.target.dataSource}, #{row.target.deleted})</foreach>\n  </insert>\n  "
    },
    {
