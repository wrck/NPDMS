      "source": "pms-module-integration/src/main/resources/mapper/basesync/P23TargetMapper.xml",
      "xml": "<select id=\"nullableColumns\" resultType=\"java.lang.String\">SELECT column_name FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='com_contract_collection_plan' AND column_name IN ('create_time','update_time') AND is_nullable='YES'</select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P23CollectionPlanSyncTask$SourceMapper.selectCollectionPlan",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P23SourceMapper.xml",
      "xml": "<select id=\"selectCollectionPlan\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P23CollectionPlanSyncTask$CollectionPlanCacheSource\">\n    SELECT `contractNo` AS `contract_no`, `batchCode` AS `batch_code`, `basicDataName` AS `collection_item_name`, `referenceEventName` AS `reference_event_name`, `eventPlanHappenDate` AS `event_planned_at`, `afterDaysNum` AS `after_days`, `eventActualFinishDate` AS `event_actual_finished_at`, `marketingFeedback` AS `marketing_feedback`, `createBy` AS `creator`, `createTime` AS `create_time`, `updateBy` AS `updater`, `updateTime` AS `update_time`, `effectiveFrom` AS `effective_from`, `effectiveTo` AS `effective_to`, `dataSource` AS `data_source` FROM `pm_pb_plan_from_sms` LIMIT #{limit}\n  </select>\n"
