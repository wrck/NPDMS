  "mapperNodes": [
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.SyncRunMapper.selectMaintenance",
      "source": "pms-module-integration/src/main/resources/mapper/sync/SyncRunMapper.xml",
      "xml": "<select id=\"selectMaintenance\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.dataobject.sync.SyncRunDO\">\n    SELECT id, status, config_snapshot FROM int_sync_run WHERE tenant_id=#{tenantId} AND deleted=FALSE\n      AND (cache_pending=TRUE OR (status IN ('QUEUED','READING','VALIDATING','APPLYING') AND started_at &lt; #{now}))\n      ORDER BY id LIMIT 100\n  </select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.system.dal.mysql.dict.DictionaryDataMigrationMapper.selectConflictingValuesForUpdate",
      "source": "yudao-module-system/src/main/resources/mapper/dict/DictionaryDataMigrationMapper.xml",
      "xml": "<select id=\"selectConflictingValuesForUpdate\" resultType=\"cn.iocoder.yudao.module.system.api.migration.SystemDictionaryDataMigrationApi$Item\">\n        SELECT id,sort,label,value,dict_type,status,color_type,css_class,remark,creator,create_time,updater,update_time,deleted\n        FROM system_dict_data\n        WHERE (deleted=b'0' AND dict_type=#{query.dictType} AND value=#{query.value})\n        <if test=\"query.targetId != null\">OR id=#{query.targetId}</if>\n        ORDER BY id FOR UPDATE\n    </select>\n    "
    },
    {
      "statement": "cn.iocoder.yudao.module.system.dal.mysql.dict.DictionaryDataMigrationMapper.selectTypesForUpdate",
      "source": "yudao-module-system/src/main/resources/mapper/dict/DictionaryDataMigrationMapper.xml",
      "xml": "<select id=\"selectTypesForUpdate\" resultType=\"cn.iocoder.yudao.module.system.api.migration.SystemDictionaryTypeMigrationApi$Type\">\n        SELECT id,name,type,status,remark,creator,create_time,updater,update_time,deleted,deleted_time\n        FROM system_dict_type WHERE type=#{query.type} AND deleted=b'0' ORDER BY id FOR UPDATE\n    </select>\n    "
    },
    {
      "statement": "cn.iocoder.yudao.module.system.dal.mysql.dict.DictionaryDataMigrationMapper.insertHistorical",
      "source": "yudao-module-system/src/main/resources/mapper/dict/DictionaryDataMigrationMapper.xml",
      "xml": "<insert id=\"insertHistorical\">\n        INSERT INTO system_dict_data\n            (id,sort,label,value,dict_type,status,color_type,css_class,remark,creator,create_time,updater,update_time,deleted)\n        VALUES (#{command.row.id},#{command.row.sort},#{command.row.label},#{command.row.value},#{command.row.dictType},\n            #{command.row.status},#{command.row.colorType},#{command.row.cssClass},#{command.row.remark},#{command.row.creator},\n            #{command.row.createTime},#{command.row.updater},#{command.row.updateTime},#{command.row.deleted})\n    </insert>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.system.dal.mysql.dict.DictionaryTypeMigrationMapper.selectConflictingDefinitionsForUpdate",
      "source": "yudao-module-system/src/main/resources/mapper/dict/DictionaryTypeMigrationMapper.xml",
      "xml": "<select id=\"selectConflictingDefinitionsForUpdate\" resultType=\"cn.iocoder.yudao.module.system.api.migration.SystemDictionaryTypeMigrationApi$Type\">\n        SELECT id,name,type,status,remark,creator,create_time,updater,update_time,deleted,deleted_time\n        FROM system_dict_type\n        WHERE (deleted=b'0' AND (type=#{query.type} OR name=#{query.name}))\n        <if test=\"query.targetId != null\">OR id=#{query.targetId}</if>\n        ORDER BY id FOR UPDATE\n    </select>\n    "
    },
    {
      "statement": "cn.iocoder.yudao.module.system.dal.mysql.dict.DictionaryTypeMigrationMapper.insertHistorical",
      "source": "yudao-module-system/src/main/resources/mapper/dict/DictionaryTypeMigrationMapper.xml",
      "xml": "<insert id=\"insertHistorical\">\n        INSERT INTO system_dict_type\n            (id,name,type,status,remark,creator,create_time,updater,update_time,deleted,deleted_time)\n        VALUES (#{command.row.id},#{command.row.name},#{command.row.type},#{command.row.status},#{command.row.remark},\n            #{command.row.creator},#{command.row.createTime},#{command.row.updater},#{command.row.updateTime},\n            #{command.row.deleted},#{command.row.deletedTime})\n    </insert>\n"
    }
  ]
}
