    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P08DictionarySyncTask$TargetMapper.selectTypes",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P08TargetMapper.xml",
      "xml": "<select id=\"selectTypes\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P08DictionarySyncTask$DictionaryTarget\">SELECT `id`,`name`,`type`,`status`,`remark`,`creator`,`create_time`,`updater`,`update_time`,`deleted`,`deleted_time` FROM system_dict_type WHERE (deleted=FALSE AND (1=0 <if test=\"query.codes != null and !query.codes.isEmpty()\">OR `type` IN <foreach collection=\"query.codes\" item=\"code\" open=\"(\" close=\")\" separator=\",\">#{code}</foreach></if><if test=\"query.names != null and !query.names.isEmpty()\">OR name IN <foreach collection=\"query.names\" item=\"name\" open=\"(\" close=\")\" separator=\",\">#{name}</foreach></if>)) <if test=\"query.ids != null and !query.ids.isEmpty()\">OR id IN <foreach collection=\"query.ids\" item=\"id\" open=\"(\" close=\")\" separator=\",\">#{id}</foreach></if> ORDER BY id <if test=\"!query.preview\">FOR UPDATE</if></select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P08DictionarySyncTask$TargetMapper.selectItems",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P08TargetMapper.xml",
      "xml": "<select id=\"selectItems\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P08DictionarySyncTask$DictionaryTarget\">SELECT `id`,`sort`,`label`,`value`,`dict_type`,`status`,`color_type`,`css_class`,`remark`,`creator`,`create_time`,`updater`,`update_time`,`deleted` FROM system_dict_data WHERE (deleted=FALSE AND (1=0 <if test=\"query.codes != null and !query.codes.isEmpty()\">OR `dict_type` IN <foreach collection=\"query.codes\" item=\"code\" open=\"(\" close=\")\" separator=\",\">#{code}</foreach></if>)) <if test=\"query.ids != null and !query.ids.isEmpty()\">OR id IN <foreach collection=\"query.ids\" item=\"id\" open=\"(\" close=\")\" separator=\",\">#{id}</foreach></if> ORDER BY id <if test=\"!query.preview\">FOR UPDATE</if></select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P08DictionarySyncTask$TargetMapper.insertDictionaryType",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P08TargetMapper.xml",
      "xml": "<insert id=\"insertDictionaryType\">INSERT INTO system_dict_type (`id`,`name`,`type`,`status`,`remark`,`creator`,`create_time`,`updater`,`update_time`,`deleted`,`deleted_time`) VALUES <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.target.id},#{row.target.name},#{row.target.type},#{row.target.status},#{row.target.remark},#{row.target.creator},#{row.target.createTime},#{row.target.updater},#{row.target.updateTime},#{row.target.deleted},#{row.target.deletedTime})</foreach></insert>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P08DictionarySyncTask$TargetMapper.insertDictionaryItem",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P08TargetMapper.xml",
      "xml": "<insert id=\"insertDictionaryItem\">INSERT INTO system_dict_data (`id`,`sort`,`label`,`value`,`dict_type`,`status`,`color_type`,`css_class`,`remark`,`creator`,`create_time`,`updater`,`update_time`,`deleted`) VALUES <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.target.id},#{row.target.sort},#{row.target.label},#{row.target.value},#{row.target.dictType},#{row.target.status},#{row.target.colorType},#{row.target.cssClass},#{row.target.remark},#{row.target.creator},#{row.target.createTime},#{row.target.updater},#{row.target.updateTime},#{row.target.deleted})</foreach></insert>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P08DictionarySyncTask$SourceMapper.selectDictionaryType",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P08SourceMapper.xml",
      "xml": "<select id=\"selectDictionaryType\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P08DictionarySyncTask$DictionarySource\">SELECT id AS raw_id,dataTypeCode AS data_type_code,dataTypeName AS data_type_name,status AS raw_status,createTime AS create_time,createBy AS raw_creator,updateTime AS update_time,updateBy AS raw_updater,effectiveFrom AS effective_from,effectiveTo AS effective_to,0 AS definition_missing,1 AS dictionary_type FROM fnd_basic_data_type LIMIT #{limit}</select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P08DictionarySyncTask$SourceMapper.selectDictionaryItem",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P08SourceMapper.xml",
      "xml": "<select id=\"selectDictionaryItem\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P08DictionarySyncTask$DictionarySource\">SELECT id AS raw_id,dataTypeCode AS data_type_code,basicDataId AS basic_data_id,basicDataName AS basic_data_name,basicDataAttri1 AS basic_data_attri1,sortId AS sort_id,createTime AS create_time,createBy AS raw_creator,updateTime AS update_time,updateBy AS raw_updater,effectiveFrom AS effective_from,effectiveTo AS effective_to FROM fnd_basic_data ORDER BY id LIMIT #{limit}</select>\n"
