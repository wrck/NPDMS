      "xml": "<select id=\"selectExisting\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P37LicenseHistorySyncTask$LicenseTarget\">SELECT `id`,`tenant_id`,`device_id`,`contract_id`,`device_sn`,`contract_no`,`contract_type`,`product_code`,`product_model`,`license_status`,`creator`,`updater`,`create_time`,`update_time`,`deleted`,`license_code_ciphertext` FROM ast_device_license_record WHERE tenant_id=#{query.tenantId} <choose><when test=\"query.ids != null and !query.ids.isEmpty()\">AND id IN <foreach collection=\"query.ids\" item=\"id\" open=\"(\" close=\")\" separator=\",\">#{id}</foreach></when><otherwise>AND 1=0</otherwise></choose><if test=\"!query.preview\">FOR UPDATE</if></select>\n"
