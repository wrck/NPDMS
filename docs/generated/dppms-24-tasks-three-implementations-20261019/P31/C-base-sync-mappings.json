      "xml": "<select id=\"selectMembers\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P31MemberContactSyncTask$MemberRow\">SELECT r.`id`,r.`project_id`,r.`user_id`,r.`employee_no`,r.`member_name`,r.`company_id`,r.`company_code`,r.`company_name`,r.`department_id`,r.`department_code`,r.`department_name`,r.`member_role`,r.`assignment_type`,r.`site_id`,r.`responsibility`,r.`change_reason`,r.`effective_from`,r.`effective_to`,r.`status`,r.`version`,r.`creator`,r.`create_time`,r.`updater`,r.`update_time`,r.`deleted`,r.`deleted_time`,r.`tenant_id`,r.`remark`,r.`end_reason`,r.`member_code`,r.`phone_number`,r.`email`,r.`registration_source`,r.`authorization_confirmed`,(b.id IS NOT NULL) AS owned FROM proj_project_member_assignment r LEFT JOIN int_base_sync_task task ON task.tenant_id=r.tenant_id AND task.task_code='BASE_P31' AND task.connection_id=#{query.connectionId} AND task.deleted=FALSE LEFT JOIN int_base_sync_binding b ON b.tenant_id=r.tenant_id AND b.task_id=task.id AND b.deleted=FALSE AND b.object_key='MEMBER_HISTORY' AND b.target_id=r.id WHERE r.tenant_id=#{query.tenantId} <choose><when test=\"query.projectIds != null and !query.projectIds.isEmpty()\">AND r.project_id IN <foreach collection=\"query.projectIds\" item=\"id\" open=\"(\" close=\")\" separator=\",\">#{id}</foreach></when><otherwise>AND 1=0</otherwise></choose> ORDER BY r.id LIMIT #{query.limit}<if test=\"!query.preview\"> FOR UPDATE</if></select>\n"
    },
