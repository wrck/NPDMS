      "xml": "<insert id=\"insertReceivable\">\n    INSERT INTO com_contract_receivable (`id`,`tenant_id`,`contract_id`,`contract_no`,`company_id`,`company_code`,`company_name`,`company_resolution_source`,`mapping_status`,`project_name`,`source_order_no`,`customer_code`,`customer_name`,`contract_amount`,`delivered_amount`,`collected_amount`,`collected_ratio`,`receivable_amount`,`overdue_amount`,`currency_name`,`market_code`,`market_name`,`department_id`,`department_code`,`department_name`,`industry_name`,`marketing_representative_name`,`source_batch_code`,`import_batch_no`,`project_code`,`system_source_key`,`system_code`,`system_name`,`industry_code`,`expend_source_key`,`expend_code`,`expend_name`,`marketing_representative_code`,`secondary_representative_code`,`original_division_values`,`source_effective_from`,`source_effective_to`,`contract_create_time`,`latest_ship_time`,`source_system`,`source_record_key`,`source_sync_time`,`creator`,`create_time`,`updater`,`update_time`,`deleted`)\n    VALUES\n    <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.target.id},#{row.target.tenantId},#{row.target.contractId},#{row.target.contractNo},#{row.target.companyId},#{row.target.companyCode},#{row.target.companyName},#{row.target.companyResolutionSource},#{row.target.mappingStatus},#{row.target.projectName},#{row.target.sourceOrderNo},#{row.target.customerCode},#{row.target.customerName},#{row.target.contractAmount},#{row.target.deliveredAmount},#{row.target.collectedAmount},#{row.target.collectedRatio},#{row.target.receivableAmount},#{row.target.overdueAmount},#{row.target.currencyName},#{row.target.marketCode},#{row.target.marketName},#{row.target.departmentId},#{row.target.departmentCode},#{row.target.departmentName},#{row.target.industryName},#{row.target.marketingRepresentativeName},#{row.target.sourceBatchCode},#{row.target.importBatchNo},#{row.target.projectCode},#{row.target.systemSourceKey},#{row.target.systemCode},#{row.target.systemName},#{row.target