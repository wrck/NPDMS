  "mapperNodes": [
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P33InstallationSyncTask$TargetMapper.selectDevices",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P33TargetMapper.xml",
      "xml": "<select id=\"selectDevices\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P33InstallationSyncTask$Device\">SELECT id,sn FROM ast_device WHERE tenant_id=#{query.tenantId} AND deleted=FALSE <choose><when test=\"query.serials != null and !query.serials.isEmpty()\">AND sn IN <foreach collection=\"query.serials\" item=\"sn\" open=\"(\" close=\")\" separator=\",\">#{sn}</foreach></when><otherwise>AND 1=0</otherwise></choose><if test=\"!query.preview\"> FOR UPDATE</if></select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P33InstallationSyncTask$TargetMapper.selectExisting",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P33TargetMapper.xml",
      "xml": "<select id=\"selectExisting\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P33InstallationSyncTask$Row\">SELECT `id`,`project_id`,`code`,`equipment_id`,`install_location`,`address_id`,`address_version`,`site_id`,`site_version`,`site_location_id`,`site_location_version`,`location_resolution_status`,`address_snapshot`,`location_snapshot`,`effective_from`,`effective_to`,`current_equipment_id`,`install_time`,`installer_user_id`,`environment_check`,`spec_check`,`photo_url`,`result`,`status`,`remark`,`version`,`creator`,`create_time`,`updater`,`update_time`,`deleted`,`tenant_id` FROM imp_eng_installation WHERE tenant_id=#{query.tenantId} AND (1=0 <if test=\"query.projectIds != null and !query.projectIds.isEmpty()\">OR project_id IN <foreach collection=\"query.projectIds\" item=\"id\" open=\"(\" close=\")\" separator=\",\">#{id}</foreach></if><if test=\"query.equipmentIds != null and !query.equipmentIds.isEmpty()\">OR equipment_id IN <foreach collection=\"query.equipmentIds\" item=\"id\" open=\"(\" close=\")\" separator=\",\">#{id}</foreach></if>) ORDER BY id LIMIT #{query.limit}<if test=\"!query.preview\"> FOR UPDATE</if></select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P33InstallationSyncTask$TargetMapper.insertInstallation",
      "source": "pms-module-integration/src/main/resources/mapper/basesync/P33TargetMapper.xml",
      "xml": "<insert id=\"insertInstallation\">INSERT INTO imp_eng_installation (`id`,`project_id`,`code`,`equipment_id`,`install_location`,`address_id`,`address_version`,`site_id`,`site_version`,`site_location_id`,`site_location_version`,`location_resolution_status`,`address_snapshot`,`location_snapshot`,`effective_from`,`effective_to`,`install_time`,`installer_user_id`,`environment_check`,`spec_check`,`photo_url`,`result`,`status`,`remark`,`version`,`creator`,`create_time`,`updater`,`update_time`,`deleted`,`tenant_id`) VALUES <foreach collection=\"rows\" item=\"row\" separator=\",\">(#{row.target.id},#{row.target.projectId},#{row.target.code},#{row.target.equipmentId},#{row.target.installLocation},#{row.target.addressId},#{row.target.addressVersion},#{row.target.siteId},#{row.target.siteVersion},#{row.target.siteLocationId},#{row.target.siteLocationVersion},#{row.target.locationResolutionStatus},#{row.target.addressSnapshot},#{row.target.locationSnapshot},#{row.target.effectiveFrom},#{row.target.effectiveTo},#{row.target.installTime},#{row.target.installerUserId},#{row.target.environmentCheck},#{row.target.specCheck},#{row.target.photoUrl},#{row.target.result},#{row.target.status},#{row.target.remark},#{row.target.version},#{row.target.creator},#{row.target.createTime},#{row.target.updater},#{row.target.updateTime},#{row.target.deleted},#{row.target.tenantId})</foreach></insert>"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.basesync.task.P33InstallationSyncTask$SourceMapper.selectInstallation",
      "source": "pms-module-integration/src/main/resources/base-sync-source/P33SourceMapper.xml",
      "xml": "<select id=\"selectInstallation\" resultType=\"cn.iocoder.yudao.module.pms.integration.basesync.task.P33InstallationSyncTask$Source\">SELECT `id` AS sourceId,`projectId` AS originalProjectId,`barcode` AS barcode,`itemCode` AS itemCode,`itemModel` AS itemModel,`itemName` AS itemName,`receiveName` AS receiveName,`emsNum` AS emsNum,`emsCompany` AS emsCompany,`packdate` AS packdate,`contractNo` AS contractNo,`installAddress` AS installAddress,`chProjectId` AS chProjectId,`chContractNo` AS chContractNo,`transferProjectId` AS transferProjectId,`transferContractNo` AS transferContractNo,`transferFlag` AS transferFlag,`createTime` AS createTime,`createBy` AS source_creator,`updateTime` AS updateTime,`updateBy` AS source_updater FROM pm_project_shipment <choose><when test=\"projectKeys != null and !projectKeys.isEmpty()\">WHERE projectId IN <foreach collection=\"projectKeys\" item=\"key\" open=\"(\" close=\")\" separator=\",\">#{key}</foreach></when><otherwise>WHERE 1=0</otherwise></choose> ORDER BY id LIMIT #{limit}</select>"
    }
  ]
}
