  "mapperNodes": [
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectInstallationMapper.selectBoundRecordForUpdate",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectInstallationMapper.xml",
      "xml": "<select id=\"selectBoundRecordForUpdate\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectInstallationRow\">\n        SELECT * FROM imp_eng_installation\n        WHERE tenant_id=#{query.tenantId} AND project_id=#{query.projectId} AND id=#{query.installationId}\n        FOR UPDATE\n    </select>\n    \n    "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectInstallationMapper.insertHistorical",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectInstallationMapper.xml",
      "xml": "<insert id=\"insertHistorical\">\n        INSERT INTO imp_eng_installation\n          (id,tenant_id,project_id,code,equipment_id,install_location,\n           address_id,address_version,site_id,site_version,site_location_id,site_location_version,\n           location_resolution_status,address_snapshot,location_snapshot,\n           effective_from,effective_to,install_time,installer_user_id,environment_check,\n           spec_check,photo_url,result,status,remark,version,creator,create_time,updater,update_time,deleted)\n        VALUES\n          (#{record.id},#{record.tenantId},#{record.projectId},#{record.code},#{record.equipmentId},#{record.installLocation},\n           #{record.addressId},#{record.addressVersion},#{record.siteId},#{record.siteVersion},#{record.siteLocationId},#{record.siteLocationVersion},\n           #{record.locationResolutionStatus},#{record.addressSnapshot},#{record.locationSnapshot},\n           #{record.effectiveFrom},#{record.effectiveTo},#{record.installTime},#{record.installerUserId},#{record.environmentCheck},\n           #{record.specCheck},#{record.photoUrl},#{record.result},#{record.status},#{record.remark},#{record.version},\n           #{record.creator},#{record.createTime},#{record.updater},#{record.updateTime},#{record.deleted})\n    </insert>\n    "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectInstallationMapper.selectCurrentRecordForUpdate",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectInstallationMapper.xml",
      "xml": "<select id=\"selectCurrentRecordForUpdate\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectInstallationRow\">\n        SELECT * FROM imp_eng_installation WHERE tenant_id=#{query.tenantId} AND equipment_id=#{query.equipmentId} AND status=2 AND effective_to IS NULL AND deleted=0 FOR UPDATE\n    </select>\n    "
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectInstallationMapper.selectRecordCodesIncludeDeleted",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectInstallationMapper.xml",
      "xml": "<select id=\"selectRecordCodesIncludeDeleted\" resultType=\"java.lang.String\">\n        SELECT code FROM imp_eng_installation WHERE tenant_id=#{query.tenantId} AND project_id=#{query.projectId} AND code IS NOT NULL\n    </select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectProjectEvidenceMapper.selectSource",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectProjectEvidenceMapper.xml",
      "xml": "<select id=\"selectSource\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectProjectSourceRow\">\n    SELECT * FROM proj_legacy_detail_source WHERE tenant_id=#{query.tenantId} AND source_system='DPPMS'\n      AND source_project_key=#{query.sourceProjectKey}\n  </select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectProjectEvidenceMapper.selectSourceForUpdate",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectProjectEvidenceMapper.xml",
      "xml": "<select id=\"selectSourceForUpdate\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectProjectSourceRow\">\n    SELECT * FROM proj_legacy_detail_source WHERE tenant_id=#{query.tenantId} AND source_system='DPPMS'\n      AND source_project_key=#{query.sourceProjectKey} FOR UPDATE\n  </select>\n"
    },
    {
      "statement": "cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectProjectEvidenceMapper.selectRecords",
      "source": "pms-module-integration/src/main/resources/mapper/sync/DirectProjectEvidenceMapper.xml",
      "xml": "<select id=\"selectRecords\" resultType=\"cn.iocoder.yudao.module.pms.integration.dal.mysql.sync.DirectProjectRecordRow\">\n    SELECT * FROM proj_legacy_detail_record WHERE <include refid=\"recordScope\" /> ORDER BY source_key,id\n    LIMIT #{query.offset},#{query.limit}\n  </select>\n"
    }
  ]
