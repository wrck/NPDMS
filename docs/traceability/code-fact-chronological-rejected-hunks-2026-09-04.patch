+  if (['REFRESH_AGGREGATE', 'REFRESH_OWNER_FACTS', 'RETRY_SAME_KEY', 'START_NEW_INTENT']
+    .includes(action)) return action as string
+  return (error as any)?.response ? 'SURFACE_ERROR' : 'RETRY_SAME_KEY'
