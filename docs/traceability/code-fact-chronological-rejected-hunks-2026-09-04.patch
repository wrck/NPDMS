+                            candidate.adminUserId(), "ACTION_VIEW");
+                    var lockedScope = projectScopePort.lockAndRevalidate(expectedScope);
+                    require(lockedScope.outcome() == CutoverApprovalProjectScopePort.Revalidation.VALID,
+                            SOURCE_STALE, "审批候选项目范围已变化");
