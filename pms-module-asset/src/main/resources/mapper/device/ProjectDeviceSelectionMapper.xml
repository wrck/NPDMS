<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.asset.dal.mysql.device.ProjectDeviceSelectionMapper">
    <select id="selectSelectionForUpdate" resultType="cn.iocoder.yudao.module.pms.asset.dal.dataobject.device.DeviceDO">
        SELECT * FROM ast_device
        WHERE tenant_id = #{query.tenantId} AND deleted = 0
        <choose>
            <when test="query.projectId != null and query.projectId > 0 and query.deviceIds != null and !query.deviceIds.isEmpty()">
                AND id IN
                <foreach collection="query.deviceIds" item="id" open="(" separator="," close=")">#{id}</foreach>
                AND (project_id = #{query.projectId}
                <if test="query.contractNumbers != null and !query.contractNumbers.isEmpty()">
                    OR contract_no IN
                    <foreach collection="query.contractNumbers" item="number" open="(" separator="," close=")">#{number}</foreach>
                </if>)
            </when>
            <otherwise>AND 1 = 0</otherwise>
        </choose>
        ORDER BY id FOR UPDATE
    </select>
</mapper>
