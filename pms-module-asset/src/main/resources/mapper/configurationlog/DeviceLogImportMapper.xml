<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.asset.dal.mysql.configurationlog.DeviceLogImportMapper">
    <select id="lockImport" resultType="cn.iocoder.yudao.module.pms.asset.dal.dataobject.configurationlog.DeviceLogImportDO">
        SELECT * FROM ast_device_log_import
        WHERE tenant_id=#{query.tenantId} AND source_key=#{query.sourceKey} AND deleted=0
        FOR UPDATE
    </select>
</mapper>
