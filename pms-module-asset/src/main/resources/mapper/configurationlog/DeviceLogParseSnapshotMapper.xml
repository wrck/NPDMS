<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.asset.dal.mysql.configurationlog.DeviceLogParseSnapshotMapper">
    <select id="selectByFileForUpdate" resultType="cn.iocoder.yudao.module.pms.asset.dal.dataobject.configurationlog.DeviceLogParseSnapshotDO">
        SELECT * FROM ast_device_log_parse_snapshot
        WHERE tenant_id=#{query.tenantId} AND id=#{query.fileId} AND deleted=b'0' FOR UPDATE
    </select>
</mapper>
