{
  "schemaVersion": 1,
  "featureId": "F-IMP-002",
  "status": "BASELINE_READY",
  "requirementSlice": "EXE-01@V1",
  "owner": "IMP",
  "contract": "ArrivalAcceptanceFactApi",
  "operations": {
    "inspect": {
      "input": ["tenantId", "projectId", "deviceIds", "quantityScopes"],
      "sideEffect": "NONE"
    },
    "lockAndRevalidate": {
      "input": ["tenantId", "projectId", "deviceIds", "quantityScopes", "expectedFactVersion", "expectedScopeWatermark"],
      "lockOrder": "DEVICE_ID_THEN_ORDER_LINE_ID_THEN_ARRIVAL_ACCEPTANCE_ID",
      "sideEffect": "NONE"
    }
  },
  "response": {
    "required": ["tenantId", "projectId", "sourceAcceptanceIds", "decision", "factVersion", "scopeWatermark", "reopened"],
    "decision": ["ACCEPTED", "NOT_ACCEPTED", "STALE"],
    "scopeWatermark": ["deliveryScopeVersion", "deviceAssignmentVersions"],
    "sourceAcceptanceIds": "STABLE_ASCENDING_IDS_OF_ALL_BATCHES_CONTRIBUTING_TO_THE_DECISION",
    "factVersion": "MONOTONIC_PROJECT_ARRIVAL_FACT_VERSION",
    "reopenedDerivation": {
      "trueWhen": "MAX_PROJECT_FACT_VERSION_HAS_ONE_QUALIFIED_IMMUTABLE_DIFFERENCE_REVISION_SOURCE",
      "falseWhen": "MAX_PROJECT_FACT_VERSION_HAS_ONE_ORDINARY_ACCEPTANCE_ROOT_SOURCE_WITHOUT_REOPEN_SEMANTICS",
      "failClosedWhen": ["MAX_VERSION_SOURCE_MISSING", "MAX_VERSION_SOURCE_DUPLICATED", "SOURCE_DAMAGED", "SUCCESSOR_ROOT_REOPEN_SEMANTICS_UNPROVABLE"],
      "forbiddenInference": ["FACT_VERSION_GREATER_THAN_ONE", "PREDECESSOR_ACCEPTANCE_ID", "RESOLUTION_STATUS", "BATCH_COUNT", "CURRENT_DECISION"]
    },
    "rangeResults": ["acceptedDeviceIds", "exemptedDeviceIds", "unmetDeviceIds", "acceptedQuantityScopes", "exemptedQuantityScopes", "unmetQuantityScopes"],
    "forbidden": ["OWNER_DO", "FILE_BODY", "PERSISTENT_DOWNLOAD_URL", "SIGNER_PRIVATE_FIELDS"]
  },
  "validAcceptance": "ALL_CURRENT_EXPECTED_DEVICES_AND_QUANTITIES_ARE_ACCEPTED_OR_COVERED_BY_UNEXPIRED_EXPLICIT_EXEMPTIONS",
  "staleWhen": ["DELIVERY_SCOPE_VERSION_CHANGED", "DEVICE_ASSIGNMENT_VERSION_CHANGED", "FACT_VERSION_CHANGED"],
  "ownerRevalidationPolicy": {
    "expectedVersionMismatch": "REINSPECT_CURRENT_FACT_AND_RETURN_STALE",
    "portSignal": "OwnerFactVersionMismatchException",
    "missingUnknownOrUnavailable": "FAIL_CLOSED"
  },
  "reopenedStalePolicy": "OLD_EXPECTED_FACT_VERSION_IS_STALE_AFTER_REOPEN; CURRENT_REOPENED_FACT_IS_RETURNED_WITH_REOPENED_TRUE",
  "failurePolicy": "MISSING_UNKNOWN_UNAVAILABLE_UNAUTHORIZED_OR_NON_COMPARABLE_CONFLICT_FAILS_CLOSED",
  "consumerFeatures": ["F-IMP-003", "F-IMP-001"],
  "featureReadyDecision": "GO_FIMP002_FEATURE_READY_4B5A2AC9"
}
