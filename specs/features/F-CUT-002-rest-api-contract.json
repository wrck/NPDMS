    "correlationId": "RESOLVED_ONCE_FROM_TRUSTED_REQUEST_CONTEXT; NORMALIZED_NON_BLANK_1_TO_128; EXCLUDED_FROM_BUSINESS_DIGEST; SAME_VALUE_PERSISTED_IN_SUCCESS_FACTS"
  },
  "wireContract": {
    "successEnvelope": "Yudao CommonResult<data=T>",
