    },
    "ProjectReadOnlyContext": {
      "exactKeys": ["projectId", "projectCode", "projectName", "projectScopeVersion"],
      "projectId": "POSITIVE_LONG",
      "projectCode": "NORMALIZED_STRING_MAX_64_OR_JSON_NULL_FOR_LEGACY_FORWARD",
      "projectName": "NORMALIZED_STRING_MAX_128_OR_JSON_NULL_WHEN_CURRENT_OWNER_FACT_IS_UNAVAILABLE_FOR_LEGACY_FORWARD",
      "projectScopeVersion": "NON_NEGATIVE_LONG_OR_JSON_NULL_FOR_LEGACY_FORWARD"
