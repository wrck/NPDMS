      "submittedAt": "wireContract.dateTime_OR_JSON_NULL",
      "invalidatedAt": "wireContract.dateTime_OR_JSON_NULL",
      "invalidationReason": "STRING_MAX_1000_OR_JSON_NULL"
    },
    "CutoverTaskDetail": {
      "exactKeys": ["task", "source", "project", "devices", "customerServiceLevel", "implementationReadiness", "assessment", "workbenchSteps", "allowedActions"],
      "task": "responseTypes.CutoverTaskCore",
