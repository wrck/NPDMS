      "currentStage": "P2|P3|P4_OR_JSON_NULL_FOR_LEGACY_FORWARD",
      "taskStatus": "GRADE_CONFIRMING|SURVEYING|PLAN_DRAFTING|LEGACY_UNKNOWN",
      "manualGrade": "A|B|C|D_OR_JSON_NULL",
      "scheduledTime": "wireContract.dateTime_OR_JSON_NULL",
