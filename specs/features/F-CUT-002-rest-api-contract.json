      "request": {
        "projectId": "POSITIVE_LONG",
        "configurationCode": "NORMALIZED_NON_BLANK_F_CUT_001_CONFIGURATION_CODE_MAX_64_SELECTION_INTENT_ONLY",
        "serialNumbers": "NON_EMPTY_ARRAY_OF_commonTypes.serialNumber_MAX_500",
