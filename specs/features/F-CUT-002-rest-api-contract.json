        "expectedReadinessSnapshotVersion": "NON_NEGATIVE_LONG",
        "expectedCustomerServiceLevelStatus": "AVAILABLE|NOT_CONFIGURED",
        "expectedCustomerServiceLevelRevisionId": "POSITIVE_LONG_FOR_AVAILABLE_OR_JSON_NULL_FOR_NOT_CONFIGURED",
        "expectedCustomerServiceLevelCode": "ENABLED_BASIC_PLATFORM_DICTIONARY_CODE_FOR_AVAILABLE_OR_JSON_NULL_FOR_NOT_CONFIGURED",
        "expectedCustomerServiceLevelFactVersion": "NON_NEGATIVE_LONG",
        "expectedCustomerServiceLevelEffectiveFrom": "wireContract.dateTime_FOR_AVAILABLE_OR_JSON_NULL_FOR_NOT_CONFIGURED",
        "expectedCustomerServiceLevelEffectiveTo": "wireContract.dateTime_OR_JSON_NULL; must be JSON null for NOT_CONFIGURED"
      },
      "guards": ["actor has ProjectScopeApi.ACTION_EDIT under participant/responsible/explicit-authorization semantics", "server captures one taskCreatedAt and resolves exactly one same-tenant published revision for configurationCode whose effective interval contains taskCreatedAt; caller cannot supply revisionId or revisionNo", "ProjectCutoverContextFactApi.lockAndRevalidate matches every field in expectedProjectContext and supplies the exact locked current project/department/customer occurrence fact; CUT freezes only currentFact", "all normalized serials resolve to the exact expected non-empty device set and explicitly selected project candidate", "customer identity is supplied only by trusted project context; AVAILABLE carries the exact previously displayed revision/code/factVersion/effective interval and NOT_CONFIGURED carries null revision/code/interval plus factVersion", "CustomerServiceLevelFactApi.lockAndRevalidate matches that complete expected fact", "ImplementationReadinessApi.lockAndRevalidate returns READY for exact snapshot/project/devices", "no selected device has another active task"],
      "write": "one NEW_PLATFORM/SELF_CREATED cut_task with immutable configurationRevisionId/configurationCode/configurationRevisionNo and create_time=taskCreatedAt + stable device scope rows + one P1_ACCEPTED history row + platform success facts atomically; server generates taskNo and P2/GRADE_CONFIRMING state",
