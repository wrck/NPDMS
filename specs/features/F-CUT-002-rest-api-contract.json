      "exactKeys": ["id", "taskNo", "taskName", "background", "taskOrigin", "cutoverType", "networkMode", "projectId", "projectName", "ownerUserId", "currentStage", "taskStatus", "manualGrade", "scheduledTime", "createTime", "version"],
      "id": "POSITIVE_LONG",
      "taskNo": "NON_BLANK_STRING_MAX_64",
      "taskName": "NON_BLANK_STRING_MAX_128",
      "background": "STRING_MAX_4000_OR_JSON_NULL_FOR_LEGACY_FORWARD",
      "taskOrigin": "NEW_PLATFORM|LEGACY_FORWARD",
      "cutoverType": "F_CUT_001_CODE_OR_JSON_NULL_FOR_LEGACY_FORWARD",
