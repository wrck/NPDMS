      "project": "responseTypes.ProjectReadOnlyContext",
      "devices": "commonTypes.deviceScopeWatermark_OR_EMPTY_FOR_LEGACY_FORWARD",
      "customerServiceLevel": "commonTypes.customerServiceLevelContext_OR_JSON_NULL_FOR_LEGACY_FORWARD",
      "implementationReadiness": "commonTypes.readinessContext_OR_JSON_NULL_FOR_LEGACY_FORWARD",
      "assessment": "responseTypes.AssessmentView_OR_JSON_NULL",
      "workbenchSteps": "ARRAY_OF_commonTypes.workbenchStep_IN_FIXED_P2_P3_P4_P5_P6_ORDER",
      "allowedActions": "ARRAY_OF_allowedActions.values_STABLE_ENUM_ORDER"
    },
    "CutoverTaskCommandData": {
      "exactKeys": ["id", "taskNo", "currentStage", "taskStatus", "version", "replayed"],
      "id": "POSITIVE_LONG",
      "taskNo": "NON_BLANK_STRING_MAX_64",
      "currentStage": "P2|P3|P4",
      "taskStatus": "GRADE_CONFIRMING|SURVEYING|PLAN_DRAFTING",
      "version": "NON_NEGATIVE_INTEGER",
