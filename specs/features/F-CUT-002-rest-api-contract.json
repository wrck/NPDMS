    "AssessmentView": {
      "exactKeys": ["id", "assessmentVersion", "rowVersion", "status", "questionnaireTemplateCode", "questionnaireTemplateVersion", "answers", "customerServiceLevel", "manualGrade", "simpleFlow", "submittedBy", "submittedAt", "invalidatedAt", "invalidationReason"],
      "id": "POSITIVE_LONG",
      "assessmentVersion": "POSITIVE_INTEGER",
      "rowVersion": "NON_NEGATIVE_INTEGER",
      "status": "DRAFT|SUBMITTED|INVALIDATED",
      "questionnaireTemplateCode": "NON_BLANK_STRING_MAX_64",
