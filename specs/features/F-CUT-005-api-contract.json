  },
  "allowedActionsMatrix": {
    "APPROVE_REJECT": "permission approve + FULL visibility + root PENDING/null holdReason + node PENDING/current node/currentApprover=current user + current Owner candidate fact valid + INITIATOR current ACTION_EDIT or other node current ACTION_VIEW; source/task/approval versions are revalidated again by command",
    "REASSIGN": "permission reassign-approval + REASSIGNMENT_ONLY projection + root PENDING + target node WAITING|PENDING; administrator is never treated as node approver and receives no approve/reject action",
    "NONE": "original initiator has progress visibility only; read-only project member receives FINAL_RESULT_ONLY after terminal state; neither receives approval actions unless independently the current qualified approver"
  },
