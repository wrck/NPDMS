  "operations": {
    "detail": {"method":"GET","path":"/api/v1/pms/cutover-tasks/{taskId}/approval","permission":"pms:cutover-task:query-approval OR pms:cutover-task:reassign-approval","headers":[],"success":"CommonResult<ApprovalView>","visibility":"original initiator with current ACTION_VIEW or current node approver with the node-required current scope receives FULL; any other current ACTION_VIEW project member receives FINAL_RESULT_ONLY only after APPROVED/REJECTED; reassign administrator receives REASSIGNMENT_ONLY for PENDING instances and never FULL by permission alone; no eligible relation is 404","errors":["FUNCTION_OR_SCOPE_DENIED","NOT_VISIBLE_OR_NOT_FOUND","OWNER_PROVIDER_UNAVAILABLE"]},
    "myTodos": {"method":"GET","path":"/api/v1/pms/cutover-approvals/todos","permission":"pms:cutover-task:query-approval","headers":[],"query":{"pageNo":"positive Integer","pageSize":"Integer 1..100"},"success":"CommonResult<TodoPage>","selection":"only root PENDING with null holdReason and node PENDING/currentApproverUserId=current user; INITIATOR additionally requires current ACTION_EDIT, other node codes require current ACTION_VIEW and current Owner candidate eligibility; failed revalidation omits the row, Provider unavailable fails the whole query rather than returning a partial page","errors":["INVALID_REQUEST","FUNCTION_OR_SCOPE_DENIED","OWNER_PROVIDER_UNAVAILABLE"]},
