    "approve": {"method":"POST","path":"/api/v1/pms/cutover-tasks/{taskId}/approval-actions/approve","permission":"pms:cutover-task:approve","headers":["If-Match","X-Task-Version","Idempotency-Key"],"body":"ApproveRequest","success":"CommonResult<ApprovalDetail>","errors":["INVALID_REQUEST","FUNCTION_OR_SCOPE_DENIED","NOT_VISIBLE_OR_NOT_FOUND","STATE_CONFLICT","VERSION_CONFLICT","SOURCE_STALE","BUSINESS_INCOMPLETE","IDEMPOTENCY_CONFLICT","IDEMPOTENCY_IN_PROGRESS","OWNER_PROVIDER_UNAVAILABLE","OWNER_DATA_CORRUPTED"]},
    "reject": {"method":"POST","path":"/api/v1/pms/cutover-tasks/{taskId}/approval-actions/reject","permission":"pms:cutover-task:approve","headers":["If-Match","X-Task-Version","Idempotency-Key"],"body":"RejectRequest","success":"CommonResult<ApprovalDetail>","errors":["INVALID_REQUEST","FUNCTION_OR_SCOPE_DENIED","NOT_VISIBLE_OR_NOT_FOUND","STATE_CONFLICT","VERSION_CONFLICT","SOURCE_STALE","BUSINESS_INCOMPLETE","IDEMPOTENCY_CONFLICT","IDEMPOTENCY_IN_PROGRESS","OWNER_PROVIDER_UNAVAILABLE","OWNER_DATA_CORRUPTED"]},
