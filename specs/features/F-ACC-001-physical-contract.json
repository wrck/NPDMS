  "rolePermissionPolicy": "FORMAL_CONFIGURATION_NO_FIXED_ROLE_MATRIX",
  "serverScopes": ["TENANT", "PROJECT_TREE_OR_TASK", "FILE_BUSINESS_SCOPE"],
  "restApis": [
    {"method":"GET","path":"/api/v1/pms/acceptances","permission":"pms:acceptance:report:query"},
    {"method":"GET","path":"/api/v1/pms/acceptances/{id}","permission":"pms:acceptance:report:query"},
    {"method":"GET","path":"/api/v1/pms/acceptances/{id}/report-versions","permission":"pms:acceptance:report:query"},
    {"method":"POST","path":"/api/v1/pms/acceptances/{id}/report-versions","permission":"pms:acceptance:report:write","result":"DRAFT_ONLY"},
    {"method":"PATCH","path":"/api/v1/pms/acceptances/{id}/report-versions/{versionId}","permission":"pms:acceptance:report:write","result":"DRAFT_ONLY"},
    {"method":"POST","path":"/api/v1/pms/acceptances/{id}/report-versions/{versionId}/actions/publish","permission":"pms:acceptance:report:write","idempotency":"REQUIRED"},
    {"method":"POST","path":"/api/v1/pms/acceptances/{id}/actions/revoke-current-version","permission":"pms:acceptance:report:write","idempotency":"REQUIRED"},
    {"method":"GET","path":"/api/v1/pms/acceptances/{id}/report-versions/{versionId}/attachments/{sequence}/download","permission":"pms:acceptance:report:download","scope":"PROJECT_AND_FILE_EACH_REQUEST"},
    {"method":"POST","path":"/api/v1/pms/project-tasks/{id}/actions/complete","permissions":["pms:project-task:execute","pms:acceptance:report:complete"],"owner":"PROJ"}
  ],
  "moduleApis": {
    "AcceptanceActivityCompletionFactApi": {
      "provider":"REAL_ACC_PROVIDER_REQUIRED",
      "transactionPropagation":"MANDATORY",
      "inputs":["tenantId","projectId","projectTaskId","executionContractId","acceptanceId","expectedActivityVersion","expectedReportVersion","operationId"],
      "outcomes":["COMPLETED","REPORT_INCOMPLETE","IDENTITY_MISMATCH","VERSION_CONFLICT","DEPENDENCY_UNAVAILABLE"]
    },
    "AcceptanceScopeBindingApi": {"reuse":"DIRECT_REUSE_F_COM_001","reportTrigger":"FORBIDDEN"},
    "AcceptanceScopeGuardApi": {"reuse":"DIRECT_REUSE_F_COM_001"},
    "DeliveryScopeAcceptanceLockApi": {"reuse":"DIRECT_REUSE_F_COM_001"},
    "FileBusinessScope": {"owner":"PLT","requiredOn":["ATTACHMENT_BIND","DOWNLOAD"]}
  },
  "states": {
    "AcceptanceActivity":["PENDING","COMPLETED"],
    "AcceptanceReportVersion":["DRAFT","EFFECTIVE","SUPERSEDED","REVOKED"],
    "DeliverableSourceVersion":["CURRENT","SUPERSEDED","REVOKED"],
    "Archive":["PENDING_COMPENSATION","ARCHIVED","INVALID"]
  },
  "transactionBoundary": {
    "reportLockOrder":["ACC_ACTIVITY","OLD_CURRENT_IF_ANY","TARGET_DRAFT_IF_ANY","ATTACHMENTS","INITIAL_REPORT_IF_FINAL"],
    "completionLockOrder":["PROJ_TASK_AND_EXECUTION_CONTRACT","ACC_ACTIVITY","CURRENT_REPORT"],
    "reportAndOutboxAtomic":true,
    "taskActivityCompletionAtomic":true,
    "archiveFailureRollsBackReport":false
  },
  "events": {
    "AcceptanceReportVersionChanged": {
      "changeTypes":["EFFECTIVE","REPLACED","REVOKED"],
      "facts":["acceptanceId","projectId","reportType","currentReportVersionId","previousReportVersionId","attachments[{sequence,fileArtifactId,fileVersionId,fileHash}]"],
      "idempotency":"SOURCE_REPORT_VERSION"
    },
    "ClosureGateRecheckRequested": {"resultMeaning":"REQUEST_ONLY_NOT_CLOSURE_PASS"}
  },
  "physicalDelta": {
    "tables": {
      "acc_acceptance": {
        "mode":"CREATE",
        "fields":["project_id","project_task_id","execution_contract_id","acceptance_type","activity_status","current_report_version_id","version","tenant_and_audit_fields"],
        "uniqueKeys":["tenant_id+project_id+acceptance_type","tenant_id+project_task_id"]
      },
      "acc_acceptance_report_version": {
        "mode":"CREATE",
        "fields":["acceptance_id","report_version_no","report_status","acceptance_time","conclusion_code","conclusion_text","acceptor_name","previous_version_id","effective_from","effective_to","current_marker","uploader_user_id","upload_time","tenant_and_audit_fields"],
        "currentMarker":"case when report_status='EFFECTIVE' and effective_to is null then 1 else null end",
        "uniqueKeys":["tenant_id+acceptance_id+report_version_no","tenant_id+acceptance_id+current_marker"]
      },
      "acc_acceptance_report_attachment": {
        "mode":"CREATE",
        "fields":["report_version_id","attachment_sequence","file_artifact_id","file_version_id","file_hash","tenant_and_audit_fields"],
        "uniqueKeys":["tenant_id+report_version_id+attachment_sequence","tenant_id+report_version_id+file_artifact_id+file_version_id"],
        "primaryAttachment":"FORBIDDEN"
      },
      "acc_project_deliverable": {
        "mode":"ALTER_ADDITIVE",
        "fields":["current_source_version_id","archive_status"],
        "existingUniqueKey":"tenant_id+project_id+deliverable_code"
      },
      "acc_project_deliverable_source_version": {
        "mode":"CREATE",
        "fields":["deliverable_id","source_requirement_id","source_object_type","source_object_id","source_version","relation_status","archive_status","archive_failure_code","archive_retry_count","archive_time","current_marker","tenant_and_audit_fields"],
        "currentMarker":"case when relation_status='CURRENT' then 1 else null end",
        "uniqueKeys":["tenant_id+deliverable_id+source_object_type+source_object_id+source_version","tenant_id+deliverable_id+current_marker"]
      },
      "acc_project_deliverable_source_attachment": {
        "mode":"CREATE",
        "fields":["deliverable_source_version_id","attachment_sequence","file_artifact_id","file_version_id","file_hash","tenant_and_audit_fields"],
        "uniqueKeys":["tenant_id+deliverable_source_version_id+attachment_sequence","tenant_id+deliverable_source_version_id+file_artifact_id+file_version_id"]
      }
    },
    "crossContextForeignKeys":"FORBIDDEN"
  },
  "legacyDisposition": {
    "v17AcceptanceAndArchive":"DO_NOT_REUSE_NEW_ONLY",
    "v63DeliverableRoot":"DIRECT_REUSE_COPY_THEN_ENHANCE",
    "exactTaskDefinitionKeys":{"T-INITIAL-ACCEPT":"PRELIMINARY","T-FINAL-ACCEPT":"FINAL"},
    "exactDeliverableCodes":{"PRELIMINARY":"D-INITIAL-REPORT","FINAL":"D-FINAL-REPORT"},
    "missingAmbiguousOrPartial":"FAIL_BATCH",
    "forbiddenInference":["NAME","STAGE_ONLY","LEGACY_STATUS","APPROVAL_OPINION","URL","D-ACCEPT-REPORT"]
