{
  "schemaVersion": 1,
  "featureId": "F-PROJ-008",
  "requirementIds": ["PM-03"],
  "requirementSliceCoverage": ["PM-03@V1=PARTIAL"],
  "relatedRequirementSlices": ["PM-01", "PM-04", "PM-11"],
  "status": "BASELINE_READY",
  "contractType": "NO_PHYSICAL_DELTA_FEATURE_CONTRACT",
  "phaseGateImpact": "FPROJ008_FEATURE_READY_GO_744C70A0_Q_FPROJ_008_RESOLVED_TECHNICAL_PLAN_PENDING",
  "v1Scope": {
    "included": ["S0_TO_S4_ADJACENT_ADVANCE", "EXIT_GATE_READINESS", "SIX_TYPED_OWNER_FACTS", "FROZEN_VERSION_GATE_PROCESS", "ATOMIC_STAGE_ADVANCE", "PROJECT_WORKSPACE_POSITIVE_CLOSURE"],
    "deferred": ["S4_TO_S5", "S5_TO_S6", "ROLLBACK", "EXCEPTION_CLOSE", "REOPEN", "THIRD_PARTY_APPROVAL"]
  },
  "objects": {
    "ProjectStageGateRuntime": {
      "owner": "PROJ",
      "targetTables": ["proj_project", "proj_project_stage", "proj_project_gate", "proj_project_gate_reference"],
      "currentTruth": true,
      "allowedAdvances": ["S0->S1", "S1->S2", "S2->S3", "S3->S4"],
      "requiredGateShape": "EACH_S0_TO_S3_STAGE_HAS_AT_LEAST_ONE_EXIT_GATE_AND_EACH_EXIT_GATE_HAS_AT_LEAST_ONE_REFERENCE",
      "emptyRuntimePolicy": "DEPENDENCY_UNAVAILABLE_NEVER_VACUOUSLY_TRUE",
      "lockOrder": ["PROJECT", "CURRENT_AND_NEXT_STAGE", "EXIT_GATE", "GATE_REFERENCE", "OWNER_FACT"],
      "concurrency": "PROJECT_TREE_STAGE_GATE_REFERENCE_AND_OWNER_FACT_VERSION_REVALIDATION"
    },
    "GateReferenceFact": {
      "owner": "PROJ_ACC_BPM_BY_TYPE",
      "refTypes": {
        "TASK": {"providerKey": "PROJ_TASK", "stableKey": "tenantId+projectId+taskCode", "satisfied": "DONE"},
        "MILESTONE": {"providerKey": "PROJ_MILESTONE", "stableKey": "tenantId+projectId+milestoneCode", "satisfied": "ACHIEVED"},
        "DELIVERABLE": {"providerKey": "ACC_DELIVERABLE", "stableKey": "tenantId+projectId+deliverableCode", "satisfied": "ACCEPTED"},
        "STATE": {"providerKey": "PROJ_STATE", "stableKey": "tenantId+projectId+stageCode", "satisfied": "STAGE_DONE"},
        "APPROVAL": {"providerKey": "BPM_APPROVAL", "stableKey": "PROJECT_STAGE_GATE:{gateReferenceId}+definitionKey+definitionVersion", "satisfied": "ENDED_AND_STATUS_2"},
        "PROCESS": {"providerKey": "BPM_PROCESS", "stableKey": "PROJECT_STAGE_GATE:{gateReferenceId}+definitionKey+definitionVersion", "satisfied": "ENDED_AND_STATUS_2"}
      },
      "factFields": ["providerKey", "refType", "ownerObjectKey", "ownerBusinessVersion", "factVersion", "outcome", "unmetCode"],
      "outcomes": ["SATISFIED", "UNSATISFIED", "VERSION_CONFLICT", "DEPENDENCY_UNAVAILABLE"]
    },
    "ProjectStageSnapshot": {
      "owner": "PROJ",
      "targetTables": ["proj_project_stage_snapshot"],
      "writePolicy": "APPEND_ONLY",
      "operationType": "STAGE_ADVANCE",
      "reusedFields": ["before_stage", "after_stage", "guard_snapshot_json", "provider_facts_json", "tree_version", "operation_id", "operator_user_id", "operated_at"],
      "forbidden": ["SECOND_GATE_RESULT_TABLE", "SECOND_STAGE_HISTORY_TABLE", "CROSS_CONTEXT_BUSINESS_BODY"]
    },
    "PlatformFacts": {
      "owner": "PLATFORM",
      "targetTables": ["plt_idempotency_record", "plt_operation_audit", "plt_outbox_event"],
      "event": "ProjectStageChanged"
    },
    "FlowableGateProcess": {
      "owner": "PMS_INTEGRATION_FLOWABLE",
      "targetTables": ["ACT_RE_PROCDEF", "ACT_RU_EXECUTION", "ACT_RU_VARIABLE", "ACT_HI_PROCINST", "ACT_HI_VARINST"],
      "definitionIdentity": ["processDefinitionKey", "processDefinitionVersion", "processDefinitionId"],
      "businessKey": "PROJECT_STAGE_GATE:{gateReferenceId}",
      "statusValues": {"RUNNING": 1, "APPROVE": 2, "REJECT": 3, "CANCEL": 4},
      "startAuthorization": ["pms:project:update", "PROJECT_MANAGE", "CURRENT_PROJECT_MANAGER"],
      "serverVariables": ["PROCESS_START_USER_ID", "PROCESS_STATUS", "_FLOWABLE_SKIP_EXPRESSION_ENABLED"],
      "genericYudaoStartWhitelistPolicy": "APPLIES_ONLY_TO_GENERIC_YUDAO_START_ENTRY_NOT_QUERIED_OR_COPIED_BY_PMS",
      "forbiddenDefinitionFeatures": ["BPMN_START_USER_SELECT_35"],
      "physicalPolicy": "NO_PMS_MAPPING_TABLE"
    }
  },
  "interfaces": {
    "StageAdvanceReadiness": {
      "route": "GET /api/v1/pms/projects/{id}/stage-advance-readiness",
      "response": ["currentStage", "nextStage", "projectVersion", "treeVersion", "gateResults", "allowedActions"],
      "authority": ["pms:project:query", "PROJECT_VIEW"],
      "policy": "PREVIEW_ONLY_COMMAND_REVALIDATES"
    },
    "StartGateProcess": {
      "route": "POST /api/v1/pms/projects/{id}/stage-gates/{gateReferenceId}/actions/start-process",
      "requiredHeaders": ["If-Match", "Idempotency-Key"],
      "authority": ["pms:project:update", "PROJECT_MANAGE", "CURRENT_PROJECT_MANAGER"],
      "forbiddenClientInputs": ["tenantId", "actorUserId", "processDefinitionKey", "processDefinitionVersion", "businessKey", "systemVariables"]
    },
    "AdvanceStage": {
      "route": "POST /api/v1/pms/projects/{id}/actions/advance-stage",
      "requiredHeaders": ["If-Match", "Idempotency-Key"],
      "requiredInputs": ["expectedCurrentStage", "expectedTreeVersion"],
      "forbiddenInputs": ["targetStage", "tenantId", "actorUserId", "gateOutcome"],
      "success": ["projectId", "beforeStage", "afterStage", "projectVersion", "stageSnapshotId", "gateEvaluationSummary"]
    },
    "ProjectStageGateFactProviderApi": {
      "module": "pms-module-project-api",
      "method": "lockAndRevalidate(ProjectStageGateFactQuery)",
      "transaction": "MANDATORY",
      "registry": "ONE_PROVIDER_PER_FIXED_REF_TYPE_AND_PROVIDER_KEY",
      "deliveryProvider": {
        "providerKey": "ACC_DELIVERABLE",
        "implementationOwner": "ACC",
        "ownerStorage": "acc_project_deliverable",
        "lookup": "tenantId+projectId+deliverableCode UNIQUE ROOT FOR UPDATE",
        "response": ["deliverableRootId", "businessStatus", "rowVersion"],
        "forbidden": ["PROJ_DIRECT_ACC_TABLE_READ", "NONEXISTENT_ACC_PROJECT_DELIVERABLE_FACT_REUSE"]
      }
    },
    "ProjectStageGateProcessOwnerApi": {
      "module": "pms-module-project-api",
      "providerModule": "pms-module-integration",
      "methods": ["inspectFrozenDefinition(ProjectStageGateProcessDefinitionQuery)", "startFrozenProcess(ProjectStageGateProcessStartCommand)"],
      "definitionResolution": "REPOSITORY_SERVICE_KEY_PLUS_VERSION_TO_EXACT_ID",
      "start": "RUNTIME_SERVICE_BY_DEFINITION_ID_WITH_SERVER_INITIATOR_AND_VARIABLES",
      "idempotency": "SAME_OPERATION_SAME_DIGEST_REPLAYS_ORIGINAL_FACT_DIFFERENT_DIGEST_CONFLICTS"
    }
  },
  "successTransaction": ["CURRENT_STAGE_DONE", "NEXT_STAGE_ACTIVE", "PROJECT_CURRENT_STAGE_AND_VERSION", "EXIT_GATES_PASSED", "STAGE_ADVANCE_SNAPSHOT", "OPERATION_AUDIT", "PROJECT_STAGE_CHANGED_OUTBOX", "IDEMPOTENCY_COMPLETED"],
  "events": {
    "ProjectStageChanged": {
      "action": "STAGE_ADVANCE",
      "payload": ["eventId", "tenantId", "projectId", "projectVersion", "action", "beforeStage", "afterStage", "stageSnapshotId", "gateEvaluationSummaryRef", "actorUserId", "occurredAt"],
      "forbiddenPayload": ["CROSS_CONTEXT_BUSINESS_BODY", "FULL_GATE_RESULT_BODY"]
    }
  },
  "reuseDisposition": {
    "directReuse": ["ProjectMasterLock", "ProjectStageGateReferenceInstances", "ProjectTask", "ProjectMilestone", "AccProjectDeliverableRootAndExistingOwnerMapper", "ProjectScopeApi", "ProjectManagerMembership", "ProjectStageSnapshot", "PlatformCommandExecutionApi"],
    "additivePublicProviders": ["ProjectStageGateFactProviderApi", "ProjectStageGateFact", "ACC_DELIVERABLE_PROVIDER_IMPLEMENTATION"],
    "copyThenEnhance": ["ProjectGovernanceApplicationServiceTransactionPattern", "PmsIntegrationFlowableQueryPattern", "ProjectWorkspaceStagePanel"],
    "doNotReuseRuntime": ["pms_project_phase", "YudaoBpmProcessInstanceApiForVersionedStart", "BroadBpmGovernanceGuardNoActiveMeansNoBlocker", "PM10Commands", "F_COM_001_S4_TO_S5"]
  },
  "forbiddenCapabilities": ["S4_TO_S5_GENERIC_ADVANCE", "EMPTY_GATE_TRUE", "CURRENT_BPM_VERSION_SUBSTITUTES_FROZEN_VERSION", "DIRECT_OWNER_TABLE_READ", "CLIENT_GATE_OUTCOME", "YUDao_BASE_MODIFICATION", "NEW_PERMISSION_KEY", "NEW_PHYSICAL_TABLE", "TEST_FIRST_FOR_UNIMPLEMENTED_CAPABILITY"]
}
