<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.service.dal.mysql.inspection.InspectionCollectionReceiptMapper">
    <select id="selectForExecutionForUpdate" resultType="cn.iocoder.yudao.module.pms.service.dal.dataobject.inspection.InspectionCollectionReceiptDO">
        SELECT * FROM srv_inspection_collection_receipt
        WHERE tenant_id=#{query.tenantId} AND execution_id=#{query.executionId} AND deleted=b'0'
        ORDER BY result_version FOR UPDATE
    </select>
</mapper>
