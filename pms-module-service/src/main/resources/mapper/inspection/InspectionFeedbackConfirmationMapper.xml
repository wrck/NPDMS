<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.service.dal.mysql.inspection.InspectionFeedbackConfirmationMapper">
    <select id="selectForTaskForUpdate" resultType="cn.iocoder.yudao.module.pms.service.dal.dataobject.inspection.InspectionFeedbackConfirmationDO">
        SELECT * FROM srv_inspection_feedback_confirmation
        WHERE tenant_id=#{query.tenantId} AND task_id=#{query.taskId} AND deleted=b'0'
        ORDER BY id FOR UPDATE
    </select>
</mapper>
