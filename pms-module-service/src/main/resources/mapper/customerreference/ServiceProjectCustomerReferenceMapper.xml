<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.service.dal.mysql.customerreference.ServiceProjectCustomerReferenceMapper">
    <!-- 新巡检历史引用仍计入；不能通过软删除记录绕过客户更正边界。 -->
    <select id="countReferences" resultType="long">
        SELECT COUNT(*) FROM srv_inspection_task
        WHERE tenant_id=#{query.tenantId} AND project_id=#{query.projectId}
    </select>
</mapper>
