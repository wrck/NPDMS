<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.service.dal.mysql.inspectionrule.InspectionRuleProductTypeRevisionMapper">

    <select id="selectListByRevisionIdsInternal"
            resultType="cn.iocoder.yudao.module.pms.service.dal.dataobject.inspectionrule.InspectionRuleProductTypeRevisionDO">
        SELECT *
        FROM srv_inspection_rule_product_type_revision
        WHERE tenant_id = #{query.tenantId}
          AND deleted = b'0'
          AND revision_id IN
        <foreach collection="query.revisionIds" item="revisionId" open="(" separator="," close=")">
            #{revisionId}
        </foreach>
        ORDER BY revision_id, product_type_code, id
    </select>

</mapper>
