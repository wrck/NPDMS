<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.service.dal.mysql.inspectionrule.InspectionRuleMapper">

    <select id="selectByIdForUpdate"
            resultType="cn.iocoder.yudao.module.pms.service.dal.dataobject.inspectionrule.InspectionRuleDO">
        SELECT *
        FROM srv_inspection_rule
        WHERE tenant_id = #{query.tenantId}
          AND id = #{query.ruleId}
          AND deleted = b'0'
        FOR UPDATE
    </select>

</mapper>
