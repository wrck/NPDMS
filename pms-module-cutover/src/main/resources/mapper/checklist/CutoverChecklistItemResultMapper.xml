<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.cutover.dal.mysql.checklist.CutoverChecklistItemResultMapper">
    <select id="selectCurrentForUpdate"
            resultType="cn.iocoder.yudao.module.pms.cutover.dal.dataobject.checklist.CutoverChecklistItemResultDO">
        SELECT *
        FROM cut_cutover_checklist_item_result
        WHERE tenant_id = #{query.tenantId}
          AND checklist_item_id = #{query.checklistItemId}
          AND current_marker = 1
          AND deleted = b'0'
        FOR UPDATE
    </select>
</mapper>
