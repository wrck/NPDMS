<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.cutover.dal.mysql.checklist.CutoverChecklistMapper">
    <select id="selectCurrentForUpdate"
            resultType="cn.iocoder.yudao.module.pms.cutover.dal.dataobject.checklist.CutoverChecklistDO">
        SELECT *
        FROM cut_cutover_checklist
        WHERE tenant_id = #{query.tenantId}
          AND cutover_task_id = #{query.taskId}
          AND current_marker = 1
          AND deleted = b'0'
        <if test="query.checklistId != null">
          AND id = #{query.checklistId}
        </if>
        FOR UPDATE
    </select>
</mapper>
