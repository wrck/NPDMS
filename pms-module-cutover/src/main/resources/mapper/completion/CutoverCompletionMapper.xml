<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.cutover.dal.mysql.completion.CutoverCompletionMapper">
  <select id="one" resultType="cn.iocoder.yudao.module.pms.cutover.dal.dataobject.taskv2.CutoverTaskDO">
    SELECT * FROM cut_task WHERE tenant_id = #{query.tenantId} AND project_id = #{query.projectId}
      AND id = #{query.objectId} AND deleted = 0 
    <if test="query.lock">FOR UPDATE</if>
  </select>
</mapper>
