<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.pms.cutover.dal.mysql.spare.CutoverSpareManualEvidenceMapper">
    <select id="selectByTask" resultType="cn.iocoder.yudao.module.pms.cutover.dal.dataobject.spare.CutoverSpareManualEvidenceDO">
        SELECT * FROM cut_spare_manual_evidence
        WHERE tenant_id = #{query.tenantId} AND cutover_task_id = #{query.cutoverTaskId}
        ORDER BY id ASC
    </select>
</mapper>
