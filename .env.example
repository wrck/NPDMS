# Copy this file to .env only through docker/scripts/new-local-env.ps1.
# Secrets are intentionally blank and Docker Compose rejects missing values.
NPDMS_DB_NAME=npdms
NPDMS_DB_USER=npdms_app
NPDMS_DB_PASSWORD=
NPDMS_MYSQL_ROOT_PASSWORD=
NPDMS_REDIS_PASSWORD=
NPDMS_MYBATIS_ENCRYPTOR_PASSWORD=
NPDMS_COLLECTION_GUARD_BASE_URL=
NPDMS_PROJECT_GOVERNANCE_GUARD_SIGNING_KEY=

# Host ports for MySQL/Redis can be changed when another local service already uses them.
# 注意：前后端端口已固化为 58080/18081，禁止通过 .env 修改，避免测试过程中端口漂移。
NPDMS_MYSQL_PORT=13306
NPDMS_REDIS_PORT=16379
