      "field": "extra_requiredEndDate",
      "title": "工期要求（项目结束时间）"
    },
    {
      "type": "checkbox",
      "field": "extra_powerTypes",
      "title": "1、机房供电确认（多选）",
      "options": [
        {
          "label": "交流电源",
          "value": "AC"
        },
        {
          "label": "直流电源",
          "value": "DC"
        },
        {
          "label": "多种供电方式",
          "value": "MULTIPLE"
        }
      ]
    },
    {
      "type": "checkbox",
      "field": "extra_powerEnvironments",
      "title": "2、供电方式（多选）",
      "options": [
        {
          "label": "国标环境",
          "value": "CN"
        },
        {
          "label": "欧标环境",
          "value": "EU"
        },
        {
          "label": "其他环境",
          "value": "OTHER"
        }
      ]
    },
