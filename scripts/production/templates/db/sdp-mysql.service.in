[Unit]
Description=SDP native MySQL 8.4
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data
ConditionPathIsMountPoint=/data

[Service]
Type=simple
User=sdp-mysql
Group=sdp-mysql
ExecStart=/opt/sdp/mysql/bin/mysqld --defaults-file=/etc/sdp/mysql.cnf
Restart=on-failure
RestartSec=10
RuntimeDirectory=sdp-mysql
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/data/mysql /data/mysql-tmp /var/log/sdp/mysql /run/sdp-mysql
LimitNOFILE=65535
LimitCORE=0
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
