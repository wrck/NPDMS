server:
  address: 172.17.73.104
  port: 443
  ssl:
    enabled: true
    key-store-type: PKCS12
    key-store-password: ${TLS_KEYSTORE_PASSWORD}
  tomcat:
    accesslog:
      enabled: false

spring:
  config:
    import: "configtree:${CREDENTIALS_DIRECTORY}/"
  flyway:
    enabled: false
  liquibase:
    enabled: false
  sql:
    init:
      mode: never
  jpa:
    hibernate:
      ddl-auto: none
  batch:
    jdbc:
      initialize-schema: never
  quartz:
    job-store-type: memory # JobStartupRegistrar restores persisted definitions, including paused jobs.
    jdbc:
      initialize-schema: never
  autoconfigure:
    exclude:
      - org.springframework.ai.vectorstore.qdrant.autoconfigure.QdrantVectorStoreAutoConfiguration
      - org.springframework.ai.vectorstore.redis.autoconfigure.RedisVectorStoreAutoConfiguration
      - org.springframework.ai.vectorstore.milvus.autoconfigure.MilvusVectorStoreAutoConfiguration
      - org.dromara.trans.config.TransServiceConfig
      - com.alibaba.cloud.ai.autoconfigure.dashscope.DashScopeChatAutoConfiguration
      - com.alibaba.cloud.ai.autoconfigure.dashscope.DashScopeAgentAutoConfiguration
      - com.alibaba.cloud.ai.autoconfigure.dashscope.DashScopeImageAutoConfiguration
      - com.alibaba.cloud.ai.autoconfigure.dashscope.DashScopeVideoAutoConfiguration
      - com.alibaba.cloud.ai.autoconfigure.dashscope.DashScopeAudioSpeechAutoConfiguration
      - com.alibaba.cloud.ai.autoconfigure.dashscope.DashScopeAudioTranscriptionAutoConfiguration
      - com.alibaba.cloud.ai.autoconfigure.dashscope.DashScopeRerankAutoConfiguration
      - com.alibaba.cloud.ai.autoconfigure.dashscope.DashScopeEmbeddingAutoConfiguration
      - com.alibaba.cloud.ai.autoconfigure.dashscope.DashScopeMultimodalEmbeddingAutoConfiguration
      - com.alibaba.cloud.ai.autoconfigure.dashscope.DashScopeAsyncToolCallingManagerAutoConfiguration
  datasource:
    druid:
      web-stat-filter:
        enabled: false
      stat-view-servlet:
        enabled: false
    dynamic:
      primary: master
      strict: true
      datasource:
        master:
          name: @@db_name@@
          url: jdbc:mysql://@@db_tls_name@@:3306/@@db_name@@?sslMode=VERIFY_IDENTITY&allowPublicKeyRetrieval=false&serverTimezone=Asia/Shanghai&rewriteBatchedStatements=true&nullCatalogMeansCurrent=true
          username: ${DB_USER}
          password: ${DB_PASSWORD}
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      database: 0
      password: ${REDIS_PASSWORD}

mybatis-plus:
  encryptor:
    password: ${MYBATIS_ENCRYPTOR_PASSWORD}

management:
  endpoints:
    web:
      base-path: /actuator
      exposure:
        include: health,info
  endpoint:
    health:
      probes:
        enabled: true

logging:
  file:
    name: /var/log/sdp/backend/backend.log

# 未启用微信渠道；接入时须由正式渠道配置替换以下非凭据哨兵。
wx:
  mp:
    app-id: disabled
    secret: disabled
    config-storage:
      type: RedisTemplate
      key-prefix: wx-disabled
  miniapp:
    appid: disabled
    secret: disabled
    config-storage:
      type: RedisTemplate
      key-prefix: wa-disabled

yudao:
  api-encrypt:
    request-key: ${API_ENCRYPT_REQUEST_KEY}
    response-key: ${API_ENCRYPT_RESPONSE_KEY}
  captcha:
    enable: true
  security:
    mock-enable: false
  web:
    admin-ui:
      url: https://@@internal_domain@@
  access-log:
    enable: true
  demo: false

flowable:
  database-schema-update: false
springdoc:
  api-docs:
    enabled: false
  swagger-ui:
    enabled: false
knife4j:
  enable: false
pms:
  file:
    office-executable: /usr/bin/soffice
    scan:
      enabled: false
  integration:
    device-ops:
      enabled: true
      base-url: https://@@backend_tls_name@@:8443
      namespace: npdms
      request-signing-key: ${DAC_REQUEST_SIGNING_KEY}
      callback-signing-key: ${DAC_CALLBACK_SIGNING_KEY}
      callback-url: https://@@backend_tls_name@@:443/api/v1/pms/integration/device-ops/callbacks

# Approved server identity: short-lived signed JWT; no external OIDC dependency.
DAC_NAMESPACE: npdms
SERVER_IP: "@@be_ip@@"
PUBLIC_ORIGIN: https://@@internal_domain@@
npdms:
  server-dac:
    enabled: true
    endpoint: https://@@backend_tls_name@@:8443
    identity-ready-file: /run/sdp/backend-identity-ready
  server-deployment:
    enabled: true
    minio-endpoint: http://127.0.0.1:9000
    minio-bucket: @@minio_bucket@@
    storage-public-origin: https://@@external_domain@@
    ready-file: /run/sdp/backend-ready
