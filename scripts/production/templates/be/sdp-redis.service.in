[Unit]
Description=NPDMS native Redis 7.4
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data
ConditionPathIsMountPoint=/data

[Service]
Type=simple
User=sdp-redis
Group=sdp-redis
ExecStart=/opt/sdp/redis/bin/redis-server /etc/sdp/redis.conf
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/data/redis
LimitNOFILE=65535
LimitCORE=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
