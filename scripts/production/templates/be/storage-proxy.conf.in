worker_processes 2;
pid /run/sdp-storage-proxy/nginx.pid;
error_log /dev/null;
events { worker_connections 1024; }
http {
    map $http_upgrade $sdp_storage_connection { default upgrade; '' close; }
    log_format storage_safe '$remote_addr $request_method $status $body_bytes_sent $request_time';
    access_log /var/log/sdp/storage-proxy/access.log storage_safe;
    client_body_temp_path /run/sdp-storage-proxy/body;
    proxy_temp_path /run/sdp-storage-proxy/proxy;
    fastcgi_temp_path /run/sdp-storage-proxy/fastcgi;
    uwsgi_temp_path /run/sdp-storage-proxy/uwsgi;
    scgi_temp_path /run/sdp-storage-proxy/scgi;
    server {
        listen @@be_ip@@:9443 ssl;
        server_name @@backend_tls_name@@;
        ssl_certificate /etc/sdp/tls/storage-proxy-20261102.crt;
        ssl_certificate_key /run/credentials/sdp-storage-proxy.service/storage.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 52m;
        allow @@fe1_ip@@;
        allow @@fe2_ip@@;
        deny all;
        location /@@minio_bucket@@/ {
            limit_except GET HEAD PUT OPTIONS { deny all; }
            proxy_pass http://127.0.0.1:9000;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $http_x_forwarded_for;
            proxy_set_header Connection "";
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 300s;
        }
        location /minio/ {
            allow @@fe1_ip@@;
            deny all;
            proxy_pass http://127.0.0.1:9001/;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $http_x_forwarded_for;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $sdp_storage_connection;
            proxy_buffering off;
            proxy_read_timeout 300s;
        }
        location / { return 404; }
    }
}
