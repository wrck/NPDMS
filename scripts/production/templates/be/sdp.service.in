[Unit]
Description=NPDMS production backend
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data
ConditionPathIsMountPoint=/data

[Service]
Type=simple
User=sdp
Group=sdp
WorkingDirectory=/data/backend
LoadCredentialEncrypted=application-secrets.properties:/etc/credstore.encrypted/sdp-backend
LoadCredentialEncrypted=backend.p12:/etc/credstore.encrypted/sdp-backend-tls
ExecStart=/opt/sdp/jdk/bin/java -Duser.home=/data/backend -jar /opt/sdp/backend/current/yudao-server.jar --spring.profiles.active=prod --spring.config.additional-location=file:/etc/sdp/backend/,file:%d/application-secrets.properties --server.ssl.key-store=file:%d/backend.p12
Restart=on-failure
RestartSec=10
UMask=0077
LogsDirectory=sdp/backend
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/backend /var/log/sdp/backend
LimitCORE=0

[Install]
WantedBy=multi-user.target
