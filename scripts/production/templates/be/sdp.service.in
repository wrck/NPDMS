[Unit]
Description=SDP production backend
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/data
ConditionPathIsMountPoint=/data

[Service]
Type=simple
RuntimeDirectory=sdp
RuntimeDirectoryMode=0700
User=sdp
Group=sdp
WorkingDirectory=/data/backend
LoadCredentialEncrypted=application-secrets.properties:/etc/credstore.encrypted/sdp-backend
LoadCredentialEncrypted=dac_service_private_key:/etc/credstore.encrypted/sdp-dac-service-private-key
LoadCredentialEncrypted=backend.p12:/etc/credstore.encrypted/sdp-backend-tls
ExecStart=/opt/sdp/jdk/bin/java -Duser.home=/data/backend -Djavax.net.ssl.trustStore=/etc/sdp/tls/java-truststore.p12 -Djavax.net.ssl.trustStorePassword=changeit -Dloader.path=/opt/sdp/backend/current/deployment-adapter.jar -Dloader.main=cn.iocoder.yudao.server.YudaoServerApplication -cp /opt/sdp/backend/current/yudao-server.jar org.springframework.boot.loader.launch.PropertiesLauncher --spring.profiles.active=prod --spring.config.additional-location=file:/etc/sdp/backend/,file:%d/application-secrets.properties --server.ssl.key-store=file:%d/backend.p12
Restart=on-failure
RestartSec=10
UMask=0077
LogsDirectory=sdp/backend
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/backend /var/log/sdp/backend /run/sdp
LimitCORE=0

[Install]
WantedBy=multi-user.target
