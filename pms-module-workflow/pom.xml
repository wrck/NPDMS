<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.iocoder.boot</groupId>
        <artifactId>yudao</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>pms-module-workflow</artifactId>
    <name>${project.artifactId}</name>
    <description>PMS 工作流域：审批中心、审批计划、审批超时调度与 OA 待办同步</description>

    <dependencies>
        <!-- Flowable 引擎（源工程 pms-workflow 经 pms-common 传递依赖；
             目标体系与 yudao-module-bpm 共享同一 ProcessEngine，schema 由 server 配置管理） -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
        </dependency>
        <!-- 5 个审批 SPI（ApprovalTrigger/BusinessDataLoader/ProjectConfigProvider/
             ApprovalStatusChecker/ApprovalPlanBatchCreator）下沉到 platform-api -->
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>pms-module-platform-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-module-system</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-biz-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.iocoder.boot</groupId>
            <artifactId>yudao-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>